        replacement_content: "  const [bookings, setBookings] = useState<Booking[]>(() => {\n    try {\n      const saved = localStorage.getItem(\'dropaid_bookings\');\n      if (saved) {\n        const parsed = JSON.parse(saved);\n        if (Array.isArray(parsed)) {\n          // Clean out stale initial demo booking so homepage opens clean\n          const nonDemo = parsed.filter((b) => b.id !== \'bk-demo-01\');\n          return nonDemo;\n        }\n      }\n    } catch {\n      // fallback\n    }\n    return [];\n  });\n\n  const [patientProfile, setPatientProfile] = useState<PatientProfile>(INITIAL_PATIENT);\n  const [gpsAccuracy, setGpsAccuracy] = useState<number>(10);\n  const [isDetectingGPS, setIsDetectingGPS] = useState<boolean>(false);\n  const [gpsError, setGpsError] = useState<string | null>(null);\n  const isSubmittingRef = useRef<boolean>(false);\n  const [isSubmitting, setIsSubmitting] = useState<boolean>(false);"
