  view_file {
    absolute_path_uri: "file:///src/components/Map/LeafletMap.tsx"
    start_line: 414
    end_line: 454
    content: "  }, [ambulances, activeAmbulanceId, isMapReady]);\n\n  // Update Route Polyline (Along Road Coordinates)\n  useEffect(() => {\n    const map = mapInstanceRef.current;\n    if (!map || !isMapReady) return;\n\n    if (routePolylineRef.current) {\n      routePolylineRef.current.remove();\n      routePolylineRef.current = null;\n    }\n\n    if (routePolyline.length > 1) {\n      // Draw neon path with background shadow\n      const polyline = L.polyline(routePolyline, {\n        color: \'#0284c7\',\n        weight: 5,\n        opacity: 0.85,\n        lineCap: \'round\',\n        lineJoin: \'round\',\n        dashArray: \'1, 10\',\n      }).addTo(map);\n\n      routePolylineRef.current = polyline;\n\n      // Fit bounds to comfortably frame the route\n      try {\n        const bounds = L.latLngBounds(routePolyline);\n        map.fitBounds(bounds, { padding: [50, 50], maxZoom: 15 });\n      } catch {\n        // Fallback\n      }\n    }\n  }, [routePolyline, isMapReady]);\n\n  // Map Controls Helpers\n  const handleRecenterPickup = () => {\n    if (mapInstanceRef.current) {\n      mapInstanceRef.current.flyTo([pickupCoords.lat, pickupCoords.lng], 14, { duration: 0.8 });\n    }\n  };"
    num_lines: 543
    num_bytes: 23707
    line_range_bytes: 1150
  }
}
