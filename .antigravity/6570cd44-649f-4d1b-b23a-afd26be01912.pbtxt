    content: "      const cloudData = await cloudRes.json();\n      return res.json({\n        success: true,\n        source: \'cloudinary_live\',\n        public_id: cloudData.public_id,\n        secure_url: cloudData.secure_url,\n        format: cloudData.format,\n        width: cloudData.width,\n        height: cloudData.height,\n        bytes: cloudData.bytes,\n      });\n    }\n\n    // High-fidelity fallback storage with Cloudinary schema\n    const simulatedId = `${folder}/${fileName.replace(/[^a-zA-Z0-9_-]/g, \'_\')}_${Date.now()}`;\n    return res.json({\n      success: true,\n      source: \'local_optimized\',\n      public_id: simulatedId,\n      secure_url: fileData, // Data URL preserved for immediate preview\n      format: fileData.startsWith(\'data:image/png\') ? \'png\' : \'jpeg\',\n      created_at: new Date().toISOString(),\n      bytes: fileData.length,\n      message: \'Document / image securely validated and stored in session cache.\'\n    });\n  } catch (err: any) {\n    console.error(\'Upload handler error:\', err);\n    return res.status(500).json({ error: err.message || \'Upload error\' });\n  }\n});\n\n// 5. Multi-view synchronization\napp.get(\'/api/sync\', (_req: Request, res: Response) => {\n  res.json({ state: sharedPlatformState, bookings: serverBookings, ambulances: serverAmbulances });\n});\n\napp.post(\'/api/sync\', (req: Request, res: Response) => {\n  sharedPlatformState = req.body;\n  if (req.body?.bookings) serverBookings = req.body.bookings;\n  if (req.body?.ambulances) serverAmbulances = req.body.ambulances;\n  res.json({ success: true, timestamp: Date.now() });\n});\n\n// Start server with Vite middleware in development\nasync function startServer() {\n  const isProd = process.env.NODE_ENV === \'production\';\n  if (!isProd) {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });"
