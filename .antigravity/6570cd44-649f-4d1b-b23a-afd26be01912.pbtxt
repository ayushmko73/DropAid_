    content: "      dropoffAddress: dropoffAddress || \'Nearest Verified Hospital ER\',\n      dropoffCoords,\n      destinationHospitalId: destinationHospitalId || HOSPITALS[0].id,\n      equipmentRequested,\n      stage: \'en_route_pickup\' as const,\n      assignedUnitId: assigned.id,\n      etaMinutes,\n      distanceKm,\n      routePolyline,\n      currentVehiclePosition: [assigned.location.lat, assigned.location.lng],\n      priceEst: Math.round(150 + distanceKm * 18),\n      documents: [],\n      stageTimestamps: {\n        requested: new Date().toISOString(),\n        accepted: new Date().toISOString(),\n        dispatched: new Date().toISOString(),\n      },\n    };\n\n    // Update assigned ambulance status\n    serverAmbulances = serverAmbulances.map((a) =>\n      a.id === assigned.id\n        ? {\n            ...a,\n            status: \'en_route_pickup\' as const,\n            currentBookingId: bookingId,\n          }\n        : a\n    );\n\n    serverBookings = [newBooking as any, ...serverBookings];\n\n    return res.status(201).json({\n      success: true,\n      booking: newBooking,\n      assignedAmbulance: assigned,\n      message: `Emergency dispatch confirmed! Ambulance ${assigned.callSign} (${assigned.isHospitalStationed ? \'Stationed at \' + assigned.stationName : \'Corridor Patrol\'}) is en route.`,\n    });\n  } catch (err: any) {\n    console.error(\'Error creating booking:\', err);\n    return res.status(500).json({ error: err.message || \'Internal server error processing booking\' });\n  }\n});\n\n// Update booking stage\napp.post(\'/api/bookings/:id/stage\', (req: Request, res: Response) => {"
