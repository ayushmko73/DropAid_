  view_file {
    absolute_path_uri: "file:///src/components/OperatorDashboard/OperatorDashboard.tsx"
    end_line: 59
    content: "import React, { useState } from \'react\';\nimport { Booking, AmbulanceUnit, TripStage, Hospital } from \'../../types/index.ts\';\nimport { HOSPITALS } from \'../../data/mockData.ts\';\nimport {\n  Headset,\n  Check,\n  X,\n  Truck,\n  UserCheck,\n  Navigation,\n  Clock,\n  Phone,\n  Radio,\n  AlertCircle,\n  FileText,\n  Volume2,\n  ExternalLink,\n  ChevronRight,\n  Shield,\n  Activity,\n  Building2\n} from \'lucide-react\';\nimport { emergencyAudio } from \'../../services/audioService.ts\';\n\ninterface OperatorDashboardProps {\n  bookings: Booking[];\n  ambulances: AmbulanceUnit[];\n  onAcceptBooking: (bookingId: string) => void;\n  onRejectBooking: (bookingId: string) => void;\n  onAssignUnit: (bookingId: string, unitId: string) => void;\n  onAdvanceStage: (bookingId: string, nextStage: TripStage) => void;\n  onOpenDriverView: (unitId: string) => void;\n  onOpen3DViewer: () => void;\n  onOperatorReroute?: (bookingId: string, hospital: Hospital) => void;\n}\n\nconst STAGE_ORDER: TripStage[] = [\n  \'pending\',\n  \'accepted\',\n  \'en_route_pickup\',\n  \'on_scene\',\n  \'transporting\',\n  \'at_hospital\',\n  \'completed\'\n];\n\nexport const OperatorDashboard: React.FC<OperatorDashboardProps> = ({\n  bookings,\n  ambulances,\n  onAcceptBooking,\n  onRejectBooking,\n  onAssignUnit,\n  onAdvanceStage,\n  onOpenDriverView,\n  onOpen3DViewer,\n  onOperatorReroute,\n}) => {\n  const [selectedBookingId, setSelectedBookingId] = useState<string | null>(\n    bookings.length > 0 ? bookings[0].id : null\n  );"
