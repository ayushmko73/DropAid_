  view_file {
    absolute_path_uri: "file:///src/components/OperatorDashboard/OperatorDashboard.tsx"
    end_line: 99
    content: "import React, { useState } from \'react\';\nimport { Booking, AmbulanceUnit, TripStage } from \'../../types/index.ts\';\nimport {\n  Headset,\n  Check,\n  X,\n  Truck,\n  UserCheck,\n  Navigation,\n  Clock,\n  Phone,\n  Radio,\n  AlertCircle,\n  FileText,\n  Volume2,\n  ExternalLink,\n  ChevronRight,\n  Shield,\n  Activity\n} from \'lucide-react\';\nimport { emergencyAudio } from \'../../services/audioService.ts\';\n\ninterface OperatorDashboardProps {\n  bookings: Booking[];\n  ambulances: AmbulanceUnit[];\n  onAcceptBooking: (bookingId: string) => void;\n  onRejectBooking: (bookingId: string) => void;\n  onAssignUnit: (bookingId: string, unitId: string) => void;\n  onAdvanceStage: (bookingId: string, nextStage: TripStage) => void;\n  onOpenDriverView: (unitId: string) => void;\n  onOpen3DViewer: () => void;\n}\n\nconst STAGE_ORDER: TripStage[] = [\n  \'pending\',\n  \'accepted\',\n  \'en_route_pickup\',\n  \'on_scene\',\n  \'transporting\',\n  \'at_hospital\',\n  \'completed\'\n];\n\nexport const OperatorDashboard: React.FC<OperatorDashboardProps> = ({\n  bookings,\n  ambulances,\n  onAcceptBooking,\n  onRejectBooking,\n  onAssignUnit,\n  onAdvanceStage,\n  onOpenDriverView,\n  onOpen3DViewer,\n}) => {\n  const [selectedBookingId, setSelectedBookingId] = useState<string | null>(\n    bookings.length > 0 ? bookings[0].id : null\n  );\n  const [operatorTab, setOperatorTab] = useState<\'queue\' | \'fleet\' | \'driver_cockpit\'>(\'queue\');\n\n  const selectedBooking = bookings.find((b) => b.id === selectedBookingId) || bookings[0] || null;\n  const assignedUnit = selectedBooking ? ambulances.find((a) => a.id === selectedBooking.assignedUnitId) : null;\n\n  const getNextStage = (current: TripStage): TripStage | null => {\n    const idx = STAGE_ORDER.indexOf(current);\n    if (idx !== -1 && idx < STAGE_ORDER.length - 1) {\n      return STAGE_ORDER[idx + 1];\n    }\n    return null;\n  };\n\n  const getStageLabel = (stage: TripStage): string => {\n    switch (stage) {\n      case \'pending\': return \'1. Pending Triage\';\n      case \'accepted\': return \'2. Request Accepted\';\n      case \'en_route_pickup\': return \'3. En Route to Pickup\';\n      case \'on_scene\': return \'4. On Scene / Assessing\';\n      case \'transporting\': return \'5. Transporting to ER\';\n      case \'at_hospital\': return \'6. Arrived at Hospital\';\n      case \'completed\': return \'7. Transfer Completed\';\n      case \'cancelled\': return \'Cancelled\';\n      default: return stage;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Operator Sub-Tabs */}\n      <div className=\"flex items-center justify-between border-b border-slate-200 pb-3\">\n        <div className=\"flex items-center gap-1 bg-slate-100 p-1 rounded-lg\">\n          <button\n            onClick={() => setOperatorTab(\'queue\')}\n            className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer flex items-center gap-1.5 ${\n              operatorTab === \'queue\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Radio className=\"w-3.5 h-3.5 text-sky-600\" />\n            <span>Emergency Queue</span>\n            <span className=\"text-[10px] bg-sky-100 text-sky-800 px-1.5 py-0.2 rounded-full font-mono\">\n              {bookings.filter((b) => b.stage !== \'completed\' && b.stage !== \'cancelled\').length}\n            </span>\n          </button>"
    num_lines: 569
    num_bytes: 27232
    line_range_bytes: 3309
  }
}
