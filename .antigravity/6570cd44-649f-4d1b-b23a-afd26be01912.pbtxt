        target_content: "interface LeafletMapProps {\n  pickupCoords: LatLng;\n  dropoffCoords: LatLng;\n  ambulances: AmbulanceUnit[];\n  activeAmbulanceId?: string;\n  routePolyline?: [number, number][];\n  onPickupChange: (coords: LatLng, address: string) => void;\n  onDropoffChange: (coords: LatLng, address: string, hospitalId?: string) => void;\n  gpsAccuracyMeters?: number;\n  routeError?: string | null;\n  onRecalculateRoute?: () => void;\n}\n\nexport const LeafletMap: React.FC<LeafletMapProps> = ({\n  pickupCoords,\n  dropoffCoords,\n  ambulances,\n  activeAmbulanceId,\n  routePolyline = [],\n  onPickupChange,\n  onDropoffChange,\n  gpsAccuracyMeters = 12,\n  routeError = null,\n  onRecalculateRoute,\n}) => {\n  const mapContainerRef = useRef<HTMLDivElement>(null);\n  const mapInstanceRef = useRef<L.Map | null>(null);\n\n  // Markers & Layers refs\n  const pickupMarkerRef = useRef<L.Marker | null>(null);\n  const dropoffMarkerRef = useRef<L.Marker | null>(null);\n  const ambulanceMarkersRef = useRef<Map<string, L.Marker>>(new Map());\n  const routePolylineRef = useRef<L.Polyline | null>(null);\n  const accuracyCircleRef = useRef<L.Circle | null>(null);\n\n  const [isMapReady, setIsMapReady] = useState(false);\n\n  // Initialize Map\n  useEffect(() => {\n    if (!mapContainerRef.current || mapInstanceRef.current) return;\n\n    const map = L.map(mapContainerRef.current, {\n      center: [pickupCoords.lat, pickupCoords.lng],\n      zoom: 13,\n      zoomControl: false,\n    });\n\n    // Clean OpenStreetMap tiles\n    L.tileLayer(\'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png\', {\n      maxZoom: 19,\n      attribution: \'&copy; OpenStreetMap contributors\',\n    }).addTo(map);\n\n    L.control.zoom({ position: \'bottomright\' }).addTo(map);\n\n    mapInstanceRef.current = map;\n    setIsMapReady(true);\n\n    return () => {\n      map.remove();\n      mapInstanceRef.current = null;\n    };\n  }, []);"
        replacement_content: "interface LeafletMapProps {\n  pickupCoords: LatLng;\n  dropoffCoords: LatLng;\n  ambulances: AmbulanceUnit[];\n  activeAmbulanceId?: string;\n  routePolyline?: [number, number][];\n  onPickupChange: (coords: LatLng, address: string) => void;\n  onDropoffChange: (coords: LatLng, address: string, hospitalId?: string) => void;\n  gpsAccuracyMeters?: number;\n  routeError?: string | null;\n  onRecalculateRoute?: () => void;\n  isSearching?: boolean;\n}\n\nexport const LeafletMap: React.FC<LeafletMapProps> = ({\n  pickupCoords,\n  dropoffCoords,\n  ambulances,\n  activeAmbulanceId,\n  routePolyline = [],\n  onPickupChange,\n  onDropoffChange,\n  gpsAccuracyMeters = 12,\n  routeError = null,\n  onRecalculateRoute,\n  isSearching = false,\n}) => {\n  const mapContainerRef = useRef<HTMLDivElement>(null);\n  const mapInstanceRef = useRef<L.Map | null>(null);\n\n  // Markers & Layers refs\n  const pickupMarkerRef = useRef<L.Marker | null>(null);\n  const dropoffMarkerRef = useRef<L.Marker | null>(null);\n  const ambulanceMarkersRef = useRef<Map<string, L.Marker>>(new Map());\n  const routePolylineRef = useRef<L.Polyline | null>(null);\n  const accuracyCircleRef = useRef<L.Circle | null>(null);\n\n  const [isMapReady, setIsMapReady] = useState(false);\n\n  // Initialize Map\n  useEffect(() => {\n    if (!mapContainerRef.current || mapInstanceRef.current) return;\n\n    const map = L.map(mapContainerRef.current, {\n      center: [pickupCoords.lat, pickupCoords.lng],\n      zoom: 14,\n      zoomControl: false,\n    });\n\n    // Clean OpenStreetMap tiles\n    L.tileLayer(\'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png\', {\n      maxZoom: 19,\n      attribution: \'&copy; OpenStreetMap contributors\',\n    }).addTo(map);\n\n    L.control.zoom({ position: \'bottomright\' }).addTo(map);\n\n    mapInstanceRef.current = map;\n    setIsMapReady(true);\n\n    // Invalidate size shortly after mount to ensure seamless tile rendering\n    const timer1 = setTimeout(() => {\n      map.invalidateSize();\n    }, 150);\n\n    const timer2 = setTimeout(() => {\n      map.invalidateSize();\n      map.setView([pickupCoords.lat, pickupCoords.lng], 14);\n    }, 400);\n\n    return () => {\n      clearTimeout(timer1);\n      clearTimeout(timer2);\n      map.remove();\n      mapInstanceRef.current = null;\n    };\n  }, []);\n\n  // Center map on user\'s pickupCoords when updated\n  useEffect(() => {\n    const map = mapInstanceRef.current;\n    if (!map || !isMapReady) return;\n\n    // If route polyline has points, we fit bounds separately; otherwise center on pickup\n    if (routePolyline.length < 2) {\n      map.panTo([pickupCoords.lat, pickupCoords.lng], { animate: true, duration: 0.6 });\n    }\n  }, [pickupCoords.lat, pickupCoords.lng, isMapReady, routePolyline.length]);"
