    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "                {/* Locations and Symptoms Grid */}\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n                  <div className=\"bg-slate-50 p-3.5 rounded-lg border border-slate-200 space-y-2\">\n                    <span className=\"font-bold text-slate-700 uppercase tracking-wide\">\n                      Route Locations\n                    </span>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Pickup Point:</span>\n                      <div className=\"font-bold text-slate-900 mt-0.5\">{selectedBooking.pickupAddress}</div>\n                    </div>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Destination ER:</span>\n                      <div className=\"font-bold text-sky-700 mt-0.5\">{selectedBooking.dropoffAddress}</div>\n                    </div>\n                  </div>"
        replacement_content: "                {/* Locations and Symptoms Grid */}\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n                  <div className=\"bg-slate-50 p-3.5 rounded-lg border border-slate-200 space-y-2\">\n                    <span className=\"font-bold text-slate-700 uppercase tracking-wide\">\n                      Route Locations\n                    </span>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Pickup Point:</span>\n                      <div className=\"font-bold text-slate-900 mt-0.5\">{selectedBooking.pickupAddress}</div>\n                    </div>\n                    <div>\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-slate-500 font-medium\">Destination ER:</span>\n                        {selectedBooking.stage !== \'completed\' && selectedBooking.stage !== \'cancelled\' && (\n                          <button\n                            type=\"button\"\n                            onClick={() => setIsRerouteOpen((prev) => !prev)}\n                            className=\"text-[11px] font-bold text-sky-700 hover:text-sky-900 underline flex items-center gap-1 cursor-pointer\"\n                          >\n                            <Building2 className=\"w-3 h-3\" />\n                            <span>{isRerouteOpen ? \'Cancel Reroute\' : \'Operator Reroute\'}</span>\n                          </button>\n                        )}\n                      </div>\n                      <div className=\"font-bold text-sky-700 mt-0.5\">{selectedBooking.dropoffAddress}</div>\n                    </div>\n\n                    {/* Authorized Operator Reroute Dropdown Selector */}\n                    {isRerouteOpen && (\n                      <div className=\"mt-2 pt-2 border-t border-slate-200 space-y-1.5 animate-in fade-in duration-150\">\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"text-[10px] font-bold text-slate-700 uppercase\">\n                            Authorized Hospital Transfer / Reroute:\n                          </span>\n                          <span className=\"text-[10px] text-emerald-700 font-semibold\">Live Override</span>\n                        </div>\n                        <div className=\"space-y-1 max-h-40 overflow-y-auto pr-1\">\n                          {HOSPITALS.map((hosp) => {\n                            const isCurrent =\n                              selectedBooking.destinationHospitalId === hosp.id ||\n                              selectedBooking.dropoffAddress.includes(hosp.name);\n\n                            return (\n                              <button\n                                key={hosp.id}\n                                type=\"button\"\n                                disabled={isCurrent}\n                                onClick={() => {\n                                  onOperatorReroute?.(selectedBooking.id, hosp);\n                                  setIsRerouteOpen(false);\n                                }}\n                                className={`w-full text-left p-1.5 rounded text-[11px] flex items-center justify-between border transition-colors cursor-pointer ${\n                                  isCurrent\n                                    ? \'bg-sky-50 border-sky-300 font-bold text-sky-900 cursor-default\'\n                                    : \'bg-white border-slate-200 hover:bg-slate-50 text-slate-800\'\n                                }`}\n                              >\n                                <div className=\"truncate min-w-0 pr-2\">\n                                  <span>{hosp.name}</span>\n                                  <span className=\"text-[10px] text-slate-500 block truncate\">{hosp.region} \302\267 {hosp.traumaLevel}</span>\n                                </div>\n                                <span className=\"text-[10px] font-mono text-slate-600 shrink-0 font-semibold\">\n                                  {isCurrent ? \'Current\' : `${hosp.availableBeds} beds \302\267 Reroute`}\n                                </span>\n                              </button>\n                            );\n                          })}\n                        </div>\n                      </div>\n                    )}\n                  </div>"
        start_line: 295
        end_line: 320
      }
      num_matches: 1
    }
    description: "Add authorized operator reroute workflow in OperatorDashboard"
    diff_stats {
      additions: 57
      deletions: 1
    }
  }
}
