    content: "import { Hospital, Landmark, AmbulanceUnit, MedicalEquipmentItem, PatientProfile, Booking } from \'../types/index.ts\';\n\n// Central Anchor: Delhi NCR (Delhi, Noida, Haryana) - 28.6139, 77.2090\n\nexport const HOSPITALS: Hospital[] = [\n  // --- DELHI HOSPITALS (4) ---\n  {\n    id: \'hosp-delhi-1\',\n    name: \'AIIMS (All India Institute of Medical Sciences)\',\n    system: \'Autonomous Institute of National Importance\',\n    region: \'Delhi\',\n    city: \'New Delhi\',\n    address: \'Sri Aurobindo Marg, Ansari Nagar, New Delhi, Delhi 110029\',\n    lat: 28.5672,\n    lng: 77.2100,\n    availableBeds: 42,\n    totalBeds: 2478,\n    erWaitMins: 6,\n    traumaLevel: \'Level 1\',\n    status: \'open\',\n    specialties: [\'Apex Trauma Center\', \'Emergency Resuscitation Unit\', \'Cardiac Cath Lab\', \'Neuro-trauma ICU\', \'Toxicology\'],\n    phone: \'+91 11 2658 8500\',\n    emergencyContact: \'102 / +91 11 2659 4405\',\n    image: \'https://images.unsplash.com/photo-1586773860418-d37222d8fce3?auto=format&fit=crop&w=800&q=80\',\n    baysAvailable: 8,\n    isVerified: true,\n  },\n  {\n    id: \'hosp-delhi-2\',\n    name: \'Safdarjung Hospital & VMMC\',\n    system: \'Ministry of Health and Family Welfare, Govt. of India\',\n    region: \'Delhi\',\n    city: \'New Delhi\',\n    address: \'Ring Road, Opposite AIIMS, New Delhi, Delhi 110029\',\n    lat: 28.5701,\n    lng: 77.2064,\n    availableBeds: 35,\n    totalBeds: 2900,\n    erWaitMins: 9,\n    traumaLevel: \'Level 1\',\n    status: \'open\',\n    specialties: [\'National Burn Center\', \'Emergency Surgery Wing\', \'Orthopedic Trauma Center\', \'Pediatric Intensive Care\'],\n    phone: \'+91 11 2616 5060\',\n    emergencyContact: \'+91 11 2616 8336\',\n    image: \'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=800&q=80\',\n    baysAvailable: 6,\n    isVerified: true,\n  },\n  {\n    id: \'hosp-delhi-3\',\n    name: \'Max Super Speciality Hospital, Saket\',\n 