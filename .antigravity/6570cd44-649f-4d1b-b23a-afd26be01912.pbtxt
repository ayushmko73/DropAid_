    content: "              )}\n\n              {/* HOSPITAL DIRECTORY PREVIEW ON HOMEPAGE */}\n              <div className=\"pt-2\">\n                <HospitalDirectory\n                  currentDestinationId={currentDropoff.hospitalId}\n                  onSelectHospital={(hosp) => {\n                    onDropoffChange({ lat: hosp.lat, lng: hosp.lng }, hosp.name, hosp.id);\n                  }}\n                />\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* ---------------- TAB 2: 10 HOSPITAL DIRECTORY FULL VIEW ---------------- */}\n      {activeTab === \'hospitals\' && (\n        <div className=\"space-y-4\">\n          {activeBooking && activeBooking.stage !== \'completed\' && activeBooking.stage !== \'cancelled\' && (\n            <div className=\"p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 flex items-center gap-2\">\n              <ShieldAlert className=\"w-4 h-4 text-amber-600 shrink-0\" />\n              <span>\n                Active Trip in Progress (<strong>{activeBooking.trackingCode}</strong>): Destination hospital is locked to maintain emergency dispatch protocol. Hospital changes can only be performed through an authorized dispatch operator workflow.\n              </span>\n            </div>\n          )}\n          <HospitalDirectory\n            currentDestinationId={currentDropoff.hospitalId}\n            onSelectHospital={(hosp) => {\n              if (activeBooking && activeBooking.stage !== \'completed\' && activeBooking.stage !== \'cancelled\') {\n                return; // LOCKED\n              }\n              onDropoffChange({ lat: hosp.lat, lng: hosp.lng }, hosp.name, hosp.id);\n              setActiveTab(\'dispatch\');\n            }}\n          />\n        </div>\n      )}\n\n      {/* ---------------- TAB 3: TRIP HISTORY ---------------- */}"
