            }
            lines {
              text: "    // Update assigned unit status"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    serverAmbulances = serverAmbulances.map((a) =>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
