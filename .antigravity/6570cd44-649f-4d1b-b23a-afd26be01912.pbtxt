      thinking_signature: "\022\247\t\n\244\t\001i\024}\023\220\264\234\350o\333\333P\317\r]K\023\327265=\252\326,\233\326\314G=\n\035\022\006\354\307\224o\247\026\330\355]\267\3718\346\244\2569\262uS\255\200\314!\365\000\177\235\210QQ!\257\236\3377\3659\021!\266\243\222  \240\246\262\221^\324\330\367\377\344\235+\253\215\200eo\205&\224QYpH\222\a\212F\264Lj\367\030\204sq1\223J^Qb\270P\033\253q\343mp\035H\027\311\234\224\365\a\"\340P\375\2005\243\305\323\001c\373\322\3054\313Nr\330=-B\323@^B\257.\321T\346\307\366\373\207\215\305\2679.tRe\342\341\364\215N\265s$ #=\225v\376p\n\255p\000\245\356\351I\302\213\320\325n\237{\004!\344Z>te$\272\305\377\374\317\362\363\373\263\323T\237\245\352\252\323\034\230\217\b9\264\a\201OT\315\247wD\360G\207\350E\025\303g\276]\a,\022\374\\l5ih>\210\021\242\314\336\215N_\264\302\232\016\376\3352\331\365\252\371\365K\\/R\212\2015\367\033\017\345\"\242M\313\245t,\251\200\256\203\312X]\347~\f%.\212 \227\205\n\002\345\225gE\312\241g|\204`\264Lh\037_\341\267\021\255\372\314\250z\300~]\317\024\017\371\225G\247\377ql\366q\360_-\254\t\233\266\216\256\250\365I\361\rR\006\266\275\t\356na\2473\\\312\355\r\360\027wt\037\2126A&\245\032\333oV\376\256\242\273\353$\340\245\323\001\244,\2427\323a\350~3~K\315\314\317>\3479\204\2351\257\016\322\215\365\355\371\251}\357M\340R\213\312E\374\355T,\374\035W\342w\0258Z\317\005G\271LS\307O0\270\345\nk\322\201\022\177h\"\030\303Uzj\274\242\300\006GyDf\213\347i\205\003\332\367\312\342\037\333kyB\2563w_\340L\366?\231\301|\250\376\237\365\366\371[>\252kZ\365cg|\004KQ\302S\323\222Z\212\0350`\275\273\352i\257\232)\003\233\214\035\2640O\302\030U\361=\004\247\317v\016\272\244\027\207\030\006\\\260\254\267\336/-\310v\363@\265\023\274\263k\203X\236!s\367\300\343g\tJs\017[\233i[+z?(\336c\202\031J\274\330\\X\357r2\"\235[)\273\355\230\250{}\223\b\21739e\a]j\024\321\227u\340M-\375\274Cu\020\344L9(\027F\377\311\177q\b\375l\350\213n\277\251\264E\202l\356\370\323\367\203\022\273a\033\366hZ\303\027\253C\021\310\323K\023^\215PF\305\2