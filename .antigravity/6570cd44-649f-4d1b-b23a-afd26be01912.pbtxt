    content: "          </div>\n\n          {/* Right 8 Cols: Detail & Dispatch Controller */}\n          <div className=\"lg:col-span-8\">\n            {selectedBooking ? (\n              <div className=\"bg-white border border-slate-200 rounded-xl p-6 shadow-2xs space-y-6\">\n                {/* Header & Stage Progress */}\n                <div className=\"flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-200\">\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <h3 className=\"text-lg font-bold text-slate-900\">\n                        Dispatch #{selectedBooking.trackingCode}\n                      </h3>\n                      <span className=\"text-xs font-semibold bg-sky-100 text-sky-800 px-2.5 py-0.5 rounded-md uppercase\">\n                        {selectedBooking.stage.replace(/_/g, \' \')}\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-slate-500 mt-0.5\">\n                      Patient: <span className=\"font-semibold text-slate-800\">{selectedBooking.patientName}</span> ({selectedBooking.patientPhone})\n                    </p>\n                  </div>\n\n                  {/* Accept / Reject if pending */}\n                  {selectedBooking.stage === \'pending\' && (\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={() => onAcceptBooking(selectedBooking.id)}\n                        className=\"px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold flex items-center gap-1.5 shadow-2xs cursor-pointer transition-colors\"\n                      >\n                        <Check className=\"w-4 h-4\" />\n                        <span>Accept Emergency Request</span>\n                      </button>\n                      <button\n                        onClick={() => onRejectBooking(selectedBooking.id)}\n                        className=\"px-3 py-2 bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-700 border border-slate-200 rounded-lg text-xs font-semibold transition-colors cursor-pointer\"\n                      >\n                        Reject\n                      </button>\n                    </div>\n                  )}\n\n                  {/* Next Stage Advancement */}\n                  {selectedBooking.stage !== \'pending\' && selectedBooking.stage !== \'completed\' && selectedBooking.stage !== \'cancelled\' && (\n                    <div className=\"flex items-center gap-2\">\n                      {getNextStage(selectedBooking.stage) && (\n                        <button\n                          onClick={() =>\n                            onAdvanceStage(selectedBooking.id, getNextStage(selectedBooking.stage)!)\n                          }\n                          className=\"px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white rounded-lg text-xs font-bold flex items-center gap-1.5 shadow-2xs cursor-pointer transition-colors\"\n                        >\n                          <span>Advance to: {getStageLabel(getNextStage(selectedBooking.stage)!)}</span>\n                          <ChevronRight className=\"w-4 h-4\" />\n                        </button>\n                      )}\n                    </div>\n                  )}\n                </div>\n\n                {/* Trip Stages Visual Stepper */}\n                <div className=\"py-2\">\n                  <span className=\"block text-xs font-bold text-slate-700 uppercase tracking-wide mb-3\">\n                    Trip Stage Progression\n                  </span>\n                  <div className=\"grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-1.5\">\n                    {STAGE_ORDER.map((stage, idx) => {\n                      const isCurrent = selectedBooking.stage === stage;\n                      const isPassed =\n                        STAGE_ORDER.indexOf(selectedBooking.stage) >= idx &&\n                        selectedBooking.stage !== \'cancelled\';\n\n                      return (\n                        <button\n                          key={stage}\n                          onClick={() => onAdvanceStage(selectedBooking.id, stage)}\n                          className={`p-2 rounded-lg text-left border text-[11px] font-semibold transition-colors cursor-pointer ${\n                            isCurrent\n                              ? \'border-sky-600 bg-sky-50 text-sky-900 ring-2 ring-sky-200\'\n                              : isPassed\n                              ? \'border-emerald-300 bg-emerald-50 text-emerald-800\'\n                              : \'border-slate-200 bg-slate-50 text-slate-500 hover:bg-slate-100\'\n                          }`}\n                        >\n                          <div className=\"text-[10px] opacity-75 font-mono\">Step {idx + 1}</div>\n                          <div className=\"truncate capitalize\">{stage.replace(/_/g, \' \')}</div>\n                        </button>\n                      );\n                    })}\n                  </div>\n                </div>\n\n                {/* Locations and Symptoms Grid */}\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n                  <div className=\"bg-slate-50 p-3.5 rounded-lg border border-slate-200 space-y-2\">\n                    <span className=\"font-bold text-slate-700 uppercase tracking-wide\">\n                      Route Locations\n                    </span>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Pickup Point:</span>\n                      <div className=\"font-bold text-slate-900 mt-0.5\">{selectedBooking.pickupAddress}</div>\n                    </div>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Destination ER:</span>\n                      <div className=\"font-bold text-sky-700 mt-0.5\">{selectedBooking.dropoffAddress}</div>\n                    </div>\n                  </div>\n\n                  <div className=\"bg-slate-50 p-3.5 rounded-lg border border-slate-200 space-y-2\">\n                    <span className=\"font-bold text-slate-700 uppercase tracking-wide\">\n                      Triage Information\n                    </span>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Reported Symptoms:</span>\n                      <div className=\"text-slate-800 font-medium mt-0.5\">\n                        {selectedBooking.patientNotes || \'No notes provided by caller.\'}\n                      </div>\n                    </div>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Requested Equipment:</span>\n                      <div className=\"flex flex-wrap gap-1 mt-1\">"
