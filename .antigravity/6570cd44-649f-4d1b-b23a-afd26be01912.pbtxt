    content: "    } catch {\n      // Fallback\n    }\n\n    setBookings((prev) =>\n      prev.map((b) => (b.id === bookingId ? { ...b, assignedUnitId: unitId } : b))\n    );\n    setAmbulances((prev) =>\n      prev.map((a) => (a.id === unitId ? { ...a, status: \'en_route_pickup\', currentBookingId: bookingId } : a))\n    );\n    showToast(`Unit ${unit.callSign} reassigned from ${unit.stationName}`, \'success\');\n  };\n\n  const handleCancelActiveBooking = (bookingId: string) => {\n    handleAdvanceStage(bookingId, \'cancelled\');\n  };\n\n  // RESET SIMULATION STATE\n  const handleResetSimulation = async () => {\n    try {\n      await fetch(\'/api/reset\', { method: \'POST\' });\n    } catch {\n      // Local reset regardless\n    }\n\n    localStorage.removeItem(\'dropaid_bookings\');\n    localStorage.removeItem(\'dropaid_ambulances\');\n\n    // Reset ambulances to base stations in Delhi NCR (10 Hospital Bays + 4 Roaming Patrols)\n    setAmbulances(INITIAL_AMBULANCES);\n\n    // Reset default pickup & dropoff\n    const defaultPickup = {\n      coords: { lat: 28.6327, lng: 77.2197 },\n      address: \'Connaught Place (Inner Circle), Block A, New Delhi\',"
