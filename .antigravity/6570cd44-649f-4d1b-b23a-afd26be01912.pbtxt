      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add My Profile button in Header navigation\", \"EndLine\":63, \"Instruction\":\"Add My Profile nav button and import UserCircle icon\", \"ReplacementContent\":\"import React from \'react\';\\nimport { ViewMode } from \'../../types/index.ts\';\\nimport { Siren, RefreshCw, User, Headset, PhoneCall, Box, Building2, UserCircle } from \'lucide-react\';\\n\\ninterface HeaderProps {\\n  currentView: ViewMode;\\n  onViewChange: (view: ViewMode) => void;\\n  onReset: () => void;\\n  onOpen3DViewer: () => void;\\n  activeBookingCount: number;\\n}\\n\\nexport const Header: React.FC<HeaderProps> = ({\\n  currentView,\\n  onViewChange,\\n  onReset,\\n  onOpen3DViewer,\\n  activeBookingCount,\\n}) => {\\n  return (\\n    <header className=\\\"sticky top-0 z-40 bg-white/98 border-b border-slate-200\\\">\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-8\\\">\\n        {/* Zone 1: Brand Wordmark (Logo Icon Removed as requested) */}\\n        <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n          <div>\\n            <span className=\\\"text-xl font-extrabold tracking-tight text-slate-900 whitespace-nowrap\\\">\\n              Drop<span className=\\\"text-sky-600\\\">Aid</span>\\n            </span>\\n            <span className=\\\"hidden sm:inline-block ml-2.5 text-[11px] font-semibold text-slate-500 uppercase tracking-wider\\\">\\n              Emergency Dispatch\\n            </span>\\n          </div>\\n        </div>\\n\\n        {/* Zone 2: Navigation Links */}\\n        <nav className=\\\"flex items-center gap-3 sm:gap-5 text-xs font-semibold text-slate-600\\\">\\n          <button\\n            onClick={() => onViewChange(\'hospitals\')}\\n            className={`hover:text-sky-600 transition-colors whitespace-nowrap shrink-0 flex items-center gap-1.5 cursor-pointer ${\\n              currentView === \'hospitals\'\\n                ? \'text-sky-600 font-bold bg-sky-50 px-2.5 py-1 rounded-md\'\\n                : \'\'\\n            }`}\\n          >\\n            <Building2 className=\\\"w-3.5 h-3.5 text-sky-600\\\" />\\n            <span>Hospitals</span>\\n          </button>\\n          <button\\n            onClick={() => onViewChange(\'profile\')}\\n            className={`hover:text-sky-600 transition-colors whitespace-nowrap shrink-0 flex items-center gap-1.5 cursor-pointer ${\\n              currentView === \'profile\'\\n                ? \'text-sky-600 font-bold bg-sky-50 px-2.5 py-1 rounded-md\'\\n                : \'\'\\n            }`}\\n          >\\n            <UserCircle className=\\\"w-3.5 h-3.5 text-sky-600\\\" />\\n            <span>My Profile</span>\\n          </button>\\n          <button\\n            onClick={onOpen3DViewer}\\n            className=\\\"hover:text-sky-600 transition-colors whitespace-nowrap shrink-0 flex items-center gap-1.5 cursor-pointer hidden md:flex\\\"\\n          >\\n            <Box className=\\\"w-3.5 h-3.5 text-sky-600\\\" />\\n            <span>3D Fleet Inspector</span>\\n          </button>\\n          <a\\n            href=\\\"tel:911\\\"\\n            className=\\\"text-rose-600 hover:text-rose-700 transition-colors whitespace-nowrap shrink-0 flex items-center gap-1 font-bold\\\"\\n          >\\n            <PhoneCall className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Emergency 911</span>\\n          </a>\\n        </nav>\", \"StartLine\":1, \"TargetContent\":\"import React from \'react\';\\nimport { ViewMode } from \'../../types/index.ts\';\\nimport { Siren, RefreshCw, User, Headset, PhoneCall, Box, Building2 } from \'lucide-react\';\\n\\ninterface HeaderProps {\\n  currentView: ViewMode;\\n  onViewChange: (view: ViewMode) => void;\\n  onReset: () => void;\\n  onOpen3DViewer: () => void;\\n  activeBookingCount: number;\\n}\\n\\nexport const Header: React.FC<HeaderProps> = ({\\n  currentView,\\n  onViewChange,\\n  onReset,\\n  onOpen3DViewer,\\n  activeBookingCount,\\n}) => {\\n  return (\\n    <header className=\\\"sticky top-0 z-40 bg-white/98 border-b border-slate-200\\\">\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-8\\\">\\n        {/* Zone 1: Brand Wordmark (Logo Icon Removed as requested) */}\\n        <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n          <div>\\n            <span className=\\\"text-xl font-extrabold tracking-tight text-slate-900 whitespace-nowrap\\\">\\n              Drop<span className=\\\"text-sky-600\\\">Aid</span>\\n            </span>\\n            <span className=\\\"hidden sm:inline-block ml-2.5 text-[11px] font-semibold text-slate-500 uppercase tracking-wider\\\">\\n              Emergency Dispatch\\n            </span>\\n          </div>\\n        </div>\\n\\n        {/* Zone 2: Navigation Links */}\\n        <nav className=\\\"flex items-center gap-4 sm:gap-6 text-xs font-semibold text-slate-600\\\">\\n          <button\\n            onClick={() => onViewChange(\'hospitals\')}\\n            className={`hover:text-sky-600 transition-colors whitespace-nowrap shrink-0 flex items-center gap-1.5 cursor-pointer ${\\n              currentView === \'hospitals\'\\n                ? \'text-sky-600 font-bold bg-sky-50 px-2.5 py-1 rounded-md\'\\n                : \'\'\\n            }`}\\n          >\\n            <Building2 className=\\\"w-3.5 h-3.5 text-sky-600\\\" />\\n            <span>Hospitals</span>\\n          </button>\\n          <button\\n            onClick={onOpen3DViewer}\\n            className=\\\"hover:text-sky-600 transition-colors whitespace-nowrap shrink-0 flex items-center gap-1.5 cursor-pointer hidden md:flex\\\"\\n          >\\n            <Box className=\\\"w-3.5 h-3.5 text-sky-600\\\" />\\n            <span>3D Fleet Inspector</span>\\n          </button>\\n          <a\\n            href=\\\"tel:911\\\"\\n            className=\\\"text-rose-600 hover:text-rose-700 transition-colors