    end_line: 119
    content: "import React, { useState } from \'react\';\nimport { Hospital, LatLng } from \'../../types/index.ts\';\nimport { HOSPITALS } from \'../../data/mockData.ts\';\nimport {\n  Building2,\n  Phone,\n  MapPin,\n  Clock,\n  Bed,\n  CheckCircle,\n  Search,\n  ExternalLink,\n  ShieldCheck,\n  HeartPulse,\n  Navigation\n} from \'lucide-react\';\n\ninterface HospitalDirectoryProps {\n  currentDestinationId?: string;\n  onSelectHospital: (hospital: Hospital) => void;\n  className?: string;\n}\n\nexport const HospitalDirectory: React.FC<HospitalDirectoryProps> = ({\n  currentDestinationId,\n  onSelectHospital,\n  className = \'\',\n}) => {\n  const [selectedRegion, setSelectedRegion] = useState<\'All\' | \'Delhi\' | \'Noida\' | \'Haryana\'>(\'All\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  const filteredHospitals = HOSPITALS.filter((h) => {\n    const matchesRegion = selectedRegion === \'All\' || h.region === selectedRegion;\n    const matchesSearch =\n      !searchQuery ||\n      h.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      h.address.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      h.city.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      h.specialties.some((s) => s.toLowerCase().includes(searchQuery.toLowerCase()));\n    return matchesRegion && matchesSearch;\n  });\n\n  const getRegionCounts = (region: \'All\' | \'Delhi\' | \'Noida\' | \'Haryana\') => {\n    if (region === \'All\') return HOSPITALS.length;\n    return HOSPITALS.filter((h) => h.region === region).length;\n  };\n\n  return (\n    <div className={`space-y-4 ${className}`}>\n      {/* Directory Title & Region Filters */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3 border-b border-slate-200\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <Building2 className=\"w-5 h-5 text-sky-600\" />\n            <h3 className=\"text-base font-bold text-slate-900\">\n              Verified Hospital Directory (Delhi \302\267 Noida \302\267 Haryana)\n            </h3>\n          </div>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            10 verified emergency facilities with live ICU bed telemetry & emergency trauma teams.\n          </p>\n        </div>\n\n        {/* Region Filter Segmented Tabs */}\n        <div className=\"flex items-center p-1 bg-slate-100 rounded-lg border border-slate-200 self-start sm:self-auto\">\n          {([\'All\', \'Delhi\', \'Noida\', \'Haryana\'] as const).map((region) => (\n            <button\n              key={region}\n              type=\"button\"\n              onClick={() => setSelectedRegion(region)}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer flex items-center gap-1.5 ${\n                selectedRegion === region\n                  ? \'bg-white text-slate-900 shadow-2xs font-bold\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              <span>{region}</span>\n              <span className={`text-[10px] px-1.5 py-0.2 rounded-full font-mono ${\n                selectedRegion === region ? \'bg-sky-100 text-sky-800\' : \'bg-slate-200 text-slate-600\'\n              }`}>\n                {getRegionCounts(region)}\n              </span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Search Input Bar */}\n      <div className=\"relative\">\n        <input\n          type=\"text\"\n          value={searchQuery}\n          onChange={(e) => setSearchQuery(e.target.value)}\n          placeholder=\"Search by hospital name, city, locality, or medical specialty (e.g. Trauma, Cardiac, Burn)...\"\n          className=\"w-full text-xs text-slate-800 bg-white border border-slate-300 rounded-lg p-2.5 pl-9 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 shadow-2xs\"\n        />\n        <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n      </div>\n\n      {/* Hospital Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredHospitals.map((hosp) => {\n          const isSelected = currentDestinationId === hosp.id;\n\n          return (\n            <div\n              key={hosp.id}\n              className={`bg-white border rounded-xl overflow-hidden shadow-2xs transition-all flex flex-col justify-between ${\n                isSelected\n                  ? \'border-sky-600 ring-2 ring-sky-200 shadow-sm\'\n                  : \'border-slate-200 hover:border-slate-300\'\n              }`}\n            >\n              <div>\n                {/* Photo & Status Banner */}\n                <div className=\"relative h-36 w-full overflow-hidden bg-slate-100\">\n                  <img\n                    src={hosp.image}\n                    alt={hosp.name}\n                    className=\"w-full h-full object-cover\""
