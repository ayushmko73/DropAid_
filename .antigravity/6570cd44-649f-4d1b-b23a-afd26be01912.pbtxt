    end_line: 139
    content: "import React, { useState } from \'react\';\nimport { Upload, X, Check, Image as ImageIcon, FileText, Shield, RefreshCw } from \'lucide-react\';\nimport { BookingDocument } from \'../../types/index.ts\';\n\ninterface CloudinaryUploadModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onUploadComplete: (doc: BookingDocument) => void;\n  targetCategory?: \'id_card\' | \'insurance\' | \'medical_history\' | \'incident_photo\';\n  title?: string;\n}\n\nexport const CloudinaryUploadModal: React.FC<CloudinaryUploadModalProps> = ({\n  isOpen,\n  onClose,\n  onUploadComplete,\n  targetCategory = \'insurance\',\n  title = \'Upload Medical Document / Photo\',\n}) => {\n  const [filePreview, setFilePreview] = useState<string | null>(null);\n  const [fileName, setFileName] = useState<string>(\'\');\n  const [fileSize, setFileSize] = useState<number>(0);\n  const [selectedCategory, setSelectedCategory] = useState<\'id_card\' | \'insurance\' | \'medical_history\' | \'incident_photo\'>(targetCategory);\n  const [isUploading, setIsUploading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n\n  if (!isOpen) return null;\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      setFileName(file.name);\n      setFileSize(file.size);\n      const reader = new FileReader();\n      reader.onload = () => {\n        setFilePreview(reader.result as string);\n        setErrorMsg(null);\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  const handleUpload = async () => {\n    if (!filePreview) {\n      setErrorMsg(\'Please select a file to upload.\');\n      return;\n    }\n\n    setIsUploading(true);\n    setErrorMsg(null);\n\n    try {\n      const response = await fetch(\'/api/cloudinary/upload\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          fileData: filePreview,\n          folder: `dropaid_${selectedCategory}`,\n          fileName: fileName.replace(/\\.[^/.]+$/, \'\'),\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(`Upload server error: ${response.status}`);\n      }\n\n      const data = await response.json();\n\n      const newDoc: BookingDocument = {\n        id: `doc-${Date.now()}`,\n        name: fileName,\n        type: selectedCategory,\n        url: data.secure_url || filePreview,\n        uploadedAt: new Date().toISOString(),\n        source: data.source || \'local_optimized\',\n        bytes: fileSize,\n      };\n\n      onUploadComplete(newDoc);\n      onClose();\n    } catch (err: any) {\n      console.error(err);\n      setErrorMsg(err.message || \'Upload failed. Please check network.\');\n    } finally {\n      setIsUploading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs\">\n      <div className=\"bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Modal Header */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-200\">\n          <div className=\"flex items-center gap-2\">\n            <Shield className=\"w-5 h-5 text-sky-600\" />\n            <h3 className=\"text-base font-bold text-slate-900\">{title}</h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 p-1 rounded-md transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6 space-y-4\">\n          {/* Document Type Selector */}\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5\">\n              Category\n            </label>\n            <div className=\"grid grid-cols-2 gap-2 text-xs\">\n              <button\n                type=\"button\"\n                onClick={() => setSelectedCategory(\'insurance\')}\n                className={`p-2.5 rounded-lg border text-left font-medium transition-colors cursor-pointer ${\n                  selectedCategory === \'insurance\'\n                    ? \'border-sky-600 bg-sky-50 text-sky-900\'\n                    : \'border-slate-200 hover:bg-slate-50 text-slate-700\'\n                }`}\n              >\n                Health Insurance Card\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setSelectedCategory(\'id_card\')}\n                className={`p-2.5 rounded-lg border text-left font-medium transition-colors cursor-pointer ${\n                  selectedCategory === \'id_card\'\n                    ? \'border-sky-600 bg-sky-50 text-sky-900\'\n                    : \'border-slate-200 hover:bg-slate-50 text-slate-700\'\n                }`}\n              >\n                Government Photo ID\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setSelectedCategory(\'medical_history\')}\n                className={`p-2.5 rounded-lg border text-left font-medium transition-colors cursor-pointer ${\n                  selectedCategory === \'medical_history\'"
