              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dropoffCoords = { lat: hospital.lat, lng: hospital.lng };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const bookingId = `sim-ride-${Date.now()}-${Math.floor(Math.random() * 1000)}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const trackingCode = `SIM-${Math.floor(2000 + Math.random() * 8000)}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const simTimeString = formatSimTime(simulationState.simulatedHour, simulationState.simulatedMinute);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Proximity auto-assignment"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const nearestResult = findNearestAvailableAmbulance(pickupCoords, serverAmbulances);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const assigned = nearestResult?.ambulance || null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let initialStage: TripStage = \'pending\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let assignedUnitId: string | undefined = undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let routePolyline: [number, number][] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let distanceKm = nearestResult ? nearestResult.distanceKm : 5.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let etaMinutes = nearestResult ? nearestResult.etaMinutes : 6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (assigned) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    initialStage = \'en_route_pickup\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    assignedUnitId = assigned.id;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    try {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const leg1 = await getDrivingRoute(assigned.location, pickupCoords);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      routePolyline = leg1.polyline;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      distanceKm = leg1.distanceKm;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      etaMinutes = leg1.etaMinutes;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } catch {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      routePolyline = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        [assigned.location.lat, assigned.location.lng],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        [pickupCoords.lat, pickupCoords.lng],"
