    absolute_path_uri: "file:///server.ts"
    end_line: 99
    content: "import express, { Request, Response } from \'express\';\nimport { createServer as createViteServer } from \'vite\';\nimport dotenv from \'dotenv\';\nimport path from \'path\';\nimport { HOSPITALS, INITIAL_AMBULANCES, INITIAL_DEMO_BOOKING } from \'./src/data/mockData.ts\';\nimport { findNearestAvailableAmbulance, getDrivingRoute } from \'./src/services/routingService.ts\';\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\n// Middleware for parsing JSON with generous limit for image data\napp.use(express.json({ limit: \'25mb\' }));\n\n// Server-side in-memory store for real-time synchronization\nlet serverBookings = [INITIAL_DEMO_BOOKING];\nlet serverAmbulances = [...INITIAL_AMBULANCES];\nlet sharedPlatformState: any = null;\n\n// Cloudinary configuration (from env)\nconst CLOUDINARY_CLOUD_NAME = process.env.CLOUDINARY_CLOUD_NAME || \'demo\';\nconst CLOUDINARY_API_KEY = process.env.CLOUDINARY_API_KEY || \'\';\nconst CLOUDINARY_API_SECRET = process.env.CLOUDINARY_API_SECRET || \'\';\n\n// 1. Hospital Directory API (10 Verified Hospitals across Delhi, Noida, Haryana)\napp.get(\'/api/hospitals\', (req: Request, res: Response) => {\n  const { region, search } = req.query;\n  let result = HOSPITALS;\n\n  if (region && typeof region === \'string\' && region.toLowerCase() !== \'all\') {\n    result = result.filter((h) => h.region.toLowerCase() === region.toLowerCase());\n  }\n\n  if (search && typeof search === \'string\') {\n    const q = search.toLowerCase();\n    result = result.filter(\n      (h) =>\n        h.name.toLowerCase().includes(q) ||\n        h.address.toLowerCase().includes(q) ||\n        h.specialties.some((s) => s.toLowerCase().includes(q))\n    );\n  }\n\n  res.json({\n    success: true,\n    count: result.length,\n    hospitals: result,\n  });\n});\n\n// 2. Ambulance Fleet API\napp.get(\'/api/fleet\', (_req: Request, res: Response) => {\n  res.json({\n    success: true,\n    ambulances: serverAmbulances,\n  });\n});\n\n// 3. Bookings API\napp.get(\'/api/bookings\', (_req: Request, res: Response) => {\n  res.json({\n    success: true,\n    bookings: serverBookings,\n  });\n});\n\n// Create Booking (Both 5-Second Hold and Manual Booking Flows with Nearest Ambulance Dispatch)\napp.post(\'/api/bookings\', async (req: Request, res: Response) => {\n  try {\n    const {\n      patientName = \'Aarav Malhotra\',\n      patientPhone = \'+91 98765 43210\',\n      patientNotes = \'Immediate emergency dispatch requested\',\n      pickupAddress,\n      pickupCoords,\n      dropoffAddress,\n      dropoffCoords,\n      destinationHospitalId,\n      equipmentRequested = [\'eq-als\', \'eq-cardiac\'],\n      bookingType = \'emergency_hold\', // \'emergency_hold\' or \'manual\'\n    } = req.body;\n\n    if (!pickupCoords || typeof pickupCoords.lat !== \'number\' || typeof pickupCoords.lng !== \'number\') {\n      return res.status(400).json({ error: \'Valid pickup coordinates (lat, lng) are required.\' });\n    }\n\n    if (!dropoffCoords || typeof dropoffCoords.lat !== \'number\' || typeof dropoffCoords.lng !== \'number\') {\n      return res.status(400).json({ error: \'Valid destination coordinates (lat, lng) are required.\' });\n    }\n\n    // 1. Calculate nearest available ambulance across Delhi NCR (hospital stationed or roaming)\n    const nearestResult = findNearestAvailableAmbulance(pickupCoords, serverAmbulances);\n    const assigned = nearestResult ? nearestResult.ambulance : (serverAmbulances.find(a => a.status === \'available\') || serverAmbulances[0]);\n\n    const bookingId = `bk-${Date.now()}`;\n    const trackingCode = `DA-${Math.floor(1000 + Math.random() * 9000)}`;\n\n    // 2. Compute driving road route from assigned ambulance\'s current location to pickup\n    let routePolyline: [number, number][] = [];"
    num_lines: 315
    num_bytes: 10881
    line_range_bytes: 3638
  }
}
