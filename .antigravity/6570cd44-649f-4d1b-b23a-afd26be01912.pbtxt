    content: "    let distanceKm = nearestResult?.distanceKm || 4.5;\n    let etaMinutes = nearestResult?.etaMinutes || 5;\n\n    try {\n      const routeData = await getDrivingRoute(assigned.location, pickupCoords);\n      routePolyline = routeData.polyline;\n      distanceKm = routeData.distanceKm;\n      etaMinutes = routeData.etaMinutes;\n    } catch {\n      routePolyline = [\n        [assigned.location.lat, assigned.location.lng],\n        [pickupCoords.lat, pickupCoords.lng],\n      ];\n    }\n\n    const newBooking = {\n      id: bookingId,\n      trackingCode,\n      createdAt: new Date().toISOString(),\n      patientName,\n      patientPhone,\n      patientNotes: `${bookingType === \'emergency_hold\' ? \'[Quick 5s Hold Dispatch] \' : \'[Manual Assisted Booking] \'}${patientNotes}`,\n      pickupAddress: pickupAddress || `GPS Location (${pickupCoords.lat.toFixed(4)}, ${pickupCoords.lng.toFixed(4)})`,\n      pickupCoords,\n      dropoffAddress: dropoffAddress || \'Nearest Verified Hospital ER\',\n      dropoffCoords,\n      destinationHospitalId: destinationHospitalId || HOSPITALS[0].id,\n      equipmentRequested,\n      stage: \'en_route_pickup\' as const,\n      assignedUnitId: assigned.id,\n      etaMinutes,\n      distanceKm,\n      routePolyline,\n      currentVehiclePosition: [assigned.location.lat, assigned.location.lng],\n      priceEst: Math.round(150 + distanceKm * 18),\n      documents: [],\n      stageTimestamps: {\n        requested: new Date().toISOString(),\n        accepted: new Date().toISOString(),\n        dispatched: new Date().toISOString(),\n      },\n    };\n\n    // Update assigned ambulance status\n    serverAmbulances = serverAmbulances.map((a) =>\n      a.id === assigned.id\n        ? {\n            ...a,\n            status: \'en_route_pickup\' as const,\n            currentBookingId: bookingId,\n          }\n        : a\n    );\n\n    serverBookings = [newBooking as any, ...serverBookings];\n\n    return res.status(201).json({\n      success: true,\n      booking: newBooking,\n      assignedAmbulance: assigned,\n      message: `Emergency dispatch confirmed! Ambulance ${assigned.callSign} (${assigned.isHospitalStationed ? \'Stationed at \' + assigned.stationName : \'Corridor Patrol\'}) is en route.`,\n    });\n  } catch (err: any) {\n    console.error(\'Error creating booking:\', err);\n    return res.status(500).json({ error: err.message || \'Internal server error processing booking\' });\n  }\n});\n\n// Update booking stage\napp.post(\'/api/bookings/:id/stage\', (req: Request, res: Response) => {\n  const { id } = req.params;\n  const { stage } = req.body;\n\n  let found = false;\n  serverBookings = serverBookings.map((b) => {\n    if (b.id === id) {\n      found = true;\n      const updated = { ...b, stage };\n      return updated;\n    }"
