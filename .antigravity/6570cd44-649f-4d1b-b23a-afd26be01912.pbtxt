\nCLOUDINARY_CLOUD_NAME=\"demo\"\nCLOUDINARY_API_KEY=\"\"\nCLOUDINARY_API_SECRET=\"\"\nCLOUDINARY_UPLOAD_PRESET=\"dropaid_uploads\"\n\n\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>DropAid \342\200\224 Emergency Ambulance Dispatch & Tracking Platform</title>\n    <meta name=\"description\" content=\"Professional emergency ambulance booking platform with live GPS routing, 5-second hold confirmation, interactive Leaflet hospital map, synchronized operator/driver dispatch, 3D telemetry viewer, and AI scene video generation.\" />\n    <meta property=\"og:title\" content=\"DropAid \342\200\224 Emergency Ambulance Dispatch & Tracking Platform\" />\n    <meta property=\"og:description\" content=\"Professional emergency ambulance booking platform with live GPS routing, 5-second hold confirmation, interactive Leaflet hospital map, synchronized operator/driver dispatch, 3D telemetry viewer, and AI scene video generation.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" integrity=\"sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=\" crossorigin=\"\" />\n  </head>\n  <body class=\"bg-slate-50 text-slate-900 font-sans antialiased selection:bg-sky-500 selection:text-white\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Remix DropAid \342\200\224 by ayushEdit\",\n  \"description\": \"Professional emergency ambulance booking platform with live GPS routing, 5-second hold confirmation, interactive Leaflet hospital map, synchronized operator/driver dispatch, 3D telemetry viewer, and AI scene video generation.\",\n  \"requestFramePermissions\": [\n    \"geolocation\"\n  ],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useEffect, useRef, useCallback } from \'react\';\nimport {\n  ViewMode,\n  Booking,\n  AmbulanceUnit,\n  LatLng,\n  TripStage,\n  PatientProfile,\n  BookingDocument\n} from \'./types/index.ts\';\nimport {\n  HOSPITALS,\n  LANDMARKS,\n  INITIAL_AMBULANCES,\n  INITIAL_PATIENT,\n  INITIAL_DEMO_BOOKING\n} from \'./data/mockData.ts\';\nimport {\n  getDrivingRoute,\n  reverseGeocode,\n  calculateBearing,\n  calculateHaversineDistance,\n  findNearestAvailableAmbulance,\n} from \'./services/routingService.ts\';\nimport { Header } from \'./components/Common/Header.tsx\';\nimport { LeafletMap } from \'./components/Map/LeafletMap.tsx\';\nimport { UserDashboard } from \'./components/UserDashboard/UserDashboard.tsx\';\nimport { OperatorDashboard } from \'./components/OperatorDashboard/OperatorDashboard.tsx\';\nimport { AmbulanceViewer3D } from \'./components/Three/AmbulanceViewer3D.tsx\';\nimport { CloudinaryUploadModal } from \'./components/Cloudinary/CloudinaryUploadModal.tsx\';\nimport { CheckCircle2, AlertCircle, X } from \'lucide-react\';\n\nexport default function App() {\n  // 1. Primary Top Controls State\n  const [currentView, setCurrentView] = useState<ViewMode>(\'user\');\n\n  // 2. Map & Route State (Default: Central Delhi NCR)\n  const [pickup, setPickup] = useState<{ coords: LatLng; address: string }>({\n    coords: { lat: 28.6327, lng: 77.2197 }, // Connaught Place, New Delhi\n    address: \'Connaught Place (Inner Circle), Block A, New Delhi\',\n  });\n\n  const [dropoff, setDropoff] = useState<{ coords: LatLng; address: string; hospitalId?: string }>({\n    coords: { lat: HOSPITALS[0].lat, lng: HOSPITALS[0].lng }, // AIIMS, New Delhi\n    address: `${HOSPITALS[0].name}, ${HOSPITALS[0].address}`,\n    hospitalId: HOSPITALS[0].id,\n  });\n\n  const [routePolyline, setRoutePolyline] = useState<[number, number][]>([]);\n  const [routeDistanceKm, setRouteDistanceKm] = useState<number>(7.8);\n  const [routeEtaMins, setRouteEtaMins] = useState<number>(6);\n  const [routeError, setRouteError] = useState<string | null>(null);\n\n  // 3. Fleet & Bookings Simulation State\n  const [ambulances, setAmbulances] = useState<AmbulanceUnit[]>(() => {\n    const saved = localStorage.getItem(\'dropaid_ambulances\');\n    return saved ? JSON.parse(saved) : INITIAL_AMBULANCES;\n  });\n\n  const [bookings, setBookings] = useState<Booking[]>(() => {\n    const saved = localStorage.getItem(\'dropaid_bookings\');\n    return saved ? JSON.parse(saved) : [INITIAL_DEMO_BOOKING];\n  });\n\n  const [patientProfile, setPatientProfile] = useState<PatientProfile>(INITIAL_PATIENT);\n  const [gpsAccuracy, setGpsAccuracy] = useState<number>(10);\n  const [isDetectingGPS, setIsDetectingGPS] = useState<boolean>(false);\n  const [gpsError, setGpsError] = useState<string | null>(null);\n\n  // 4. Modals State\n  const [is3DViewerOpen, setIs3DViewerOpen] = useState(false);\n  const [isUploadModalOpen, setIsUploadModalOpen] = useState(false);\n  const [uploadCategory, setUploadCategory] = useState<\'id_card\' | \'insurance\' | \'medical_history\' | \'incident_photo\'>(\'insurance\');\n  const [toastMessage, setToastMessage] = useState<{ type: \'success\' | \'info\' | \'error\'; text: string } | null>(null);\n\n  // Active Booking\n  const activeBooking = bookings.find(\n    (b) => b.stage !== \'completed\' && b.stage !== \'cancelled\'\n  ) || null;\n\n  const assignedAmbulance = activeBooking?.assignedUnitId\n    ? ambulances.find((a) => a.id === activeBooking.assignedUnitId) || null\n    : null;\n\n  // Persist State to LocalStorage\n  useEffect(() => {\n    localStorage.setItem(\'dropaid_bookings\', JSON.stringify(bookings));\n  }, [bookings]);\n\n  useEffect(() => {\n    localStorage.setItem(\'dropaid_ambulances\', JSON.stringify(ambulances));\n  }, [ambulances]);\n\n  // Toast Helper\n  const showToast = (text: string, type: \'success\' | \'info\' | \'error\' = \'info\') => {\n    setToastMessage({ text, type });\n    setTimeout(() => setToastMessage(null), 3800);\n  };\n\n  // Recalculate Route whenever pickup or dropoff changes (only when no active trip is running)\n  const calculateCurrentRoute = useCallback(async (start: LatLng, end: LatLng) => {\n    setRouteError(null);\n    try {\n      const result = await getDrivingRoute(start, end);\n      setRoutePolyline(result.polyline);\n      setRouteDistanceKm(result.distanceKm);\n      setRouteEtaMins(result.etaMinutes);\n    } catch (err: any) {\n      console.warn(\'Failed to calculate route:\', err);\n      setRouteError(\'Route service calculating road grid path.\');\n    }\n  }, []);\n\n  useEffect(() => {\n    // If there is no active booking in progress, show planned pickup -> dropoff route preview\n    if (!activeBooking) {\n      calculateCurrentRoute(pickup.coords, dropoff.coords);\n    }\n  }, [pickup.coords, dropoff.coords, activeBooking, calculateCurrentRoute]);\n\n  // GPS Location Detection with Graceful Error & Permission Handling\n  const handleDetectGPS = useCallback(() => {\n    if (!navigator.geolocation) {\n      const msg = \'Geolocation is not supported by your browser.\';\n      setGpsError(msg);\n      showToast(msg, \'error\');\n      return;\n    }\n\n    setIsDetectingGPS(true);\n    setGpsError(null);\n\n    navigator.geolocation.getCurrentPosition(\n      async (pos) => {\n        const coords = { lat: pos.coords.latitude, lng: pos.coords.longitude };\n        const accuracy = Math.round(pos.coords.accuracy || 12);\n        setGpsAccuracy(accuracy);\n        setGpsError(null);\n\n        const address = await reverseGeocode(coords.lat, coords.lng);\n        setPickup({ coords, address });\n        setIsDetectingGPS(false);\n        showToast(`GPS Position detected: ${address.split(\',\')[0]} (\302\261${accuracy}m)`, \'success\');\n      },\n      (err) => {\n        setIsDetectingGPS(false);\n        let errorMsg = \'GPS location unavailable.\';\n        if (err.code === err.PERMISSION_DENIED) {\n          errorMsg = \'Location permission was denied by browser. Please enable location permissions or select your address below.\';\n        } else if (err.code === err.POSITION_UNAVAILABLE) {\n          errorMsg = \'GPS satellite fix or network position is currently unavailable.\';\n        } else if (err.code === err.TIMEOUT) {\n          errorMsg = \'GPS location request timed out.\';\n        }\n        setGpsError(errorMsg);\n        showToast(errorMsg, \'error\');\n      },\n      { enableHighAccuracy: true, timeout: 7000, maximumAge: 10000 }\n    );\n  }, []);\n\n  // Map Change Handlers\n  const handlePickupChange = (coords: LatLng, address: string) => {\n    setPickup({ coords, address });\n  };\n\n  const handleDropoffChange = (coords: LatLng, address: string, hospitalId?: string) => {\n    setDropoff({ coords, address, hospitalId });\n  };\n\n  // CREATE EMERGENCY BOOKING (Nearest Ambulance Dispatch from Hospital or Highway Patrol)\n  const handleCreateBooking = async (\n    equipmentIds: string[],\n    notes: string,\n    bookingType: \'emergency_hold\' | \'manual\' = \'emergency_hold\'\n  ) => {\n    // 1. Calculate nearest available ambulance across Delhi NCR\n    const nearestResult = findNearestAvailableAmbulance(pickup.coords, ambulances);\n    const assigned = nearestResult\n      ? nearestResult.ambulance\n      : ambulances.find((a) => a.status === \'available\') || ambulances[0];\n\n    // 2. Fetch Phase 1 road route: from assigned ambulance\'s current location to patient pickup\n    let phase1Polyline: [number, number][] = [];\n    let dispatchDistKm = nearestResult?.distanceKm || 4.2;\n    let dispatchEtaMins = nearestResult?.etaMinutes || 5;\n\n    try {\n      const leg1 = await getDrivingRoute(assigned.location, pickup.coords);\n      phase1Polyline = leg1.polyline;\n      dispatchDistKm = leg1.distanceKm;\n      dispatchEtaMins = leg1.etaMinutes;\n    } catch {\n      phase1Polyline = [\n        [assigned.location.lat, assigned.location.lng],\n        [pickup.coords.lat, pickup.coords.lng],\n      ];\n    }\n\n    setRoutePolyline(phase1Polyline);\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', system-ui, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n  }\n  \n  code, pre, .font-mono {\n    font-family: \'JetBrains Mono\', monospace;\n    font-variant-numeric: tabular-nums;\n  }\n}\n\n/* Leaflet map fixups */\n.leaflet-container {\n  font-family: inherit;\n  z-index: 10;\n  width: 100%;\n  height: 100%;\n}\n\n.leaflet-popup-content-wrapper {\n  border-radius: 0.75rem;\n  padding: 0.25rem;\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);\n}\n\n.leaflet-popup-content {\n  margin: 0.75rem 1rem;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n\n/* Custom pulsed radar ring for emergency vehicles */\n@keyframes siren-pulse {\n  0% { transform: scale(0.9); opacity: 0.9; }\n  50% { transform: scale(1.4); opacity: 0.3; }\n  100% { transform: scale(1.8); opacity: 0; }\n}\n\n.siren-ring {\n  animation: siren-pulse 1.8s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;\n}\n\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(<App />);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  },\n  \"exclude\": [\"dist\"]\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\342\200\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
