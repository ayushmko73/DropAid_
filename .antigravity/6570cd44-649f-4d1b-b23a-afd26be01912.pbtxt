              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  serverBookings = [newRide, ...serverBookings];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  simulationState.generatedCount += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return newRide;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "// Tick function that advances the simulation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "async function runSimulationTick() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (simulationState.status !== \'running\') return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Advance simulated clock: with speed multiplier (default 10 -> ~10 simulated minutes per tick)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const minuteIncrement = Math.max(2, Math.round(simulationState.speedMultiplier));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  simulationState.simulatedMinute += minuteIncrement;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (simulationState.simulatedMinute >= 60) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    simulationState.simulatedHour += Math.floor(simulationState.simulatedMinute / 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    simulationState.simulatedMinute = simulationState.simulatedMinute % 60;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (simulationState.simulatedHour >= 24) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    simulationState.simulatedDay += Math.floor(simulationState.simulatedHour / 24);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    simulationState.simulatedHour = simulationState.simulatedHour % 24;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // reset count for new simulated day target"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    simulationState.generatedCount = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const currentTotalSimMinutes = simulationState.simulatedDay * 1440 + simulationState.simulatedHour * 60 + simulationState.simulatedMinute;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Schedule ride generation: ~20 rides per 1440 minutes = roughly 1 ride every 72 simulated minutes (with jitter)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const minutesSinceLast = currentTotalSimMinutes - lastSimulatedRideMinute;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const intervalTarget = Math.max(45, Math.floor(1440 / simulationState.ridesTargetPerDay));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (minutesSinceLast >= intervalTarget && simulationState.generatedCount < simulationState.ridesTargetPerDay) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lastSimulatedRideMinute = currentTotalSimMinutes;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    try {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      await generateSimulatedRide();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } catch (err) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      console.warn(\'Simulation ride generation error:\', err);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Auto-assign any pending simulated rides if ambulances became available"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
