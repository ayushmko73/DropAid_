    content: "\n  return (\n    <div className=\"space-y-6\">\n      {/* Sub-Navigation Tabs */}\n      <div className=\"flex items-center justify-between border-b border-slate-200 pb-3\">\n        <div className=\"flex items-center gap-1 bg-slate-100 p-1 rounded-lg\">\n          <button\n            onClick={() => setActiveTab(\'dispatch\')}\n            className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer ${\n              activeTab === \'dispatch\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            Emergency Dispatch\n          </button>\n          <button\n            onClick={() => setActiveTab(\'hospitals\')}\n            className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer flex items-center gap-1.5 ${\n              activeTab === \'hospitals\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Building2 className=\"w-3.5 h-3.5 text-sky-600\" />\n            <span>Hospital Directory (10)</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'history\')}\n            className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer flex items-center gap-1.5 ${\n              activeTab === \'history\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <span>Trip History</span>\n            <span className=\"text-[10px] bg-slate-200 px-1.5 py-0.2 rounded-full font-mono\">\n              {bookingHistory.length}\n            </span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'medical_id\')}\n            className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer ${\n              activeTab === \'medical_id\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            Patient Medical ID\n          </button>\n        </div>\n\n        {/* Quick Document Upload Trigger */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => onOpenUploadModal(\'insurance\')}\n            className=\"hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-lg shadow-2xs transition-colors cursor-pointer\"\n          >\n            <FileText className=\"w-3.5 h-3.5 text-slate-500\" />\n            <span>Upload Insurance Card</span>\n          </button>\n        </div>\n      </div>\n\n      {/* ---------------- TAB 1: EMERGENCY DISPATCH & HOMEPAGE HERO ---------------- */}\n      {activeTab === \'dispatch\' && (\n        <div className=\"space-y-6\">\n          {/* Active Booking Live Tracking Card (if in progress) */}\n          {activeBooking && activeBooking.stage !== \'completed\' && activeBooking.stage !== \'cancelled\' ? (\n            <div className=\"bg-sky-50 border-2 border-sky-600 rounded-xl p-5 shadow-sm\">\n              <div className=\"flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-sky-200\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 rounded-lg bg-sky-600 flex items-center justify-center text-white font-bold text-sm\">\n                    {assignedAmbulance?.type || \'ALS\'}\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <h3 className=\"text-base font-bold text-slate-900\">\n                        {assignedAmbulance?.callSign || \'Unit Assigning...\'}\n                      </h3>\n                      <span className=\"text-xs font-semibold bg-sky-100 text-sky-800 px-2 py-0.5 rounded-md uppercase tracking-wide\">\n                        {activeBooking.stage.replace(/_/g, \' \')}\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-slate-600 mt-0.5\">\n                      Tracking Code: <span className=\"font-mono font-bold text-slate-900\">{activeBooking.trackingCode}</span> \302\267 Requested at {new Date(activeBooking.createdAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => setShowShareModal(true)}\n                    className=\"inline-flex items-center gap-1.5 text-xs font-bold text-sky-700 bg-white border border-sky-300 hover:bg-sky-100 px-3 py-1.5 rounded-lg transition-colors cursor-pointer shadow-2xs\"\n                  >\n                    <Share2 className=\"w-3.5 h-3.5\" />\n                    <span>Share Trip Link</span>\n                  </button>\n                  <button\n                    onClick={() => onCancelActiveBooking(activeBooking.id)}\n                    className=\"text-xs font-semibold text-rose-700 hover:text-rose-900 hover:bg-rose-100/50 px-3 py-1.5 rounded-lg border border-rose-200 transition-colors cursor-pointer\"\n                  >\n                    Cancel Request\n                  </button>\n                </div>\n              </div>\n\n              {/* Real-time Telemetry Strip */}"
    num_lines: 853
