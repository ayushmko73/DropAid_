    content: "                  const isPending = bk.stage === \'pending\';\n                  const isCompleted = bk.stage === \'completed\';\n\n                  return (\n                    <div\n                      key={bk.id}\n                      onClick={() => setSelectedBookingId(bk.id)}\n                      className={`p-3 rounded-xl border text-left cursor-pointer transition-all ${\n                        isSelected\n                          ? \'border-sky-600 bg-sky-50/70 shadow-xs\'\n                          : isPending\n                          ? \'border-rose-300 bg-rose-50/40 hover:bg-rose-50/70\'\n                          : \'border-slate-200 hover:border-slate-300 bg-white\'\n                      }`}\n                    >\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-xs font-mono font-bold text-slate-900\">\n                          {bk.trackingCode}\n                        </span>\n                        <span\n                          className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${\n                            isPending\n                              ? \'bg-rose-600 text-white animate-pulse\'\n                              : isCompleted\n                              ? \'bg-slate-100 text-slate-600\'\n                              : \'bg-sky-100 text-sky-800\'\n                          }`}\n                        >\n                          {bk.stage.replace(/_/g, \' \')}\n                        </span>\n                      </div>\n\n                      <div className=\"text-xs font-semibold text-slate-900 truncate mt-1\">\n                        {bk.patientName} \302\267 {bk.patientPhone}\n                      </div>\n\n                      <div className=\"text-[11px] text-slate-500 truncate mt-0.5\">\n                        {bk.pickupAddress.split(\',\')[0]} \342\206\222 {bk.dropoffAddress.split(\',\')[0]}\n                      </div>\n\n                      <div className=\"flex items-center justify-between text-[11px] text-slate-400 mt-2 pt-2 border-t border-slate-100\">\n                        <span>ETA: {bk.etaMinutes}m ({bk.distanceKm}km)</span>\n                        <span className=\"font-mono text-slate-700 font-semibold\">\n                          Unit: {bk.assignedUnitId || \'Unassigned\'}\n                        </span>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            )}\n          </div>\n\n          {/* Right 8 Cols: Detail & Dispatch Controller */}\n          <div className=\"lg:col-span-8\">\n            {selectedBooking ? (\n              <div className=\"bg-white border border-slate-200 rounded-xl p-6 shadow-2xs space-y-6\">\n                {/* Header & Stage Progress */}\n                <div className=\"flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-200\">\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <h3 className=\"text-lg font-bold text-slate-900\">\n                        Dispatch #{selectedBooking.trackingCode}\n                      </h3>\n                      <span className=\"text-xs font-semibold bg-sky-100 text-sky-800 px-2.5 py-0.5 rounded-md uppercase\">\n                        {selectedBooking.stage.replace(/_/g, \' \')}\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-slate-500 mt-0.5\">\n                      Patient: <span className=\"font-semibold text-slate-800\">{selectedBooking.patientName}</span> ({selectedBooking.patientPhone})\n                    </p>\n                  </div>\n\n                  {/* Accept / Reject if pending */}\n                  {selectedBooking.stage === \'pending\' && (\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={() => onAcceptBooking(selectedBooking.id)}\n                        className=\"px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold flex items-center gap-1.5 shadow-2xs cursor-pointer transition-colors\"\n                      >\n                        <Check className=\"w-4 h-4\" />\n                        <span>Accept Emergency Request</span>\n                      </button>\n                      <button\n                        onClick={() => onRejectBooking(selectedBooking.id)}\n                        className=\"px-3 py-2 bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-700 border border-slate-200 rounded-lg text-xs font-semibold transition-colors cursor-pointer\"\n                      >\n                        Reject\n                      </button>\n                    </div>\n                  )}\n\n                  {/* Next Stage Advancement */}\n                  {selectedBooking.stage !== \'pending\' && selectedBooking.stage !== \'completed\' && selectedBooking.stage !== \'cancelled\' && (\n                    <div className=\"flex items-center gap-2\">\n                      {getNextStage(selectedBooking.stage) && (\n                        <button\n                          onClick={() =>\n                            onAdvanceStage(selectedBooking.id, getNextStage(selectedBooking.stage)!)\n                          }\n                          className=\"px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white rounded-lg text-xs font-bold flex items-center gap-1.5 shadow-2xs cursor-pointer transition-colors\""
    num_lines: 569
    num_bytes: 27232
    line_range_bytes: 5424
  }
}
