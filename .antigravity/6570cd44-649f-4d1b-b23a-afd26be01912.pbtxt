            }
            lines {
              text: "        color: isTransportingToHospital ? \'#0284c7\' : \'#0284c7\', // Distinctive high-contrast sky/cyan"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        weight: 6,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
