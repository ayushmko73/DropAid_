  view_file {
    absolute_path_uri: "file:///src/components/OperatorDashboard/OperatorDashboard.tsx"
    start_line: 79
    end_line: 249
    content: "  onResetSimulation,\n  onChangeSimulationSpeed,\n}) => {\n  const [operatorTab, setOperatorTab] = useState<\'fleet_map\' | \'active_trips\' | \'incoming\' | \'fleet_units\' | \'history\' | \'simulation\'>(\'fleet_map\');\n  const [historyFilter, setHistoryFilter] = useState<\'all\' | \'real\' | \'simulated\'>(\'all\');\n  const [selectedBookingId, setSelectedBookingId] = useState<string | null>(\n    bookings.length > 0 ? bookings[0].id : null\n  );\n  const [isRerouteOpen, setIsRerouteOpen] = useState<boolean>(false);\n  const [overrideUnitBookingId, setOverrideUnitBookingId] = useState<string | null>(null);\n\n  const selectedBooking = bookings.find((b) => b.id === selectedBookingId) || bookings[0] || null;\n  const assignedUnit = selectedBooking ? ambulances.find((a) => a.id === selectedBooking.assignedUnitId) : null;\n\n  const incomingRequests = bookings.filter((b) => b.stage === \'pending\');\n  const activeTrips = bookings.filter((b) =>\n    [\'accepted\', \'en_route_pickup\', \'on_scene\', \'transporting\', \'at_hospital\'].includes(b.stage)\n  );\n  const completedOrCancelled = bookings.filter((b) => [\'completed\', \'cancelled\'].includes(b.stage));\n\n  const filteredHistory = completedOrCancelled.filter((b) => {\n    if (historyFilter === \'real\') return !b.isSimulated;\n    if (historyFilter === \'simulated\') return b.isSimulated;\n    return true;\n  });\n\n  const getNextStage = (current: TripStage): TripStage | null => {\n    const idx = STAGE_ORDER.indexOf(current);\n    if (idx !== -1 && idx < STAGE_ORDER.length - 1) {\n      return STAGE_ORDER[idx + 1];\n    }\n    return null;\n  };\n\n  const getStageLabel = (stage: TripStage): string => {\n    switch (stage) {\n      case \'pending\': return \'1. Pending Triage\';\n      case \'accepted\': return \'2. Request Accepted\';\n      case \'en_route_pickup\': return \'3. En Route to Pickup\';\n      case \'on_scene\': return \'4. On Scene / Assessing\';\n      case \'transporting\': return \'5. Patient Picked Up (To ER)\';\n      case \'at_hospital\': return \'6. Arrived at Hospital\';\n      case \'completed\': return \'7. Transfer Completed\';\n      case \'cancelled\': return \'Cancelled\';\n      default: return stage;\n    }\n  };\n\n  const availableAmbulances = ambulances.filter((a) => a.status === \'available\');\n\n  return (\n    <div className=\"space-y-6\">\n      {/* ---------------- SIMULATION STATUS & ENGINE HEADER BANNER ---------------- */}\n      <div className=\"bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 text-white rounded-2xl p-5 shadow-sm border border-slate-700/80\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n          <div className=\"space-y-1\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-sky-400 bg-sky-950/80 border border-sky-800/80 px-2.5 py-0.5 rounded-md flex items-center gap-1.5\">\n                <Zap className=\"w-3.5 h-3.5 text-sky-400\" />\n                <span>Automated Daily Ride Simulation</span>\n              </span>\n              <span\n                className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded font-mono ${\n                  simulationState?.status === \'running\'\n                    ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 animate-pulse\'\n                    : simulationState?.status === \'paused\'\n                    ? \'bg-amber-500/20 text-amber-300 border border-amber-500/30\'\n                    : \'bg-slate-700 text-slate-300\'\n                }`}\n              >\n                \342\227\217 {simulationState?.status || \'Idle\'}\n              </span>\n            </div>\n            <h2 className=\"text-base sm:text-lg font-black tracking-tight\">\n              Simulated Daily Schedule: Day {simulationState?.simulatedDay || 1} @{\' \'}\n              <span className=\"font-mono text-sky-300\">\n                {(simulationState?.simulatedHour ?? 8).toString().padStart(2, \'0\')}:\n                {(simulationState?.simulatedMinute ?? 0).toString().padStart(2, \'0\')}\n              </span>\n            </h2>\n            <p className=\"text-xs text-slate-300\">\n              Generates ~20 realistic emergency rides across Delhi NCR with auto-dispatch, patient pickup, and hospital transit.\n              <span className=\"text-slate-400 italic ml-1\">\n                (Simulated records are clearly marked. Runs during active session).\n              </span>\n            </p>\n          </div>\n\n          {/* Simulation Controls */}\n          <div className=\"flex flex-wrap items-center gap-2\">\n            {simulationState?.status === \'running\' ? (\n              <button\n                type=\"button\"\n                onClick={onPauseSimulation}\n                className=\"px-3.5 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm\"\n              >\n                <Pause className=\"w-3.5 h-3.5 fill-current\" />\n                <span>Pause</span>\n              </button>\n            ) : (\n              <button\n                type=\"button\"\n                onClick={onStartSimulation}\n                className=\"px-3.5 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm\"\n              >\n                <Play className=\"w-3.5 h-3.5 fill-current\" />\n                <span>{simulationState?.status === \'paused\' ? \'Resume Simulation\' : \'Start Simulation\'}</span>\n              </button>\n            )}\n\n            <button\n              type=\"button\"\n              onClick={onResetSimulation}\n              className=\"px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer\"\n              title=\"Reset simulation rides and return fleet to base bays\"\n            >\n              <RotateCcw className=\"w-3.5 h-3.5\" />\n              <span>Reset</span>\n            </button>\n\n            {/* Speed Multiplier */}\n            {onChangeSimulationSpeed && (\n              <div className=\"flex items-center gap-1 bg-slate-800/80 border border-slate-700 p-1 rounded-xl text-xs\">\n                <span className=\"text-[10px] text-slate-400 px-1 font-semibold\">Speed:</span>\n                {[1, 5, 10, 30].map((speed) => (\n                  <button\n                    key={speed}\n                    type=\"button\"\n                    onClick={() => onChangeSimulationSpeed(speed)}\n                    className={`px-2 py-0.5 rounded text-[11px] font-mono font-bold transition-colors cursor-pointer ${\n                      simulationState?.speedMultiplier === speed\n                        ? \'bg-sky-600 text-white shadow-2xs\'\n                        : \'text-slate-400 hover:text-white\'\n                    }`}\n                  >\n                    {speed}x\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Mini Simulation Metrics Bar */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4 pt-3 border-t border-slate-700/60 text-xs\">\n          <div>\n            <span className=\"text-slate-400 text-[11px]\">Today\'s Target:</span>\n            <div className=\"font-bold font-mono text-white mt-0.5\">\n              {simulationState?.generatedCount || 0} / {simulationState?.ridesTargetPerDay || 20} Dispatches\n            </div>\n          </div>\n          <div>\n            <span className=\"text-slate-400 text-[11px]\">Active Fleet Dispatches:</span>\n            <div className=\"font-bold font-mono text-sky-400 mt-0.5\">\n              {activeTrips.length} Active Trips\n            </div>\n          </div>\n          <div>\n            <span className=\"text-slate-400 text-[11px]\">Ambulance Availability:</span>\n            <div className=\"font-bold font-mono text-emerald-400 mt-0.5\">\n              {availableAmbulances.length} / {ambulances.length} Units Ready\n            </div>\n          </div>\n          <div>\n            <span className=\"text-slate-400 text-[11px]\">Auto-Dispatch Status:</span>\n            <div className=\"font-bold font-mono text-white mt-0.5 flex items-center gap-1\">\n              <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>Autonomous Proximity Active</span>\n            </div>\n          </div>\n        </div>"
    num_lines: 909
