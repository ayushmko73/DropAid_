      thinking_signature: "\022\311\v\n\306\v\001i\024}\023\365\353\305\023\371\2470\227giW\334\274iu-\340l0\264\t\262\375\243\026|\356\202\003\340B6.\227\324x\303\311\254\222\233x\221\001p\215wF\351\023I\242\005%a\366\345\t\247\000\366Cp\221\260\365\005k\263=\006\026\347\256\274p\316\270\346\362>\025V\246\032\310\232\340\366\265\035\350\002\r`\246Hj^~\265.\265\023-H\256\030b_\275\305\302\371;q\"Y!\372\234\357\027\030nX\203TS^q\230c\236\021A\236\016\362\243\"\237\355}=d\225f\r?\300\360t\363)o\233\227\207}F\2572\331\354\f2E\'P\225;\362\306\002\246\234\256\237\332\200\247\352\033\344\300\212-\2614\020\300\260l\356QD\\\254\357\271\267\350\334\301\267\363\027\257Z\277`Mk\177W\275\377V\213\b\204\342\026$\242\327\361\262?\3019\270\337\270\276\226\324\033M\3032\236\367?\264\202-\340\207\320\230\031\335\306*4oq\034W\272\242\004}\256\b*\023\340G&\254X\322\232\346\034e9\267\rMB\267\314L[&\324.S\"\202\2070_\002\207h\300\244h71)<%\2432\376\321\003_\321\227\337\375\024\301C\021\"\224+fp\217S\224\275D\343\0266\254\020\332\264\272\237/P\031t_\313[\262\332\355\212\273\0068\277\233\265,\353\245\n\314\v\034t\267\261\aO\240\307\b\233\361m\373\027S\225F\312[\bWq\240F\220g\276\363\234_\210\372d\324\231\231GC\276\t \246tq\261\211\275eQ\275e\343\2261\261T\177\360(F\216\207M\033\324s\355\031\006\177\236\375\021E\362\213\270\216\327\310\316%$\314\264?\331\240n\334A\230\210`\237\344\351\347\223F\241\377;\3115\264\270\315\231q\224\232\245\"\332\255\351C\036mC\244\231V\204\0335Z\3416\032\023:3\373\\\254\221Vv\033x\273\036\366\202\035\322\310|\211\2618B\233\240t\233&\311gIB\310*G&L\352\n\341\034\370>K\274\351\256\214\302\376Om}\255=Q\250\325/\"P\377\037rD\307r\357ZE2\254Ih,\266i\240y\207\235\032\350n\374\216\265\036\306\362\335\332#\006\324\270\001t~b\346\031\370\255\315\022\263\t\220\242M`\304e\375>\242\222}\274\361\244\207t\207\v\214\314V\322p\201\353\343\274\307\215\005\236OX5\\\301:4:\200\017\202\221\215\204\v\353\025\226L\373\251\312>\033\266\312\210\030\347\256hI\347\371=\213\017\267z\vT\263\3638pH\361\031\374\263\352\221\276\231OX\2610h\v\361?\230\236\243\211\341\353Ir:/Vdz+\343\225i\313\036=Nh\370\276\340\217\030&d\362\314\004\276t\034\243U\024;x\257iO\232\335\vvj(h\211\324\360\221\3447\a\tz\b\a;\a\370\240\333-\240\250Y\264F\376\006\376Y\231\021\242\371\317\203\210Y(\374\262\000\302\310(\373\262\310o\003\300\023\353wi\262\334\320V\r?l9#:\267\035\201\313\352\271\023\277\373\311-\240\213\334\232\3267\vi\306\273\367GePi\366U\335u\312\a\271\312\023\324\374\210Q.|[\330+\006\372\303\362\304\377i\200\240`M=|\2526\340\375\223\276\246\303\212\265\361\252W\224\357\255\035\236\"r6\000\353+\031\350\321\245\231G\306p\a\244\231\037\032bmh\324n\030\004\324\242\032Y\225GmZ\277F\260\r\356\254\244\316rZ\377\275\317\'\354>\240\373\322\201J\020<\332T\352\253\246\327>\327\345\001K)\335\a\304\243\355\275\t\312\026\323\377\253K\371\366\355U\377.\303&\253\016#\205\316\206\264\003y\3162\234\316\255y\247j\267K\270:9\352\303\366\262vp$\225O\217\367D\363\257\024\207B\v\354\017y\332\325bT\361J\220\245\257\375\366z\352F\'\257O\\\017\346\277\020\231\200K<IQ\023`\\d\326\023J&\355\0000\254\235\005&\302\371T\265\206\244J\330 \016\366\350\217o8V\003\255\304.,_\035?}K\242\312q\360L\030qf\275\331\350\221\262\"\246\344\212\325Kis\263S\t\031qXt(\361<l\033x\332\v\210(\f\262\201\r\267\267C\351?\036\022Nzl\240\255\301v\000yI\302\220U:\022\024\006#J`\251\221\f\233 4\273\2743\224\302\202\023\232\237j\034\027\0261>\336\305\032\035~?+_M\225\020N\315\251Kox\032\031Z\317\034P\005\241)\231\367mc\t\301m\b\213\202\\\bh\360\020N\027\n\377\024Y\027\227\035\244\367\220\005a\016\333 \333A{o\276\241\316\275\275R\222\206\213%p\360V\350\323\n\251L\b A\216\266\354\273h\356\273\340\245a2}\323!K\022\237\325{[9a3\270^\200\233c\336Oe\024j\202\343\326\244\214_\332`m\255\320F\365i`,\211D\326\"\202M\322\273\240Q\003\367\020~\030\373_O\214\236U|\356\031Q\004$\312\003\'2\"1*\'\357\366@\215\262\252\016\227\225\000E\252\333\265(\316\331B`/\036t\2225n\204\356\235\336\362\253\337\213\247\211_\264\000\335\215>e[\312\2440+Nm\231m\355\350=e\022\r\367\235\365\242\350\030\t\263\004\252\220\256\327)\261@\234;\303\335\a\231Ao\304\312\215\351g4\025\350Q\233\240\016\"\312\313\376\332\232\300\261\b\247\342b{{ah\207M\006\231-t\301s\n\231\273\231\256\360w\200\360\255\245p\347\026T"
