    content: "export type ViewMode = \'user\' | \'operator\';\n\nexport type TripStage =\n  | \'pending\'\n  | \'accepted\'\n  | \'en_route_pickup\'\n  | \'on_scene\'\n  | \'transporting\'\n  | \'at_hospital\'\n  | \'completed\'\n  | \'cancelled\';\n\nexport interface LatLng {\n  lat: number;\n  lng: number;\n}\n\nexport interface Hospital {\n  id: string;\n  name: string;\n  system: string;\n  region: \'Delhi\' | \'Noida\' | \'Haryana\';\n  city: string;\n  address: string;\n  lat: number;\n  lng: number;\n  availableBeds: number;\n  totalBeds: number;\n  erWaitMins: number;\n  traumaLevel: \'Level 1\' | \'Level 2\' | \'Pediatric Trauma\' | \'Cardiac Center\' | \'Specialty ER\';\n  status: \'open\' | \'busy\' | \'diverting\';\n  specialties: string[];\n  phone: string;\n  emergencyContact: string;\n  image: string;\n  baysAvailable: number;\n  isVerified: boolean;\n}\n\nexport interface Landmark {\n  id: string;\n  name: string;\n  category: \'Transit\' | \'Public Park\' | \'Commercial\' | \'Civic & Culture\' | \'Sports & Arena\' | \'Waterfront\';\n  address: string;\n  lat: number;\n  lng: number;\n}\n\nexport interface AmbulanceUnit {\n  id: string;\n  callSign: string;\n  type: \'ALS\' | \'BLS\' | \'ICU\' | \'Neonatal\' | \'Bariatric\';\n  typeName: string;\n  status: \'available\' | \'assigned\' | \'en_route_pickup\' | \'on_scene\' | \'transporting\' | \'at_hospital\' | \'returning_to_base\' | \'maintenance\';\n  driverName: string;\n  driverPhone: string;\n  driverPhoto: string;\n  driverLicense: string;\n  driverRating: number;\n  paramedicName: string;"
