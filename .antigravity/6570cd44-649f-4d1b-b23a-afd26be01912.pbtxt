    content: "            assignedAmbulance={assignedAmbulance}\n            bookingHistory={bookings}\n            onSubmitBooking={handleCreateBooking}\n            onCancelActiveBooking={handleCancelActiveBooking}\n            patientProfile={patientProfile}\n            onOpenUploadModal={(cat) => {\n              setUploadCategory(cat);\n              setIsUploadModalOpen(true);\n            }}\n            onOpen3DModal={() => setIs3DViewerOpen(true)}\n            ambulances={ambulances}\n            routePolyline={routePolyline}\n            routeError={routeError}\n            onRecalculateRoute={() => calculateCurrentRoute(pickup.coords, dropoff.coords)}\n            onAcceptBooking={handleAcceptBooking}\n            onAdvanceStage={handleAdvanceStage}\n            isSubmitting={isSubmitting}\n          />\n        ) : (\n          <div className=\"space-y-6\">\n            {/* Operator Live Dispatch Map */}\n            <div className=\"w-full h-[420px] rounded-xl overflow-hidden shadow-sm border border-slate-200\">\n              <LeafletMap\n                pickupCoords={activeBooking ? activeBooking.pickupCoords : pickup.coords}\n                dropoffCoords={activeBooking ? activeBooking.dropoffCoords : dropoff.coords}\n                ambulances={ambulances}\n                activeAmbulanceId={assignedAmbulance?.id}\n                routePolyline={routePolyline}\n                onPickupChange={handlePickupChange}\n                onDropoffChange={handleDropoffChange}\n                gpsAccuracyMeters={gpsAccuracy}\n                routeError={routeError}\n                onRecalculateRoute={() => calculateCurrentRoute(pickup.coords, dropoff.coords)}\n                isSearching={activeBooking?.stage === \'pending\'}\n              />\n            </div>\n            <OperatorDashboard\n              bookings={bookings}\n              ambulances={ambulances}\n              onAcceptBooking={handleAcceptBooking}\n              onRejectBooking={handleRejectBooking}\n              onAssignUnit={handleAssignUnit}\n              onAdvanceStage={handleAdvanceStage}\n              onOpenDriverView={() => {}}\n              onOpen3DViewer={() => setIs3DViewerOpen(true)}\n            />\n          </div>\n        )}\n      </main>\n\n      {/* 3D Ambulance Telemetry Modal */}\n      {is3DViewerOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-xs\">\n          <div className=\"w-full max-w-5xl overflow-hidden rounded-xl bg-slate-900 border border-slate-700 shadow-2xl animate-in fade-in zoom-in-95\">\n            <AmbulanceViewer3D onClose={() => setIs3DViewerOpen(false)} />\n          </div>"
    num_lines: 973
