  code_action {
    action_spec {
      command {
        instruction: "Remove Automated Daily Ride Simulation card and controls completely, replace with Operator Command Console header"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/OperatorDashboard/OperatorDashboard.tsx"
