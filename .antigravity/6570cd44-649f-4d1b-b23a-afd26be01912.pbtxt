  view_file {
    absolute_path_uri: "file:///src/components/OperatorDashboard/OperatorDashboard.tsx"
    start_line: 100
    end_line: 199
    content: "          <button\n            onClick={() => setOperatorTab(\'fleet\')}\n            className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer flex items-center gap-1.5 ${\n              operatorTab === \'fleet\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Truck className=\"w-3.5 h-3.5 text-slate-600\" />\n            <span>Ambulance Fleet Status ({ambulances.length})</span>\n          </button>\n          <button\n            onClick={() => setOperatorTab(\'driver_cockpit\')}\n            className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer flex items-center gap-1.5 ${\n              operatorTab === \'driver_cockpit\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Navigation className=\"w-3.5 h-3.5 text-emerald-600\" />\n            <span>Driver Navigation View</span>\n          </button>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={onOpen3DViewer}\n            className=\"text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-2xs flex items-center gap-1.5 cursor-pointer\"\n          >\n            <Shield className=\"w-3.5 h-3.5 text-sky-600\" />\n            <span>Open 3D Unit Inspector</span>\n          </button>\n        </div>\n      </div>\n\n      {/* ---------------- TAB 1: EMERGENCY QUEUE ---------------- */}\n      {operatorTab === \'queue\' && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n          {/* Left 4 Cols: Bookings Master Queue */}\n          <div className=\"lg:col-span-4 space-y-3\">\n            <div className=\"flex items-center justify-between text-xs font-bold text-slate-700 uppercase tracking-wide px-1\">\n              <span>Incoming Dispatch Requests</span>\n              <span className=\"font-mono\">{bookings.length} Total</span>\n            </div>\n\n            {bookings.length === 0 ? (\n              <div className=\"bg-white border border-slate-200 rounded-xl p-8 text-center text-xs text-slate-500\">\n                Queue is clear. No active dispatch requests.\n              </div>\n            ) : (\n              <div className=\"space-y-2 max-h-[600px] overflow-y-auto pr-1\">\n                {bookings.map((bk) => {\n                  const isSelected = selectedBooking?.id === bk.id;\n                  const isPending = bk.stage === \'pending\';\n                  const isCompleted = bk.stage === \'completed\';\n\n                  return (\n                    <div\n                      key={bk.id}\n                      onClick={() => setSelectedBookingId(bk.id)}\n                      className={`p-3 rounded-xl border text-left cursor-pointer transition-all ${\n                        isSelected\n                          ? \'border-sky-600 bg-sky-50/70 shadow-xs\'\n                          : isPending\n                          ? \'border-rose-300 bg-rose-50/40 hover:bg-rose-50/70\'\n                          : \'border-slate-200 hover:border-slate-300 bg-white\'\n                      }`}\n                    >\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-xs font-mono font-bold text-slate-900\">\n                          {bk.trackingCode}\n                        </span>\n                        <span\n                          className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${\n                            isPending\n                              ? \'bg-rose-600 text-white animate-pulse\'\n                              : isCompleted\n                              ? \'bg-slate-100 text-slate-600\'\n                              : \'bg-sky-100 text-sky-800\'\n                          }`}\n                        >\n                          {bk.stage.replace(/_/g, \' \')}\n                        </span>\n                      </div>\n\n                      <div className=\"text-xs font-semibold text-slate-900 truncate mt-1\">\n                        {bk.patientName} \302\267 {bk.patientPhone}\n                      </div>\n\n                      <div className=\"text-[11px] text-slate-500 truncate mt-0.5\">\n                        {bk.pickupAddress.split(\',\')[0]} \342\206\222 {bk.dropoffAddress.split(\',\')[0]}\n                      </div>\n\n                      <div className=\"flex items-center justify-between text-[11px] text-slate-400 mt-2 pt-2 border-t border-slate-100\">\n                        <span>ETA: {bk.etaMinutes}m ({bk.distanceKm}km)</span>\n                        <span className=\"font-mono text-slate-700 font-semibold\">\n                          Unit: {bk.assignedUnitId || \'Unassigned\'}\n                        </span>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            )}"
