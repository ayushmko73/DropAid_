          target_content: "  Zap,\n  Loader2,\n  Shield\n} from \'lucide-react\';\n\ninterface UserDashboardProps {\n  currentPickup: { coords: LatLng; address: string };\n  currentDropoff: { coords: LatLng; address: string; hospitalId?: string };\n  onPickupChange: (coords: LatLng, address: string) => void;\n  onDropoffChange: (coords: LatLng, address: string, hospitalId?: string) => void;\n  onDetectGPS: () => void;\n  isDetectingGPS: boolean;\n  gpsAccuracy: number;\n  gpsError?: string | null;\n  activeBooking: Booking | null;\n  assignedAmbulance: AmbulanceUnit | null;\n  bookingHistory: Booking[];\n  onSubmitBooking: (equipmentIds: string[], notes: string, bookingType?: \'emergency_hold\' | \'manual\') => void;\n  onCancelActiveBooking: (id: string) => void;\n  patientProfile: PatientProfile;\n  onOpenUploadModal: (category: \'id_card\' | \'insurance\' | \'medical_history\' | \'incident_photo\') => void;\n  onOpen3DModal: () => void;\n  ambulances: AmbulanceUnit[];\n  routePolyline: [number, number][];\n  routeError?: string | null;\n  onRecalculateRoute?: () => void;\n  onAcceptBooking?: (bookingId: string) => void;\n  onAdvanceStage?: (bookingId: string, nextStage: TripStage) => void;\n  isSubmitting?: boolean;\n}\n\nexport const UserDashboard: React.FC<UserDashboardProps> = ({\n  currentPickup,\n  currentDropoff,\n  onPickupChange,\n  onDropoffChange,\n  onDetectGPS,\n  isDetectingGPS,\n  gpsAccuracy,\n  gpsError = null,\n  activeBooking,\n  assignedAmbulance,\n  bookingHistory,\n  onSubmitBooking,\n  onCancelActiveBooking,\n  patientProfile,\n  onOpenUploadModal,\n  onOpen3DModal,\n  ambulances,\n  routePolyline,\n  routeError = null,\n  onRecalculateRoute,\n  onAcceptBooking,\n  onAdvanceStage,\n  isSubmitting = false,\n}) => {\n  const [addressSearch, setAddressSearch] = useState(\'\');\n  const [selectedEquipment, setSelectedEquipment] = useState<string[]>([\'eq-als\', \'eq-cardiac\']);\n  const [emergencyNotes, setEmergencyNotes] = useState(\'Patient reporting acute chest tightness and lightheadedness.\');\n  const [showShareModal, setShowShareModal] = useState(false);\n  const [copiedShare, setCopiedShare] = useState(false);\n  const [activeTab, setActiveTab] = useState<\'dispatch\' | \'hospitals\' | \'history\' | \'medical_id\'>(\'dispatch\');\n  const [isManualBookingOpen, setIsManualBookingOpen] = useState(false);\n  const [autoAcceptSeconds, setAutoAcceptSeconds] = useState<number>(6);\n\n  // Auto-connect to dispatch countdown while in pending stage\n  useEffect(() => {\n    if (activeBooking && activeBooking.stage === \'pending\') {\n      setAutoAcceptSeconds(6);\n      const interval = setInterval(() => {\n        setAutoAcceptSeconds((prev) => {\n          if (prev <= 1) {\n            clearInterval(interval);\n            onAcceptBooking?.(activeBooking.id);\n            return 0;\n          }\n          return prev - 1;\n        });\n      }, 1000);\n      return () => clearInterval(interval);\n    }\n  }, [activeBooking?.id, activeBooking?.stage, onAcceptBooking]);"
