    start_line: 519
    end_line: 649
    content: "    setPickup(defaultPickup);\n    setDropoff(defaultDropoff);\n    setGpsError(null);\n\n    // Reset bookings to clean state\n    setBookings([]);\n    calculateCurrentRoute(defaultPickup.coords, defaultDropoff.coords);\n\n    showToast(\'Simulation reset. All 14 ambulances returned to verified base bays & patrols.\', \'info\');\n  };\n\n  // ANIMATE AMBULANCE ALONG ACTUAL ROAD ROUTE COORDINATES (Phase 1, Phase 2, & Return to Base)\n  const waypointIndexRef = useRef<number>(0);\n\n  // Reset waypoint index when route changes\n  useEffect(() => {\n    waypointIndexRef.current = 0;\n  }, [routePolyline]);\n\n  useEffect(() => {\n    const movingAmbulance = ambulances.find(\n      (a) =>\n        a.status === \'en_route_pickup\' ||\n        a.status === \'transporting\' ||\n        a.status === \'returning_to_base\'\n    );\n\n    if (!movingAmbulance || routePolyline.length < 2) return;\n\n    const interval = setInterval(() => {\n      waypointIndexRef.current = waypointIndexRef.current + 1;\n      const currentIdx = waypointIndexRef.current;\n\n      // Check if ambulance reached destination waypoint\n      if (currentIdx >= routePolyline.length - 1) {\n        const lastPoint = routePolyline[routePolyline.length - 1];\n\n        // Phase 1 finished: Arrived at patient scene\n        if (movingAmbulance.status === \'en_route_pickup\') {\n          setAmbulances((prev) =>\n            prev.map((a) =>\n              a.id === movingAmbulance.id\n                ? {\n                    ...a,\n                    location: { lat: lastPoint[0], lng: lastPoint[1] },\n                    speedKmH: 0,\n                    status: \'on_scene\',\n                  }\n                : a\n            )\n          );\n          if (activeBooking) {\n            handleAdvanceStage(activeBooking.id, \'on_scene\');\n            showToast(`${movingAmbulance.callSign} arrived on scene at patient location.`, \'info\');\n          }\n        }\n        // Phase 2 finished: Arrived at destination hospital\n        else if (movingAmbulance.status === \'transporting\') {\n          setAmbulances((prev) =>\n            prev.map((a) =>\n              a.id === movingAmbulance.id\n                ? {\n                    ...a,\n                    location: { lat: lastPoint[0], lng: lastPoint[1] },\n                    speedKmH: 0,\n                    status: \'at_hospital\',\n                  }\n                : a\n            )\n          );\n          if (activeBooking) {\n            handleAdvanceStage(activeBooking.id, \'at_hospital\');\n            showToast(`${movingAmbulance.callSign} reached hospital ER emergency bay.`, \'success\');\n          }\n        }\n        // Phase 3 finished: Returned to home base\n        else if (movingAmbulance.status === \'returning_to_base\') {\n          setAmbulances((prev) =>\n            prev.map((a) =>\n              a.id === movingAmbulance.id\n                ? {\n                    ...a,\n                    location: { ...a.baseLocation },\n                    speedKmH: 0,\n                    status: \'available\',\n                    currentBookingId: undefined,\n                  }\n                : a\n            )\n          );\n          showToast(`${movingAmbulance.callSign} returned to base at ${movingAmbulance.stationName}. Ready for dispatch.`, \'info\');\n        }\n\n        return;\n      }\n\n      const nextPoint = routePolyline[currentIdx];\n      const prevPoint = routePolyline[Math.max(0, currentIdx - 1)];\n\n      const heading = calculateBearing(\n        { lat: prevPoint[0], lng: prevPoint[1] },\n        { lat: nextPoint[0], lng: nextPoint[1] }\n      );\n\n      setAmbulances((prev) =>\n        prev.map((a) =>\n          a.id === movingAmbulance.id\n            ? {\n                ...a,\n                location: { lat: nextPoint[0], lng: nextPoint[1] },\n                heading: Math.round(heading),\n                speedKmH: 48,\n              }\n            : a\n        )\n      );\n    }, 1600);\n\n    return () => clearInterval(interval);\n  }, [ambulances, routePolyline, activeBooking?.id]);\n\n  // Cloudinary Upload Completion Callback\n  const handleUploadComplete = (doc: BookingDocument) => {\n    if (activeBooking) {\n      setBookings((prev) =>\n        prev.map((b) =>\n          b.id === activeBooking.id ? { ...b, documents: [...b.documents, doc] } : b\n        )\n      );\n    }\n    showToast(`Document \"${doc.name}\" securely attached via Cloudinary.`, \'success\');"
    num_lines: 786
    num_bytes: 28591
    line_range_bytes: 4353
  }
}
