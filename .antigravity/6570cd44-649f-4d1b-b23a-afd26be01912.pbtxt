        target_content: "  // ADVANCE TRIP STAGE (Multi-Phase Road Routing & Availability Transition)\n  const handleAdvanceStage = async (bookingId: string, nextStage: TripStage) => {\n    try {\n      await fetch(`/api/bookings/${bookingId}/stage`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ stage: nextStage }),\n      });\n    } catch {\n      // Ignore background sync errors\n    }\n\n    const currentBk = bookings.find((b) => b.id === bookingId);\n    const assignedId = currentBk?.assignedUnitId;\n    const assignedUnit = ambulances.find((a) => a.id === assignedId);\n\n    // If advancing to transporting, calculate Phase 2 route (Pickup -> Hospital dropoff)\n    if (nextStage === \'transporting\' && currentBk) {\n      try {\n        const hospRoute = await getDrivingRoute(currentBk.pickupCoords, currentBk.dropoffCoords);\n        setRoutePolyline(hospRoute.polyline);\n        setRouteDistanceKm(hospRoute.distanceKm);\n        setRouteEtaMins(hospRoute.etaMinutes);\n      } catch {\n        // Fallback grid\n      }\n      if (assignedId) {\n        setAmbulances((prev) =>\n          prev.map((a) => (a.id === assignedId ? { ...a, status: \'transporting\', speedKmH: 48 } : a))\n        );\n      }\n    } else if (nextStage === \'on_scene\' && assignedId) {\n      if (currentBk) {\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? { ...a, status: \'on_scene\', location: { ...currentBk.pickupCoords }, speedKmH: 0 }\n              : a\n          )\n        );\n      }\n    } else if (nextStage === \'at_hospital\' && assignedId) {\n      if (currentBk) {\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? { ...a, status: \'at_hospital\', location: { ...currentBk.dropoffCoords }, speedKmH: 0 }\n              : a\n          )\n        );\n      }\n    } else if (nextStage === \'completed\') {\n      // Phase 3: Return to home hospital base or patrol base\n      if (assignedUnit && currentBk) {\n        showToast(`Trip complete! Returning ${assignedUnit.callSign} to ${assignedUnit.stationName}.`, \'info\');\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? {\n                  ...a,\n                  status: \'returning_to_base\',\n                  currentBookingId: undefined,\n                }\n              : a\n          )\n        );\n        // Calculate return-to-base route\n        try {\n          const returnRoute = await getDrivingRoute(currentBk.dropoffCoords, assignedUnit.baseLocation);\n          setRoutePolyline(returnRoute.polyline);\n          setRouteDistanceKm(returnRoute.distanceKm);\n          setRouteEtaMins(returnRoute.etaMinutes);\n        } catch {\n          // Graceful fallback\n        }\n      }\n    } else if (nextStage === \'cancelled\') {\n      if (assignedId && assignedUnit) {\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? {\n                  ...a,\n                  location: { ...assignedUnit.baseLocation },\n                  status: \'available\',\n                  currentBookingId: undefined,\n                  speedKmH: 0,\n                }\n              : a\n          )\n        );\n      }\n    }\n\n    setBookings((prev) =>\n      prev.map((b) => {\n        if (b.id !== bookingId) return b;\n        return {\n          ...b,\n          stage: nextStage,\n          stageTimestamps: {\n            ...b.stageTimestamps,\n            ...(nextStage === \'accepted\' ? { accepted: new Date().toISOString() } : {}),\n            ...(nextStage === \'en_route_pickup\' ? { dispatched: new Date().toISOString() } : {}),\n            ...(nextStage === \'on_scene\' ? { arrivedScene: new Date().toISOString() } : {}),\n            ...(nextStage === \'transporting\' ? { departedScene: new Date().toISOString() } : {}),\n            ...(nextStage === \'at_hospital\' ? { arrivedHospital: new Date().toISOString() } : {}),\n            ...(nextStage === \'completed\' ? { completed: new Date().toISOString() } : {}),\n          },\n        };\n      })\n    );\n\n    showToast(`Stage updated to ${nextStage.replace(/_/g, \' \')}`, \'info\');\n  };\n\n  // OPERATOR / DISPATCH ACCEPTANCE HANDLER\n  const handleAcceptBooking = async (bookingId: string) => {\n    const currentBk = bookings.find((b) => b.id === bookingId);\n    if (!currentBk) return;\n\n    // 1. Calculate nearest available ambulance across Delhi NCR\n    const nearestResult = findNearestAvailableAmbulance(currentBk.pickupCoords, ambulances);\n    const assigned = nearestResult\n      ? nearestResult.ambulance\n      : ambulances.find((a) => a.status === \'available\') || ambulances[0];\n\n    // 2. Fetch Phase 1 road route: from assigned ambulance to patient pickup\n    let phase1Polyline: [number, number][] = [];\n    let dispatchDistKm = nearestResult?.distanceKm || 4.2;\n    let dispatchEtaMins = nearestResult?.etaMinutes || 5;\n\n    try {\n      const leg1 = await getDrivingRoute(assigned.location, currentBk.pickupCoords);\n      phase1Polyline = leg1.polyline;\n      dispatchDistKm = leg1.distanceKm;\n      dispatchEtaMins = leg1.etaMinutes;\n    } catch {\n      phase1Polyline = [\n        [assigned.location.lat, assigned.location.lng],\n        [currentBk.pickupCoords.lat, currentBk.pickupCoords.lng],\n      ];\n    }\n\n    setRoutePolyline(phase1Polyline);\n    setRouteDistanceKm(dispatchDistKm);\n    setRouteEtaMins(dispatchEtaMins);\n\n    // Update assigned ambulance status\n    setAmbulances((prev) =>\n      prev.map((a) =>\n        a.id === assigned.id\n          ? {\n              ...a,\n              status: \'en_route_pickup\',\n              currentBookingId: bookingId,\n            }\n          : a\n      )\n    );\n\n    // Update booking state with assigned ambulance and stage\n    setBookings((prev) =>\n      prev.map((b) =>\n        b.id === bookingId\n          ? {\n              ...b,\n              stage: \'en_route_pickup\',\n              assignedUnitId: assigned.id,\n              routePolyline: phase1Polyline,\n              distanceKm: dispatchDistKm,\n              etaMinutes: dispatchEtaMins,\n              currentVehiclePosition: [assigned.location.lat, assigned.location.lng],\n              stageTimestamps: {\n                ...b.stageTimestamps,\n                accepted: new Date().toISOString(),\n                dispatched: new Date().toISOString(),\n              },\n            }\n          : b\n      )\n    );\n\n    try {\n      await fetch(`/api/bookings/${bookingId}/stage`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ stage: \'en_route_pickup\', assignedUnitId: assigned.id }),\n      });\n    } catch {\n      // background\n    }\n\n    showToast(\n      `Emergency Request Accepted! Dispatched ${assigned.callSign} from ${assigned.stationName} (ETA ${dispatchEtaMins}m)`,\n      \'success\'\n    );\n  };\n\n  const handleRejectBooking = (bookingId: string) => {\n    handleAdvanceStage(bookingId, \'cancelled\');\n  };\n\n  const handleAssignUnit = async (bookingId: string, unitId: string) => {\n    const unit = ambulances.find((a) => a.id === unitId);\n    const bk = bookings.find((b) => b.id === bookingId);\n    if (!unit || !bk) return;\n\n    // Recalculate route from new unit to pickup\n    try {\n      const newRoute = await getDrivingRoute(unit.location, bk.pickupCoords);\n      setRoutePolyline(newRoute.polyline);\n      setRouteDistanceKm(newRoute.distanceKm);\n      setRouteEtaMins(newRoute.etaMinutes);\n    } catch {\n      // Fallback\n    }\n\n    setBookings((prev) =>\n      prev.map((b) => (b.id === bookingId ? { ...b, assignedUnitId: unitId } : b))\n    );\n    setAmbulances((prev) =>\n      prev.map((a) => (a.id === unitId ? { ...a, status: \'en_route_pickup\', currentBookingId: bookingId } : a))\n    );\n    showToast(`Unit ${unit.callSign} reassigned from ${unit.stationName}`, \'success\');\n  };"
        replacement_content: "  // RETRY / RECALCULATE ACTIVE TRIP ROUTE\n  const handleRetryRoute = async () => {\n    if (!activeBooking) {\n      calculateCurrentRoute(pickup.coords, dropoff.coords);\n      return;\n    }\n\n    setRouteError(null);\n    const reqId = ++routingRequestIdRef.current;\n\n    if (activeBooking.stage === \'transporting\') {\n      const assigned = ambulances.find((a) => a.id === activeBooking.assignedUnitId);\n      const origin = assigned?.location || activeBooking.pickupCoords;\n      const dest = activeBooking.dropoffCoords;\n      setRoutePolyline([]);\n      waypointIndexRef.current = 0;\n\n      try {\n        const hospRoute = await getDrivingRoute(origin, dest);\n        if (reqId !== routingRequestIdRef.current) return;\n        setRoutePolyline(hospRoute.polyline);\n        setRouteDistanceKm(hospRoute.distanceKm);\n        setRouteEtaMins(hospRoute.etaMinutes);\n        setRouteError(null);\n        waypointIndexRef.current = 0;\n\n        setBookings((prev) =>\n          prev.map((b) =>\n            b.id === activeBooking.id\n              ? {\n                  ...b,\n                  routePolyline: hospRoute.polyline,\n                  distanceKm: hospRoute.distanceKm,\n                  etaMinutes: hospRoute.etaMinutes,\n                }\n              : b\n          )\n        );\n        showToast(\'Hospital road route recalculated successfully.\', \'success\');\n      } catch (err) {\n        if (reqId === routingRequestIdRef.current) {\n          setRoutePolyline([]);\n          setRouteError(\'Failed to fetch hospital road route. Click to retry.\');\n        }\n      }\n    } else if (activeBooking.stage === \'en_route_pickup\') {\n      const assigned = ambulances.find((a) => a.id === activeBooking.assignedUnitId);\n      if (assigned) {\n        setRoutePolyline([]);\n        waypointIndexRef.current = 0;\n        try {\n          const leg1 = await getDrivingRoute(assigned.location, activeBooking.pickupCoords);\n          if (reqId !== routingRequestIdRef.current) return;\n          setRoutePolyline(leg1.polyline);\n          setRouteDistanceKm(leg1.distanceKm);\n          setRouteEtaMins(leg1.etaMinutes);\n          setRouteError(null);\n          waypointIndexRef.current = 0;\n          showToast(\'Pickup route recalculated successfully.\', \'success\');\n        } catch {\n          if (reqId === routingRequestIdRef.current) {\n            setRoutePolyline([]);\n            setRouteError(\'Failed to fetch route to patient. Click to retry.\');\n          }\n        }\n      }\n    } else {\n      calculateCurrentRoute(pickup.coords, dropoff.coords);\n    }\n  };\n\n  // ADVANCE TRIP STAGE (Multi-Phase Road Routing & Availability Transition)\n  const handleAdvanceStage = async (bookingId: string, nextStage: TripStage) => {\n    const currentBk = bookings.find((b) => b.id === bookingId);\n    const assignedId = currentBk?.assignedUnitId;\n    const assignedUnit = ambulances.find((a) => a.id === assignedId);\n\n    // 1. Immediately remove old route polyline & reset animation index on every stage change\n    setRoutePolyline([]);\n    waypointIndexRef.current = 0;\n    setRouteError(null);\n\n    // 2. Immediately update booking stage in state to reflect the transition without UI lag\n    setBookings((prev) =>\n      prev.map((b) => {\n        if (b.id !== bookingId) return b;\n        return {\n          ...b,\n          stage: nextStage,\n          routePolyline: [], // Clear stale route coordinates from booking object immediately\n          stageTimestamps: {\n            ...b.stageTimestamps,\n            ...(nextStage === \'accepted\' ? { accepted: new Date().toISOString() } : {}),\n            ...(nextStage === \'en_route_pickup\' ? { dispatched: new Date().toISOString() } : {}),\n            ...(nextStage === \'on_scene\' ? { arrivedScene: new Date().toISOString() } : {}),\n            ...(nextStage === \'transporting\' ? { departedScene: new Date().toISOString() } : {}),\n            ...(nextStage === \'at_hospital\' ? { arrivedHospital: new Date().toISOString() } : {}),\n            ...(nextStage === \'completed\' ? { completed: new Date().toISOString() } : {}),\n          },\n        };\n      })\n    );\n\n    // 3. PHASE 2 TRANSITION: \"Patient Picked Up\" -> Hospital ER Route\n    if (nextStage === \'transporting\' && currentBk) {\n      if (assignedId) {\n        setAmbulances((prev) =>\n          prev.map((a) => (a.id === assignedId ? { ...a, status: \'transporting\', speedKmH: 48 } : a))\n        );\n      }\n\n      // Generate road-following route from ambulance\'s current location to destination hospital ER\n      const originLocation = assignedUnit?.location || currentBk.pickupCoords;\n      const hospitalLocation = currentBk.dropoffCoords;\n      const reqId = ++routingRequestIdRef.current;\n\n      try {\n        const hospRoute = await getDrivingRoute(originLocation, hospitalLocation);\n\n        // Prevent race condition: ignore out-of-order responses\n        if (reqId !== routingRequestIdRef.current) return;\n\n        // Render new road coordinates\n        setRoutePolyline(hospRoute.polyline);\n        setRouteDistanceKm(hospRoute.distanceKm);\n        setRouteEtaMins(hospRoute.etaMinutes);\n        setRouteError(null);\n        waypointIndexRef.current = 0;\n\n        // Synchronize updated route across bookings state\n        setBookings((prev) =>\n          prev.map((b) =>\n            b.id === bookingId\n              ? {\n                  ...b,\n                  routePolyline: hospRoute.polyline,\n                  distanceKm: hospRoute.distanceKm,\n                  etaMinutes: hospRoute.etaMinutes,\n                  currentVehiclePosition: [originLocation.lat, originLocation.lng],\n                }\n              : b\n          )\n        );\n\n        // Sync to backend server API\n        try {\n          await fetch(`/api/bookings/${bookingId}/stage`, {\n            method: \'POST\',\n            headers: { \'Content-Type\': \'application/json\' },\n            body: JSON.stringify({\n              stage: \'transporting\',\n              assignedUnitId: assignedId,\n              routePolyline: hospRoute.polyline,\n              distanceKm: hospRoute.distanceKm,\n              etaMinutes: hospRoute.etaMinutes,\n            }),\n          });\n        } catch {\n          // background sync\n        }\n\n        showToast(\n          `Patient Picked Up! En route to ${currentBk.dropoffAddress.split(\',\')[0]} (ETA ${hospRoute.etaMinutes}m)`,\n          \'info\'\n        );\n      } catch (routingErr) {\n        if (reqId === routingRequestIdRef.current) {\n          console.error(\'Failed to calculate hospital route:\', routingErr);\n          setRoutePolyline([]);\n          setRouteError(\'Failed to fetch hospital road route. Click to retry.\');\n        }\n      }\n    } else if (nextStage === \'on_scene\' && assignedId && currentBk) {\n      // Phase 1 finished: vehicle at patient scene, stationary\n      setAmbulances((prev) =>\n        prev.map((a) =>\n          a.id === assignedId\n            ? { ...a, status: \'on_scene\', location: { ...currentBk.pickupCoords }, speedKmH: 0 }\n            : a\n        )\n      );\n      try {\n        await fetch(`/api/bookings/${bookingId}/stage`, {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({ stage: \'on_scene\' }),\n        });\n      } catch {\n        // background sync\n      }\n      showToast(\'Ambulance on scene. Paramedic triage & patient assessment in progress.\', \'info\');\n    } else if (nextStage === \'at_hospital\' && assignedId && currentBk) {\n      // Phase 2 finished: vehicle at hospital ER bay, stationary\n      setAmbulances((prev) =>\n        prev.map((a) =>\n          a.id === assignedId\n            ? { ...a, status: \'at_hospital\', location: { ...currentBk.dropoffCoords }, speedKmH: 0 }\n            : a\n        )\n      );\n      try {\n        await fetch(`/api/bookings/${bookingId}/stage`, {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({ stage: \'at_hospital\' }),\n        });\n      } catch {\n        // background sync\n      }\n      showToast(`Ambulance arrived at ${currentBk.dropoffAddress.split(\',\')[0]} ER Bay.`, \'success\');\n    } else if (nextStage === \'completed\') {\n      // Phase 3: Return to home hospital base or patrol base\n      if (assignedUnit && currentBk) {\n        showToast(`Trip complete! Returning ${assignedUnit.callSign} to ${assignedUnit.stationName}.`, \'info\');\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? {\n                  ...a,\n                  status: \'returning_to_base\',\n                  currentBookingId: undefined,\n                }\n              : a\n          )\n        );\n\n        const reqId = ++routingRequestIdRef.current;\n        try {\n          const returnRoute = await getDrivingRoute(currentBk.dropoffCoords, assignedUnit.baseLocation);\n          if (reqId === routingRequestIdRef.current) {\n            setRoutePolyline(returnRoute.polyline);\n            setRouteDistanceKm(returnRoute.distanceKm);\n            setRouteEtaMins(returnRoute.etaMinutes);\n            waypointIndexRef.current = 0;\n          }\n        } catch {\n          // Graceful fallback\n        }\n      }\n      try {\n        await fetch(`/api/bookings/${bookingId}/stage`, {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({ stage: \'completed\' }),\n        });\n      } catch {\n        // background sync\n      }\n    } else if (nextStage === \'cancelled\') {\n      if (assignedId && assignedUnit) {\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? {\n                  ...a,\n                  location: { ...assignedUnit.baseLocation },\n                  status: \'available\',\n                  currentBookingId: undefined,\n                  speedKmH: 0,\n                }\n              : a\n          )\n        );\n      }\n      try {\n        await fetch(`/api/bookings/${bookingId}/stage`, {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({ stage: \'cancelled\' }),\n        });\n      } catch {\n        // background sync\n      }\n      showToast(\'Booking cancelled.\', \'info\');\n    }\n  };\n\n  // OPERATOR / DISPATCH ACCEPTANCE HANDLER\n  const handleAcceptBooking = async (bookingId: string) => {\n    const currentBk = bookings.find((b) => b.id === bookingId);\n    if (!currentBk) return;\n\n    // 1. Calculate nearest available ambulance across Delhi NCR\n    const nearestResult = findNearestAvailableAmbulance(currentBk.pickupCoords, ambulances);\n    const assigned = nearestResult\n      ? nearestResult.ambulance\n      : ambulances.find((a) => a.status === \'available\') || ambulances[0];\n\n    // Clear previous route immediately\n    setRoutePolyline([]);\n    waypointIndexRef.current = 0;\n    setRouteError(null);\n    const reqId = ++routingRequestIdRef.current;\n\n    // 2. Fetch Phase 1 road route: from assigned ambulance to patient pickup\n    let phase1Polyline: [number, number][] = [];\n    let dispatchDistKm = nearestResult?.distanceKm || 4.2;\n    let dispatchEtaMins = nearestResult?.etaMinutes || 5;\n\n    try {\n      const leg1 = await getDrivingRoute(assigned.location, currentBk.pickupCoords);\n      if (reqId !== routingRequestIdRef.current) return;\n      phase1Polyline = leg1.polyline;\n      dispatchDistKm = leg1.distanceKm;\n      dispatchEtaMins = leg1.etaMinutes;\n    } catch {\n      if (reqId !== routingRequestIdRef.current) return;\n      phase1Polyline = [\n        [assigned.location.lat, assigned.location.lng],\n        [currentBk.pickupCoords.lat, currentBk.pickupCoords.lng],\n      ];\n    }\n\n    setRoutePolyline(phase1Polyline);\n    setRouteDistanceKm(dispatchDistKm);\n    setRouteEtaMins(dispatchEtaMins);\n    waypointIndexRef.current = 0;\n\n    // Update assigned ambulance status\n    setAmbulances((prev) =>\n      prev.map((a) =>\n        a.id === assigned.id\n          ? {\n              ...a,\n              status: \'en_route_pickup\',\n              currentBookingId: bookingId,\n            }\n          : a\n      )\n    );\n\n    // Update booking state with assigned ambulance and stage\n    setBookings((prev) =>\n      prev.map((b) =>\n        b.id === bookingId\n          ? {\n              ...b,\n              stage: \'en_route_pickup\',\n              assignedUnitId: assigned.id,\n              routePolyline: phase1Polyline,\n              distanceKm: dispatchDistKm,\n              etaMinutes: dispatchEtaMins,\n              currentVehiclePosition: [assigned.location.lat, assigned.location.lng],\n              stageTimestamps: {\n                ...b.stageTimestamps,\n                accepted: new Date().toISOString(),\n                dispatched: new Date().toISOString(),\n              },\n            }\n          : b\n      )\n    );\n\n    try {\n      await fetch(`/api/bookings/${bookingId}/stage`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          stage: \'en_route_pickup\',\n          assignedUnitId: assigned.id,\n          routePolyline: phase1Polyline,\n          distanceKm: dispatchDistKm,\n          etaMinutes: dispatchEtaMins,\n        }),\n      });\n    } catch {\n      // background\n    }\n\n    showToast(\n      `Emergency Request Accepted! Dispatched ${assigned.callSign} from ${assigned.stationName} (ETA ${dispatchEtaMins}m)`,\n      \'success\'\n    );\n  };\n\n  const handleRejectBooking = (bookingId: string) => {\n    handleAdvanceStage(bookingId, \'cancelled\');\n  };\n\n  const handleAssignUnit = async (bookingId: string, unitId: string) => {\n    const unit = ambulances.find((a) => a.id === unitId);\n    const bk = bookings.find((b) => b.id === bookingId);\n    if (!unit || !bk) return;\n\n    setRoutePolyline([]);\n    waypointIndexRef.current = 0;\n    const reqId = ++routingRequestIdRef.current;\n\n    // Recalculate route from new unit to pickup\n    try {\n      const newRoute = await getDrivingRoute(unit.location, bk.pickupCoords);\n      if (reqId !== routingRequestIdRef.current) return;\n      setRoutePolyline(newRoute.polyline);\n      setRouteDistanceKm(newRoute.distanceKm);\n      setRouteEtaMins(newRoute.etaMinutes);\n      waypointIndexRef.current = 0;\n    } catch {\n      // Fallback\n    }\n\n    setBookings((prev) =>\n      prev.map((b) => (b.id === bookingId ? { ...b, assignedUnitId: unitId } : b))\n    );\n    setAmbulances((prev) =>\n      prev.map((a) => (a.id === unitId ? { ...a, status: \'en_route_pickup\', currentBookingId: bookingId } : a))\n    );\n    showToast(`Unit ${unit.callSign} reassigned from ${unit.stationName}`, \'success\');\n  };"
        start_line: 270
        end_line: 496
      }
      num_matches: 1
    }
    description: "Implement instantaneous route clearance, race condition prevention, and Phase 2 hospital road route fetching on Patient Picked Up"
    diff_stats {
      additions: 272
      deletions: 90
    }
  }
}
