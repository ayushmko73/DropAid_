    start_line: 169
    end_line: 309
    content: "\n  // CREATE EMERGENCY BOOKING (Nearest Ambulance Dispatch from Hospital or Highway Patrol)\n  const handleCreateBooking = async (\n    equipmentIds: string[],\n    notes: string,\n    bookingType: \'emergency_hold\' | \'manual\' = \'emergency_hold\'\n  ) => {\n    // 1. Calculate nearest available ambulance across Delhi NCR\n    const nearestResult = findNearestAvailableAmbulance(pickup.coords, ambulances);\n    const assigned = nearestResult\n      ? nearestResult.ambulance\n      : ambulances.find((a) => a.status === \'available\') || ambulances[0];\n\n    // 2. Fetch Phase 1 road route: from assigned ambulance\'s current location to patient pickup\n    let phase1Polyline: [number, number][] = [];\n    let dispatchDistKm = nearestResult?.distanceKm || 4.2;\n    let dispatchEtaMins = nearestResult?.etaMinutes || 5;\n\n    try {\n      const leg1 = await getDrivingRoute(assigned.location, pickup.coords);\n      phase1Polyline = leg1.polyline;\n      dispatchDistKm = leg1.distanceKm;\n      dispatchEtaMins = leg1.etaMinutes;\n    } catch {\n      phase1Polyline = [\n        [assigned.location.lat, assigned.location.lng],\n        [pickup.coords.lat, pickup.coords.lng],\n      ];\n    }\n\n    setRoutePolyline(phase1Polyline);\n    setRouteDistanceKm(dispatchDistKm);\n    setRouteEtaMins(dispatchEtaMins);\n\n    // 3. Attempt Backend API submission\n    try {\n      const response = await fetch(\'/api/bookings\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          patientName: patientProfile.name,\n          patientPhone: patientProfile.phone,\n          patientNotes: notes,\n          pickupAddress: pickup.address,\n          pickupCoords: pickup.coords,\n          dropoffAddress: dropoff.address,\n          dropoffCoords: dropoff.coords,\n          destinationHospitalId: dropoff.hospitalId,\n          equipmentRequested: equipmentIds,\n          bookingType,\n        }),\n      });\n\n      if (response.ok) {\n        const data = await response.json();\n        if (data.booking && data.assignedAmbulance) {\n          const serverBooking: Booking = {\n            ...data.booking,\n            routePolyline: phase1Polyline,\n            currentVehiclePosition: [assigned.location.lat, assigned.location.lng],\n          };\n\n          setAmbulances((prev) =>\n            prev.map((a) =>\n              a.id === assigned.id\n                ? {\n                    ...a,\n                    status: \'en_route_pickup\',\n                    currentBookingId: serverBooking.id,\n                  }\n                : a\n            )\n          );\n\n          setBookings((prev) => [serverBooking, ...prev.filter((b) => b.id !== serverBooking.id)]);\n          showToast(\n            `Nearest unit dispatched! ${assigned.callSign} from ${assigned.stationName} (${dispatchDistKm} km, ETA ${dispatchEtaMins}m)`,\n            \'success\'\n          );\n          return;\n        }\n      }\n    } catch (apiErr) {\n      console.warn(\'Backend API booking call had network glitch, using resilient dispatch:\', apiErr);\n    }\n\n    // 4. Resilient Local Dispatch Fallback\n    const newBookingId = `bk-${Date.now()}`;\n    const trackingCode = `DA-${Math.floor(1000 + Math.random() * 9000)}`;\n\n    const fallbackBooking: Booking = {\n      id: newBookingId,\n      trackingCode,\n      createdAt: new Date().toISOString(),\n      patientName: patientProfile.name,\n      patientPhone: patientProfile.phone,\n      patientNotes: `${bookingType === \'emergency_hold\' ? \'[5s Hold Emergency] \' : \'[Manual Assisted] \'}${notes}`,\n      pickupAddress: pickup.address,\n      pickupCoords: pickup.coords,\n      dropoffAddress: dropoff.address,\n      dropoffCoords: dropoff.coords,\n      destinationHospitalId: dropoff.hospitalId,\n      equipmentRequested: equipmentIds,\n      stage: \'en_route_pickup\',\n      assignedUnitId: assigned.id,\n      etaMinutes: dispatchEtaMins,\n      distanceKm: dispatchDistKm,\n      routePolyline: phase1Polyline,\n      currentVehiclePosition: [assigned.location.lat, assigned.location.lng],\n      priceEst: Math.round(150 + dispatchDistKm * 18),\n      documents: [],\n      stageTimestamps: {\n        requested: new Date().toISOString(),\n        accepted: new Date().toISOString(),\n        dispatched: new Date().toISOString(),\n      },\n    };\n\n    setAmbulances((prev) =>\n      prev.map((a) =>\n        a.id === assigned.id\n          ? {\n              ...a,\n              status: \'en_route_pickup\',\n              currentBookingId: newBookingId,\n            }\n          : a\n      )\n    );\n\n    setBookings((prev) => [fallbackBooking, ...prev]);\n    showToast(\n      `Nearest unit dispatched! ${assigned.callSign} from ${assigned.stationName} (${dispatchDistKm} km, ETA ${dispatchEtaMins}m)`,\n      \'success\'\n    );\n  };\n\n  // ADVANCE TRIP STAGE (Multi-Phase Road Routing & Availability Transition)\n  const handleAdvanceStage = async (bookingId: string, nextStage: TripStage) => {\n    try {\n      await fetch(`/api/bookings/${bookingId}/stage`, {"
