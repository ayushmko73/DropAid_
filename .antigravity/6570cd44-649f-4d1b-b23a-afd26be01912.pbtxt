    content: "                              ? \'border-emerald-300 bg-emerald-50 text-emerald-800\'\n                              : \'border-slate-200 bg-slate-50 text-slate-500 hover:bg-slate-100\'\n                          }`}\n                        >\n                          <div className=\"text-[10px] opacity-75 font-mono\">Step {idx + 1}</div>\n                          <div className=\"truncate capitalize\">{stage.replace(/_/g, \' \')}</div>\n                        </button>\n                      );\n                    })}\n                  </div>\n                </div>\n\n                {/* Locations and Symptoms Grid */}\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n                  <div className=\"bg-slate-50 p-3.5 rounded-lg border border-slate-200 space-y-2\">\n                    <span className=\"font-bold text-slate-700 uppercase tracking-wide\">\n                      Route Locations\n                    </span>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Pickup Point:</span>\n                      <div className=\"font-bold text-slate-900 mt-0.5\">{selectedBooking.pickupAddress}</div>\n                    </div>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Destination ER:</span>\n                      <div className=\"font-bold text-sky-700 mt-0.5\">{selectedBooking.dropoffAddress}</div>\n                    </div>\n                  </div>\n\n                  <div className=\"bg-slate-50 p-3.5 rounded-lg border border-slate-200 space-y-2\">\n                    <span className=\"font-bold text-slate-700 uppercase tracking-wide\">\n                      Triage Information\n                    </span>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Reported Symptoms:</span>\n                      <div className=\"text-slate-800 font-medium mt-0.5\">\n                        {selectedBooking.patientNotes || \'No notes provided by caller.\'}\n                      </div>\n                    </div>\n                    <div>\n                      <span className=\"text-slate-500 font-medium\">Requested Equipment:</span>\n                      <div className=\"flex flex-wrap gap-1 mt-1\">\n                        {selectedBooking.equipmentRequested.map((eq, i) => (\n                          <span key={i} className=\"bg-white border border-slate-200 px-1.5 py-0.5 rounded text-[10px] font-mono text-slate-700\">\n                            {eq}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Assign / Change Vehicle & Driver */}\n                <div>\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"text-xs font-bold text-slate-700 uppercase tracking-wide\">\n                      Assigned Ambulance & Driver\n                    </span>\n                    <span className=\"text-xs text-slate-500\">\n                      Select any unit below to reassign in real-time\n                    </span>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5\">\n                    {ambulances.map((amb) => {\n                      const isAssigned = selectedBooking.assignedUnitId === amb.id;\n\n                      return (\n                        <div\n                          key={amb.id}\n                          onClick={() => onAssignUnit(selectedBooking.id, amb.id)}\n                          className={`p-3 rounded-lg border text-left cursor-pointer transition-all ${\n                            isAssigned\n                              ? \'border-sky-600 bg-sky-50/80 shadow-2xs ring-1 ring-sky-300\'\n                              : \'border-slate-200 hover:border-slate-300 bg-white\'\n                          }`}\n                        >\n                          <div className=\"flex items-center justify-between\">\n                            <span className=\"text-xs font-bold text-slate-900\">{amb.callSign}</span>\n                            <span className=\"text-[10px] font-semibold text-sky-700 bg-sky-100 px-1.5 py-0.2 rounded\">\n                              {amb.type}\n                            </span>"
