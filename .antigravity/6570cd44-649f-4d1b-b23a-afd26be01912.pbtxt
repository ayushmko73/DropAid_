    content: "        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => onOpenUploadModal(\'insurance\')}\n            className=\"hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-lg shadow-2xs transition-colors cursor-pointer\"\n          >\n            <FileText className=\"w-3.5 h-3.5 text-slate-500\" />\n            <span>Upload Insurance Card</span>\n          </button>\n        </div>\n      </div>\n\n      {/* ---------------- TAB 1: EMERGENCY DISPATCH & HOMEPAGE HERO ---------------- */}\n      {activeTab === \'dispatch\' && (\n        <div className=\"space-y-6\">\n          {/* Active Booking Live Tracking Card (if in progress) */}\n          {activeBooking && activeBooking.stage !== \'completed\' && activeBooking.stage !== \'cancelled\' ? (\n            <div className=\"bg-sky-50 border-2 border-sky-600 rounded-xl p-5 shadow-sm\">\n              <div className=\"flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-sky-200\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 rounded-lg bg-sky-600 flex items-center justify-center text-white font-bold text-sm\">\n                    {assignedAmbulance?.type || \'ALS\'}\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <h3 className=\"text-base font-bold text-slate-900\">\n                        {assignedAmbulance?.callSign || \'Unit Assigning...\'}\n                      </h3>\n                      <span className=\"text-xs font-semibold bg-sky-100 text-sky-800 px-2 py-0.5 rounded-md uppercase tracking-wide\">\n                        {activeBooking.stage.replace(/_/g, \' \')}\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-slate-600 mt-0.5\">\n                      Tracking Code: <span className=\"font-mono font-bold text-slate-900\">{activeBooking.trackingCode}</span> \302\267 Requested at {new Date(activeBooking.createdAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => setShowShareModal(true)}\n                    className=\"inline-flex items-center gap-1.5 text-xs font-bold text-sky-700 bg-white border border-sky-300 hover:bg-sky-100 px-3 py-1.5 rounded-lg transition-colors cursor-pointer shadow-2xs\"\n                  >\n                    <Share2 className=\"w-3.5 h-3.5\" />\n                    <span>Share Trip Link</span>\n                  </button>\n                  <button\n                    onClick={() => onCancelActiveBooking(activeBooking.id)}\n                    className=\"text-xs font-semibold text-rose-700 hover:text-rose-900 hover:bg-rose-100/50 px-3 py-1.5 rounded-lg border border-rose-200 transition-colors cursor-pointer\"\n                  >\n                    Cancel Request\n                  </button>\n                </div>\n              </div>\n\n              {/* Real-time Telemetry Strip */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 py-4 border-b border-sky-200 text-center\">\n                <div className=\"bg-white/80 p-2.5 rounded-lg border border-sky-100\">\n                  <span className=\"text-[11px] font-semibold text-slate-500 uppercase tracking-wide\">Live ETA</span>\n                  <div className=\"text-2xl font-black text-sky-700 font-mono tabular-nums\">\n                    {activeBooking.etaMinutes} min\n                  </div>\n                </div>\n                <div className=\"bg-white/80 p-2.5 rounded-lg border border-sky-100\">\n                  <span className=\"text-[11px] font-semibold text-slate-500 uppercase tracking-wide\">Road Distance</span>\n                  <div className=\"text-2xl font-black text-slate-800 font-mono tabular-nums\">\n                    {activeBooking.distanceKm} km\n                  </div>\n                </div>\n                <div className=\"bg-white/80 p-2.5 rounded-lg border border-sky-100\">\n                  <span className=\"text-[11px] font-semibold text-slate-500 uppercase tracking-wide\">Dispatched Unit</span>\n                  <div className=\"text-sm font-bold text-slate-800 truncate mt-1\">\n                    {assignedAmbulance ? assignedAmbulance.callSign.split(\' - \')[0] : \'Operator Routing\'}\n                  </div>\n                  {assignedAmbulance && (\n                    <div className=\"text-[10px] text-sky-700 font-semibold truncate mt-0.5\">\n                      {assignedAmbulance.isHospitalStationed ? \'\360\237\217\245 \' : \'\360\237\232\223 \'}\n                      {assignedAmbulance.stationName}\n                    </div>\n                  )}\n                </div>\n                <div className=\"bg-white/80 p-2.5 rounded-lg border border-sky-100\">\n                  <span className=\"text-[11px] font-semibold text-slate-500 uppercase tracking-wide\">Destination Bay</span>\n                  <div className=\"text-sm font-bold text-sky-800 truncate mt-1\">\n                    {activeBooking.dropoffAddress.split(\',\')[0]}\n                  </div>\n                  <div className=\"text-[10px] text-slate-500 truncate mt-0.5\">\n                    Verified Emergency ER\n                  </div>\n                </div>\n              </div>\n\n              {/* Assigned Driver Details & Emergency Controls */}\n              {assignedAmbulance && (\n                <div className=\"pt-4 flex flex-wrap items-center justify-between gap-4\">\n                  <div className=\"flex items-center gap-3\">\n                    <img\n                      src={assignedAmbulance.driverPhoto}\n                      alt={assignedAmbulance.driverName}\n                      className=\"w-11 h-11 rounded-full object-cover border-2 border-white shadow-xs\"\n                    />\n                    <div>\n                      <div className=\"text-xs font-bold text-slate-900\">\n                        {assignedAmbulance.driverName} \302\267 \342\230\205 {assignedAmbulance.driverRating}\n                      </div>\n                      <div className=\"text-[11px] text-slate-600\">\n                        Lead Paramedic: {assignedAmbulance.paramedicName} \302\267 Call: {assignedAmbulance.driverPhone}\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <a\n                      href={`tel:${assignedAmbulance.driverPhone}`}\n                      className=\"inline-flex items-center gap-1.5 text-xs font-bold text-white bg-sky-600 hover:bg-sky-700 px-3.5 py-2 rounded-lg transition-colors shadow-2xs\"\n                    >\n                      <Phone className=\"w-3.5 h-3.5\" />\n                      <span>Direct Driver Call</span>\n                    </a>\n                    <button\n                      onClick={onOpen3DModal}\n                      className=\"inline-flex items-center gap-1 text-xs font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 px-3 py-2 rounded-lg transition-colors cursor-pointer shadow-2xs\"\n                    >\n                      <span>3D Ambulance Telemetry</span>\n                    </button>\n                  </div>\n                </div>"
    num_lines: 892
    num_bytes: 44240
    line_range_bytes: 7381
  }
}
