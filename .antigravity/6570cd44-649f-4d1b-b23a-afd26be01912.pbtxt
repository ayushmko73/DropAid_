    content: "\n    setBookings((prev) =>\n      prev.map((b) => {\n        if (b.id !== bookingId) return b;\n        return {\n          ...b,\n          stage: nextStage,\n          stageTimestamps: {\n            ...b.stageTimestamps,\n            ...(nextStage === \'accepted\' ? { accepted: new Date().toISOString() } : {}),\n            ...(nextStage === \'en_route_pickup\' ? { dispatched: new Date().toISOString() } : {}),\n            ...(nextStage === \'on_scene\' ? { arrivedScene: new Date().toISOString() } : {}),\n            ...(nextStage === \'transporting\' ? { departedScene: new Date().toISOString() } : {}),\n            ...(nextStage === \'at_hospital\' ? { arrivedHospital: new Date().toISOString() } : {}),\n            ...(nextStage === \'completed\' ? { completed: new Date().toISOString() } : {}),\n          },\n        };\n      })\n    );\n\n    showToast(`Stage updated to ${nextStage.replace(/_/g, \' \')}`, \'info\');\n  };\n\n  const handleAcceptBooking = (bookingId: string) => {\n    handleAdvanceStage(bookingId, \'en_route_pickup\');\n  };\n\n  const handleRejectBooking = (bookingId: string) => {\n    handleAdvanceStage(bookingId, \'cancelled\');\n  };\n\n  const handleAssignUnit = async (bookingId: string, unitId: string) => {\n    const unit = ambulances.find((a) => a.id === unitId);\n    const bk = bookings.find((b) => b.id === bookingId);\n    if (!unit || !bk) return;\n\n    // Recalculate route from new unit to pickup\n    try {\n      const newRoute = await getDrivingRoute(unit.location, bk.pickupCoords);\n      setRoutePolyline(newRoute.polyline);\n      setRouteDistanceKm(newRoute.distanceKm);\n      setRouteEtaMins(newRoute.etaMinutes);\n    } catch {\n      // Fallback\n    }\n\n    setBookings((prev) =>\n      prev.map((b) => (b.id === bookingId ? { ...b, assignedUnitId: unitId } : b))\n    );\n    setAmbulances((prev) =>\n      prev.map((a) => (a.id === unitId ? { ...a, status: \'en_route_pickup\', currentBookingId: bookingId } : a))\n    );\n    showToast(`Unit ${unit.callSign} reassigned from ${unit.stationName}`, \'success\');\n  };\n\n  const handleCancelActiveBooking = (bookingId: string) => {\n    handleAdvanceStage(bookingId, \'cancelled\');\n  };\n\n  // RESET SIMULATION STATE\n  const handleResetSimulation = async () => {\n    try {\n      await fetch(\'/api/reset\', { method: \'POST\' });\n    } catch {\n      // Local reset regardless\n    }\n\n    localStorage.removeItem(\'dropaid_bookings\');\n    localStorage.removeItem(\'dropaid_ambulances\');\n\n    // Reset ambulances to base stations in Delhi NCR (10 Hospital Bays + 4 Roaming Patrols)\n    setAmbulances(INITIAL_AMBULANCES);\n\n    // Reset default pickup & dropoff\n    const defaultPickup = {\n      coords: { lat: 28.6327, lng: 77.2197 },\n      address: \'Connaught Place (Inner Circle), Block A, New Delhi\',\n    };\n    const defaultDropoff = {\n      coords: { lat: HOSPITALS[0].lat, lng: HOSPITALS[0].lng },\n      address: `${HOSPITALS[0].name}, ${HOSPITALS[0].address}`,\n      hospitalId: HOSPITALS[0].id,\n    };\n    setPickup(defaultPickup);\n    setDropoff(defaultDropoff);\n    setGpsError(null);\n\n    // Reset bookings to clean state\n    setBookings([]);\n    calculateCurrentRoute(defaultPickup.coords, defaultDropoff.coords);\n\n    showToast(\'Simulation reset. All 14 ambulances returned to verified base bays & patrols.\', \'info\');\n  };\n\n  // ANIMATE AMBULANCE ALONG ACTUAL ROAD ROUTE COORDINATES (Phase 1, Phase 2, & Return to Base)\n  const waypointIndexRef = useRef<number>(0);\n\n  // Reset waypoint index when route changes\n  useEffect(() => {\n    waypointIndexRef.current = 0;\n  }, [routePolyline]);\n\n  useEffect(() => {\n    const movingAmbulance = ambulances.find(\n      (a) =>\n        a.status === \'en_route_pickup\' ||\n        a.status === \'transporting\' ||\n        a.status === \'returning_to_base\'\n    );\n\n    if (!movingAmbulance || routePolyline.length < 2) return;\n\n    const interval = setInterval(() => {\n      waypointIndexRef.current = waypointIndexRef.current + 1;\n      const currentIdx = waypointIndexRef.current;\n\n      // Check if ambulance reached destination waypoint\n      if (currentIdx >= routePolyline.length - 1) {\n        const lastPoint = routePolyline[routePolyline.length - 1];\n\n        // Phase 1 finished: Arrived at patient scene\n        if (movingAmbulance.status === \'en_route_pickup\') {\n          setAmbulances((prev) =>\n            prev.map((a) =>\n              a.id === movingAmbulance.id\n                ? {\n                    ...a,\n                    location: { lat: lastPoint[0], lng: lastPoint[1] },\n                    speedKmH: 0,\n                    status: \'on_scene\',\n                  }\n                : a\n            )\n          );\n          if (activeBooking) {\n            handleAdvanceStage(activeBooking.id, \'on_scene\');\n            showToast(`${movingAmbulance.callSign} arrived on scene at patient location.`, \'info\');\n          }\n        }\n        // Phase 2 finished: Arrived at destination hospital\n        else if (movingAmbulance.status === \'transporting\') {\n          setAmbulances((prev) =>\n            prev.map((a) =>\n              a.id === movingAmbulance.id\n                ? {\n                    ...a,\n                    location: { lat: lastPoint[0], lng: lastPoint[1] },\n                    speedKmH: 0,\n                    status: \'at_hospital\',\n                  }\n                : a\n            )\n          );\n          if (activeBooking) {\n            handleAdvanceStage(activeBooking.id, \'at_hospital\');\n            showToast(`${movingAmbulance.callSign} reached hospital ER emergency bay.`, \'success\');\n          }\n        }\n        // Phase 3 finished: Returned to home base\n        else if (movingAmbulance.status === \'returning_to_base\') {\n          setAmbulances((prev) =>\n            prev.map((a) =>\n              a.id === movingAmbulance.id\n                ? {\n                    ...a,\n                    location: { ...a.baseLocation },\n                    speedKmH: 0,\n                    status: \'available\',\n                    currentBookingId: undefined,\n                  }\n                : a\n            )\n          );\n          showToast(`${movingAmbulance.callSign} returned to base at ${movingAmbulance.stationName}. Ready for dispatch.`, \'info\');\n        }\n\n        return;\n      }\n\n      const nextPoint = routePolyline[currentIdx];\n      const prevPoint = routePolyline[Math.max(0, currentIdx - 1)];\n\n      const heading = calculateBearing(\n        { lat: prevPoint[0], lng: prevPoint[1] },\n        { lat: nextPoint[0], lng: nextPoint[1] }\n      );\n\n      setAmbulances((prev) =>\n        prev.map((a) =>\n          a.id === movingAmbulance.id\n            ? {\n                ...a,\n                location: { lat: nextPoint[0], lng: nextPoint[1] },\n                heading: Math.round(heading),\n                speedKmH: 48,\n              }\n            : a\n        )\n      );\n    }, 1600);\n"
    num_lines: 740
    num_bytes: 26964
    line_range_bytes: 6824
  }
}
