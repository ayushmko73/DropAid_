    content: "                              : \'bg-sky-100 text-sky-800\'\n                          }`}\n                        >\n                          {activeBooking.stage === \'pending\' && <Radio className=\"w-3 h-3 text-amber-600 animate-spin\" />}\n                          <span>{activeBooking.stage.replace(/_/g, \' \')}</span>\n                        </span>\n                      </div>\n                      <p className=\"text-xs text-slate-600 mt-0.5\">\n                        Tracking Code: <span className=\"font-mono font-bold text-slate-900\">{activeBooking.trackingCode}</span> \302\267 Requested at {new Date(activeBooking.createdAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n                      </p>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    {activeBooking.stage === \'pending\' && onAcceptBooking && (\n                      <button\n                        onClick={() => onAcceptBooking(activeBooking.id)}\n                        className=\"inline-flex items-center gap-1.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 px-3.5 py-2 rounded-lg transition-colors cursor-pointer shadow-xs\"\n                      >\n                        <Zap className=\"w-3.5 h-3.5 fill-white\" />\n                        <span>Accept Dispatch (Simulate Operator)</span>\n                      </button>\n                    )}\n                    {activeBooking.stage === \'on_scene\' && onAdvanceStage && (\n                      <button\n                        onClick={() => onAdvanceStage(activeBooking.id, \'transporting\')}\n                        className=\"inline-flex items-center gap-1.5 text-xs font-bold text-white bg-sky-600 hover:bg-sky-700 px-3.5 py-2 rounded-lg transition-colors cursor-pointer shadow-xs\"\n                      >\n                        <Zap className=\"w-3.5 h-3.5 fill-white\" />\n                        <span>Patient Picked Up (Route to ER)</span>\n                      </button>\n                    )}\n                    {activeBooking.stage === \'transporting\' && onAdvanceStage && (\n                      <button\n                        onClick={() => onAdvanceStage(activeBooking.id, \'at_hospital\')}\n                        className=\"inline-flex items-center gap-1.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 px-3.5 py-2 rounded-lg transition-colors cursor-pointer shadow-xs\"\n                      >\n                        <Check className=\"w-3.5 h-3.5\" />\n                        <span>Arrived at Hospital</span>\n                      </button>\n                    )}\n                    <button\n                      onClick={() => setShowShareModal(true)}\n                      className=\"inline-flex items-center gap-1.5 text-xs font-bold text-sky-700 bg-white border border-sky-300 hover:bg-sky-50 px-3 py-2 rounded-lg transition-colors cursor-pointer shadow-2xs\"\n                    >\n                      <Share2 className=\"w-3.5 h-3.5\" />\n                      <span>Share Trip Link</span>\n                    </button>\n                    <button\n                      onClick={() => onCancelActiveBooking(activeBooking.id)}\n                      className=\"text-xs font-semibold text-rose-700 hover:text-rose-900 hover:bg-rose-50 px-3 py-2 rounded-lg border border-rose-200 transition-colors cursor-pointer\"\n                    >\n                      Cancel Request\n                    </button>\n                  </div>\n                </div>\n\n                {/* Dynamic Status Banner for Pending Ambulance Search */}\n                {activeBooking.stage === \'pending\' && (\n                  <div className=\"mt-4 p-3.5 rounded-xl bg-gradient-to-r from-sky-50 via-amber-50 to-sky-50 border border-amber-200 flex flex-wrap items-center justify-between gap-3 text-xs\">\n                    <div className=\"flex items-center gap-2.5\">"
