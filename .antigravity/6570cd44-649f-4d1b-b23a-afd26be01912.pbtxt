  view_file {
    absolute_path_uri: "file:///src/components/OperatorDashboard/OperatorDashboard.tsx"
    start_line: 60
    end_line: 99
    content: "\n  const getNextStage = (current: TripStage): TripStage | null => {\n    const idx = STAGE_ORDER.indexOf(current);\n    if (idx !== -1 && idx < STAGE_ORDER.length - 1) {\n      return STAGE_ORDER[idx + 1];\n    }\n    return null;\n  };\n\n  const getStageLabel = (stage: TripStage): string => {\n    switch (stage) {\n      case \'pending\': return \'1. Pending Triage\';\n      case \'accepted\': return \'2. Request Accepted\';\n      case \'en_route_pickup\': return \'3. En Route to Pickup\';\n      case \'on_scene\': return \'4. On Scene / Assessing\';\n      case \'transporting\': return \'5. Transporting to ER\';\n      case \'at_hospital\': return \'6. Arrived at Hospital\';\n      case \'completed\': return \'7. Transfer Completed\';\n      case \'cancelled\': return \'Cancelled\';\n      default: return stage;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Operator Sub-Tabs */}\n      <div className=\"flex items-center justify-between border-b border-slate-200 pb-3\">\n        <div className=\"flex items-center gap-1 bg-slate-100 p-1 rounded-lg\">\n          <button\n            onClick={() => setOperatorTab(\'queue\')}\n            className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer flex items-center gap-1.5 ${\n              operatorTab === \'queue\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Radio className=\"w-3.5 h-3.5 text-sky-600\" />\n            <span>Emergency Queue</span>\n            <span className=\"text-[10px] bg-sky-100 text-sky-800 px-1.5 py-0.2 rounded-full font-mono\">\n              {bookings.filter((b) => b.stage !== \'completed\' && b.stage !== \'cancelled\').length}\n            </span>\n          </button>"
    num_lines: 569
    num_bytes: 27232
    line_range_bytes: 1719
  }
}
