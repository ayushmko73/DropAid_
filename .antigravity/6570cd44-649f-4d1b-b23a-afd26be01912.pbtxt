      thinking_signature: "\022\206\002\n\203\002\001i\024}\023|\204\344\334\231\3755\322\235\254g\303\320\3535d\000zR\254nr\324\354\311\343sF\330VZ\017\332\024\373\331\306\254\021\023\224\340@\033\252\300\2211k\036\354\274\346uNR\337y\323\315|\030H\241\262O%js\330\223\221\320\\\232~\263\345\3445\333k.\345\223Pn\177\204\177\366\rK\316\023\346\\sR\330bU\304\267\\\253\350\267Kz\206\3216\vm\035t\330+\221\3411\334\272\262\3013\022)\206\274\342\004Jd\177<\270\313:\250\300\304 \\H\222\326\236\025\017IG\345\371\330\366\001n\036\347{\315\216\324x\017!\205^@\r\325\anW\307n\374\024\2524\225\"p\243\247|\200W\376~\"\250\210\331\256.\026=n\203\360\224.\212\251\215\177\317\336\322\262\321\235h\235\033\016\'J?\037\375jx\231X\035\306_!\024\v\2108A\023\352Q\004\235\337(\331\267\177\331\266\036\365\301`d"
