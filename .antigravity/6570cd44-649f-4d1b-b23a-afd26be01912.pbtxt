    content: "                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute top-2.5 left-2.5 bg-slate-900/80 backdrop-blur-xs text-white px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider flex items-center gap-1\">\n                    <span>{hosp.region}</span>\n                    <span className=\"text-slate-400\">\302\267</span>\n                    <span>{hosp.city}</span>\n                  </div>\n\n                  <div className=\"absolute top-2.5 right-2.5 bg-emerald-600 text-white px-2 py-0.5 rounded text-[10px] font-bold flex items-center gap-1 shadow-xs\">\n                    <ShieldCheck className=\"w-3 h-3\" />\n                    <span>Verified</span>\n                  </div>\n                </div>\n\n                {/* Content */}\n                <div className=\"p-4 space-y-2.5\">\n                  <div>\n                    <h4 className=\"text-sm font-bold text-slate-900 line-clamp-1\">{hosp.name}</h4>\n                    <p className=\"text-[11px] text-slate-500 line-clamp-2 mt-0.5\">{hosp.address}</p>\n                  </div>\n\n                  {/* Contact Details */}\n                  <div className=\"bg-slate-50 p-2.5 rounded-lg border border-slate-200 text-xs space-y-1\">\n                    <div className=\"flex items-center justify-between text-[11px]\">\n                      <span className=\"text-slate-500 font-medium\">ER Direct Helpline:</span>\n                      <a\n                        href={`tel:${hosp.emergencyContact}`}\n                        className=\"font-bold text-rose-600 hover:text-rose-700 underline font-mono\"\n                      >\n                        {hosp.emergencyContact}\n                      </a>\n                    </div>\n                    <div className=\"flex items-center justify-between text-[11px]\">\n                      <span className=\"text-slate-500 font-medium\">Hospital Board:</span>\n                      <a\n                        href={`tel:${hosp.phone}`}\n                        className=\"font-semibold text-slate-700 hover:text-slate-900 font-mono\"\n                      >\n                        {hosp.phone}\n                      </a>\n                    </div>\n                  </div>\n\n                  {/* Bed & Wait Time Stats */}\n                  <div className=\"grid grid-cols-2 gap-2 text-center text-xs\">\n                    <div className=\"bg-emerald-50/70 border border-emerald-100 p-2 rounded-lg\">\n                      <span className=\"text-[10px] text-emerald-800 font-medium uppercase\">Available Beds</span>\n                      <div className=\"text-sm font-black text-emerald-700 font-mono\">\n                        {hosp.availableBeds} <span className=\"text-[10px] font-normal text-slate-500\">/ {hosp.totalBeds}</span>\n                      </div>\n                    </div>\n                    <div className=\"bg-sky-50/70 border border-sky-100 p-2 rounded-lg\">\n                      <span className=\"text-[10px] text-sky-800 font-medium uppercase\">ER Triage Wait</span>\n                      <div className=\"text-sm font-black text-sky-700 font-mono\">\n                        ~{hosp.erWaitMins} mins\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Specialties Pills */}\n                  <div className=\"flex flex-wrap gap-1\">\n                    {hosp.specialties.slice(0, 3).map((spec, i) => (\n                      <span\n                        key={i}\n                        className=\"text-[10px] font-medium bg-slate-100 text-slate-700 px-2 py-0.5 rounded\"\n                      >\n                        {spec}\n                      </span>\n                    ))}\n                    {hosp.specialties.length > 3 && (\n                      <span className=\"text-[10px] text-slate-400 self-center\">\n                        +{hosp.specialties.length - 3} more\n                      </span>\n                    )}\n                  </div>\n                </div>\n              </div>\n\n              {/* Action Footer */}\n              <div className=\"p-4 pt-0 border-t border-slate-100 mt-2 space-y-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => onSelectHospital(hosp)}\n                  className={`w-full py-2 rounded-lg text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-2xs ${\n                    isSelected\n                      ? \'bg-emerald-600 text-white hover:bg-emerald-700\'\n                      : \'bg-sky-600 text-white hover:bg-sky-700\'\n                  }`}\n                >\n                  <Navigation className=\"w-3.5 h-3.5\" />\n                  <span>{isSelected ? \'\342\234\223 Selected as Destination\' : \'Set as Destination & Route\'}</span>\n                </button>\n\n                <a\n                  href={`tel:${hosp.emergencyContact}`}\n                  className=\"w-full py-1.5 bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-lg text-[11px] font-semibold transition-colors flex items-center justify-center gap-1.5\"\n                >\n                  <Phone className=\"w-3 h-3 text-rose-600\" />\n                  <span>Call Emergency Helpline ({hosp.emergencyContact.split(\'/\')[0].trim()})</span>\n                </a>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
