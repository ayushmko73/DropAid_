  view_file {
    absolute_path_uri: "file:///src/components/Map/LeafletMap.tsx"
    end_line: 44
    content: "import React, { useEffect, useRef, useState } from \'react\';\nimport L from \'leaflet\';\nimport { LatLng, Hospital, Landmark, AmbulanceUnit } from \'../../types/index.ts\';\nimport { HOSPITALS, LANDMARKS } from \'../../data/mockData.ts\';\nimport { reverseGeocode, calculateHaversineDistance } from \'../../services/routingService.ts\';\nimport { Crosshair, Navigation, Building2, MapPin, AlertCircle } from \'lucide-react\';\n\ninterface LeafletMapProps {\n  pickupCoords: LatLng;\n  dropoffCoords: LatLng;\n  ambulances: AmbulanceUnit[];\n  activeAmbulanceId?: string;\n  routePolyline?: [number, number][];\n  onPickupChange: (coords: LatLng, address: string) => void;\n  onDropoffChange: (coords: LatLng, address: string, hospitalId?: string) => void;\n  gpsAccuracyMeters?: number;\n  routeError?: string | null;\n  onRecalculateRoute?: () => void;\n  isSearching?: boolean;\n}\n\nexport const LeafletMap: React.FC<LeafletMapProps> = ({\n  pickupCoords,\n  dropoffCoords,\n  ambulances,\n  activeAmbulanceId,\n  routePolyline = [],\n  onPickupChange,\n  onDropoffChange,\n  gpsAccuracyMeters = 12,\n  routeError = null,\n  onRecalculateRoute,\n  isSearching = false,\n}) => {\n  const mapContainerRef = useRef<HTMLDivElement>(null);\n  const mapInstanceRef = useRef<L.Map | null>(null);\n\n  // Markers & Layers refs\n  const pickupMarkerRef = useRef<L.Marker | null>(null);\n  const dropoffMarkerRef = useRef<L.Marker | null>(null);\n  const ambulanceMarkersRef = useRef<Map<string, L.Marker>>(new Map());\n  const routePolylineRef = useRef<L.Polyline | null>(null);\n  const accuracyCircleRef = useRef<L.Circle | null>(null);\n\n  const [isMapReady, setIsMapReady] = useState(false);"
    num_lines: 543
