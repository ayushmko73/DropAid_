    content: "  paramedicName: string;\n  equipment: string[];\n  location: LatLng;\n  baseLocation: LatLng;\n  stationedHospitalId?: string;\n  stationName: string;\n  isHospitalStationed: boolean;\n  region: \'Delhi\' | \'Noida\' | \'Haryana\';\n  heading: number;\n  speedKmH: number;\n  fuelPct: number;\n  batteryPct: number;\n  currentBookingId?: string;\n}\n\nexport interface MedicalEquipmentItem {\n  id: string;\n  name: string;\n  category: string;\n  description: string;\n  recommendedFor: string;\n}\n\nexport interface PatientProfile {\n  id: string;\n  name: string;\n  phone: string;\n  bloodType: string;\n  allergies: string[];\n  medicalConditions: string[];\n  emergencyContact: {\n    name: string;\n    relationship: string;\n    phone: string;\n  };\n  insuranceProvider: string;\n  policyNumber: string;\n}\n\nexport interface BookingDocument {\n  id: string;\n  name: string;\n  type: \'id_card\' | \'insurance\' | \'medical_history\' | \'incident_photo\';\n  url: string;\n  uploadedAt: string;\n  source: \'cloudinary_live\' | \'local_optimized\';\n  bytes?: number;\n}\n\nexport interface Booking {\n  id: string;\n  trackingCode: string;\n  createdAt: string;\n  patientName: string;\n  patientPhone: string;\n  patientNotes?: string;\n  pickupAddress: string;\n  pickupCoords: LatLng;\n  dropoffAddress: string;\n  dropoffCoords: LatLng;\n  destinationHospitalId?: string;\n  equipmentRequested: string[];\n  stage: TripStage;\n  assignedUnitId?: string;\n  etaMinutes: number;\n  distanceKm: number;\n  routePolyline: [number, number][]; // [lat, lng] array\n  currentVehiclePosition?: [number, number];\n  priceEst: number;\n  documents: BookingDocument[];\n  stageTimestamps: {\n    requested: string;\n    accepted?: string;\n    dispatched?: string;\n    arrivedScene?: string;\n    departedScene?: string;\n    arrivedHospital?: string;\n    completed?: string;\n  };\n}\n\nexport interface DispatchLogItem {\n  id: string;\n  timestamp: string;\n  bookingId?: string;\n  action: string;\n  operator: string;\n  notes: string;\n}\n"
