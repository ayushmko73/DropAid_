      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update pickup and dropoff markers to visually reflect Patient Picked Up and Hospital ER target\", \"EndLine\":315, \"Instruction\":\"Update pickup marker and dropoff marker with tripStage awareness\", \"ReplacementContent\":\"  // Draggable Pickup Marker with dynamic searching radar and patient picked-up states\\n  useEffect(() => {\\n    const map = mapInstanceRef.current;\\n    if (!map || !isMapReady) return;\\n\\n    const isPatientPickedUp = tripStage === \'transporting\' || tripStage === \'at_hospital\' || tripStage === \'completed\';\\n\\n    const pickupIcon = L.divIcon({\\n      className: \'pickup-marker\',\\n      html: `\\n        <div style=\\\"position: relative; transform: translate(-50%, -100%); cursor: ${isPatientPickedUp ? \'default\' : \'grab\'}; text-align: center; opacity: ${isPatientPickedUp ? \'0.85\' : \'1\'};\\\">\\n          ${\\n            isSearching\\n              ? `<div class=\\\"siren-ring\\\" style=\\\"position: absolute; inset: -18px; border-radius: 50%; border: 3px solid #10b981; pointer-events: none;\\\"></div>`\\n              : \'\'\\n          }\\n          <div style=\\\"background: ${isPatientPickedUp ? \'#059669\' : isSearching ? \'#0284c7\' : \'#10b981\'}; color: white; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0,0,0,0.25); display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;\\\">\\n            <span>${isPatientPickedUp ? \'\342\234\223 PATIENT PICKED UP\' : isSearching ? \'\360\237\233\260\357\270\217 SCANNING PICKUP\' : \'\360\237\223\215 PICKUP POINT\'}</span>\\n            <span style=\\\"font-size: 8px; opacity: 0.85;\\\">${isPatientPickedUp ? \'(SCENE CLEAR)\' : isSearching ? \'(LIVE)\' : \'(DRAG ME)\'}</span>\\n          </div>\\n          <div style=\\\"width: 14px; height: 14px; background: ${isPatientPickedUp ? \'#059669\' : isSearching ? \'#0284c7\' : \'#10b981\'}; border: 3px solid white; border-radius: 50%; box-shadow: 0 2px 6px rgba(0,0,0,0.3); margin: 2px auto 0 auto;\\\"></div>\\n        </div>\\n      `,\\n      iconSize: [0, 0],\\n    });\\n\\n    if (!pickupMarkerRef.current) {\\n      const marker = L.marker([pickupCoords.lat, pickupCoords.lng], {\\n        draggable: !isPatientPickedUp,\\n        icon: pickupIcon,\\n        zIndexOffset: isPatientPickedUp ? 500 : 1000,\\n      }).addTo(map);\\n\\n      marker.on(\'dragend\', async () => {\\n        const pos = marker.getLatLng();\\n        const address = await reverseGeocode(pos.lat, pos.lng);\\n        onPickupChange({ lat: pos.lat, lng: pos.lng }, address);\\n      });\\n\\n      pickupMarkerRef.current = marker;\\n    } else {\\n      pickupMarkerRef.current.setLatLng([pickupCoords.lat, pickupCoords.lng]);\\n      pickupMarkerRef.current.setIcon(pickupIcon);\\n      if (isPatientPickedUp) {\\n        pickupMarkerRef.current.dragging?.disable();\\n      } else {\\n        pickupMarkerRef.current.dragging?.enable();\\n      }\\n    }\\n\\n    // GPS Accuracy Circle\\n    if (!accuracyCircleRef.current) {\\n      accuracyCircleRef.current = L.circle([pickupCoords.lat, pickupCoords.lng], {\\n        radius: gpsAccuracyMeters,\\n        color: \'#10b981\',\\n        fillColor: \'#10b981\',\\n        fillOpacity: 0.12,\\n        weight: 1,\\n      }).addTo(map);\\n    } else {\\n      accuracyCircleRef.current.setLatLng([pickupCoords.lat, pickupCoords.lng]);\\n      accuracyCircleRef.current.setRadius(gpsAccuracyMeters);\\n    }\\n  }, [pickupCoords, isMapReady, gpsAccuracyMeters, onPickupChange, isSearching, tripStage]);\\n\\n  // Draggable Drop-off / Destination Marker with High-Priority Hospital Pulse when Transporting\\n  useEffect(() => {\\n    const map = mapInstanceRef.current;\\n    if (!map || !isMapReady) return;\\n\\n    const isTransportingToHospital = tripStage === \'transporting\';\\n\\n    const dropoffIcon = L.divIcon({\\n      className: \'dropoff-marker\',\\n      html: `\\n        <div style=\\\"position: relative; transform: translate(-50%, -100%); cursor: grab; text-align: center;\\\">\\n          ${\\n            isTransportingToHospital\\n              ? `<div class=\\\"siren-ring\\\" style=\\\"position: absolute; inset: -16px; border-radius: 50%; border: 3px solid #0284c7; pointer-events: none;\\\"></div>`\\n              : \'\'\\n          }\\n          <div style=\\\"background: ${isTransportingToHospital ? \'#0369a1\' : \'#0284c7\'}; color: white; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 6px; box-shadow: 0 4px 10px rgba(2, 132, 199, 0.4); display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;\\\">\\n            <span>${isTransportingToHospital ? \'\360\237\232\250 DESTINATION ER BAY (ACTIVE RUN)\' : \'DESTINATION ER\'}</span>\\n          </div>\\n          <div style=\\\"width: 14px; height: 14px; background: ${isTransportingToHospital ? \'#0369a1\' : \'#0284c7\'}; border: 3px solid white; border-radius: 50%; box-shadow: 0 2px 6px rgba(0,0,0,0.3); margin: 2px auto 0 auto;\\\"></div>\\n        </div>\\n      `,\\n      iconSize: [0, 0],\\n    });\\n\\n    if (!dropoffMarkerRef.current) {\\n      const marker = L.marker([dropoffCoords.lat, dropoffCoords.lng], {\\n        draggable: true,\\n        icon: dropoffIcon,\\n        zIndexOffset: isTransportingToHospital ? 1500 : 990,\\n      }).addTo(map);\\n\\n      marker.on(\'dragend\', async () => {\\n        const pos = marker.getLatLng();\\n        const address = await reverseGeocode(pos.lat, pos.lng);\\n        onDropoffChange({ lat: pos.lat, lng: pos.lng }, address);\\n      });\\n\\n      dropoffMarkerRef.current = marker;\\n    } else {\\n      dropoffMarkerRef.current.setLatLng([dropoffCoords.lat, dropoffCoords.lng]);\\n      dropoffMarkerRef.current.setIcon(dropoffIcon);\\n      dropoffMarkerRef.current.setZIndexOffset(isTransportingToHospital ? 1500 : 990);\\n    }\\n  }, [dropoffCoords, isMapReady, onDropoffChange, tripStage]);\", \"StartLine\":212, \"TargetContent\":\"  // Draggable Pickup Marker with dynamic searching radar\\n  useEffect(() => {\\n    const map = mapInstanceRef.current;\\n    if (!map || !isMapReady) return;\\n\\n    const pickupIcon = L.divIcon({\\n      className: \'pickup-marker\',\\n      html: `\\n        <div style=\\\"position: relative; transform: translate(-50%, -100%); cursor: grab; text-align: center;\\\">\\n          ${\\n            isSearching\\n              ? `<div class=\\\"siren-ring\\\" style=\\\"position: absolute; inset: -18px; border-radius: 50%; border: 3px solid #10b981; pointer-events: none;\\\"></div>`\\n              : \'\'\\n          }\\n          <div style=\\\"background: ${isSearching ? \'#0284c7\' : \'#10b981\'}; color: white; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0,0,0,0.25); display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;\\\">\\n            <span>${isSearching ? \'\360\237\233\260\357\270\217 SCANNING PICKUP\' : \'\360\237\223\215 PICKUP POINT\'}</span>\\n            <span style=\\\"font-size: 8px; opacity: 0.85;\\\">${isSearching ? \'(LIVE)\' : \'(DRAG ME)\'}</span>\\n          </div>\\n          <div style=\\\"width: 14px; height: 14px; background: ${isSearching ? \'#0284c7\' : \'#10b981\'}; border: 3px solid white; border-radius: 50%; box-shadow: 0 2px 6px rgba(0,0,0,0.3); margin: 2px auto 0 auto;\\\"></div>\\n        </div>\\n      `,\\n      iconSize: [0, 0],\\n    });\\n\\n    if (!pickupMarkerRef.current) {\\n      const marker = L.marker([pickupCoords.lat, pickupCoords.lng], {\\n        draggable: true,\\n        icon: pickupIcon,\\n        zIndexOffset: 1000,\\n      }).addTo(map);\\n\\n      marker.on(\'dragend\', async () => {\\n        const pos = marker.getLatLng();\\n        const address = await reverseGeocode(pos.lat, pos.lng);\\n        onPickupChange({ lat: pos.lat, lng: pos.lng }, address);\\n      });\\n\\n      pickupMarkerRef.current = marker;\\n    } else {\\n      pickupMarkerRef.current.setLatLng([pickupCoords.lat, pickupCoords.lng]);\\n      pickupMarkerRef.current.setIcon(pickupIcon);\\n    }\\n\\n    // GPS Accuracy Circle\\n    if (!accuracyCircleRef.current) {\\n      accuracyCircleRef.current = L.circle([pickupCoords.lat, pickupCoords.lng], {\\n        radius: gpsAccuracyMeters,\\n        color: \'#10b981\',\\n        fillColor: \'#10b981\',\\n        fillOpacity: 0.12,\\n        weight: 1,\\n      }).addTo(map);\\n    } else {\\n      accuracyCircleRef.current.setLatLng([pickupCoords.lat, pickupCoords.lng]);\\n      accuracyCircleRef.current.setRadius(gpsAccuracyMeters);\\n    }\\n  }, [pickupCoords, isMapReady, gpsAccuracyMeters, onPickupChange]);\\n\\n  // Draggable Drop-off / Destination Marker\\n  useEffect(() => {\\n    const map = mapInstanceRef.current;\\n    if (!map || !isMapReady) return;\\n\\n    if (!dropoffMarkerRef.current) {\\n      const dropoffIcon = L.divIcon({\\n        className: \'dropoff-marker\',\\n        html: `\\n          <div style=\\\"transform: translate(-50%, -100%); cursor: grab; text-align: center;\\\">\\n            <div style=\\\"background: #0284c7; color: white; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 6px; box-shadow: 0 4px 10px rgba(2, 132, 199, 0.4); display: inline-flex; align-items: center; gap: 4px;\\\">\\n              <span>DESTINATION</span>\\n            </div>\\n            <div style=\\\"width: 14px; height: 14px; background: #0284c7; border: 3px solid white; border-radius: 50%; box-shadow: 0 2px 6px rgba(0,0,0,0.3); margin: 2px auto 0 auto;\\\"></div>\\n          </div>\\n        `,\\n        iconSize: [0, 0],\\n      });\\n\\n      const marker = L.marker([dropoffCoords.lat, dropoffCoords.lng], {\\n        draggable: true,\\n        icon: dropoffIcon,\\n        zIndexOffset: 990,\\n      }).addTo(map);\\n\\n      marker.on(\'dragend\', async () => {\\n        const pos = marker.getLatLng();\\n        const address = await reverseGeocode(pos.lat, pos.lng);\\n        onDropoffChange({ lat: pos.lat, lng: pos.lng }, address);\\n      });\\n\\n      dropoffMarkerRef.current = marker;\\n    } else {\\n      dropoffMarkerRef.current.setLatLng([dropoffCoords.lat, dropoffCoords.lng]);\\n    }\\n  }, [dropoffCoords, isMapReady, onDropoffChange]);\", \"TargetFile\":\"/src/components/Map/LeafletMap.tsx\", \"toolAction\":\"Updating marker icons in LeafletMap.tsx\", \"toolSummary\":\"Update marker icons in LeafletMap.tsx\"}"
