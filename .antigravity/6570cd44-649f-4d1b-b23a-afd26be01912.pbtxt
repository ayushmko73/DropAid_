    end_line: 99
    content: "import React, { useState, useRef, useEffect, useCallback } from \'react\';\nimport { Siren, AlertTriangle, ShieldCheck } from \'lucide-react\';\nimport { emergencyAudio } from \'../../services/audioService.ts\';\n\ninterface HoldToConfirmButtonProps {\n  onConfirm: () => void;\n  onHoldStart?: () => void;\n  disabled?: boolean;\n  destinationName?: string;\n  className?: string;\n  buttonSize?: number;\n}\n\nexport const HoldToConfirmButton: React.FC<HoldToConfirmButtonProps> = ({\n  onConfirm,\n  onHoldStart,\n  disabled = false,\n  destinationName,\n  className = \'\',\n  buttonSize = 210,\n}) => {\n  const HOLD_DURATION_MS = 5000;\n  const [progress, setProgress] = useState(0); // 0 to 100\n  const [isHolding, setIsHolding] = useState(false);\n  const [elapsedSec, setElapsedSec] = useState(0);\n  const [justCancelled, setJustCancelled] = useState(false);\n  const [isCompleted, setIsCompleted] = useState(false);\n\n  const requestRef = useRef<number | null>(null);\n  const startTimeRef = useRef<number | null>(null);\n  const tickCounterRef = useRef<number>(0);\n\n  const cancelHold = useCallback(() => {\n    if (isCompleted) return;\n    if (requestRef.current) {\n      cancelAnimationFrame(requestRef.current);\n      requestRef.current = null;\n    }\n    if (isHolding) {\n      setIsHolding(false);\n      setProgress(0);\n      setElapsedSec(0);\n      setJustCancelled(true);\n      setTimeout(() => setJustCancelled(false), 2400);\n    }\n  }, [isHolding, isCompleted]);\n\n  const step = useCallback(\n    (timestamp: number) => {\n      if (!startTimeRef.current) startTimeRef.current = timestamp;\n      const elapsed = timestamp - startTimeRef.current;\n      const pct = Math.min(100, (elapsed / HOLD_DURATION_MS) * 100);\n      const seconds = Math.min(5.0, Number((elapsed / 1000).toFixed(1)));\n\n      setProgress(pct);\n      setElapsedSec(seconds);\n\n      // Play soft tactile tick every ~400ms\n      const currentTick = Math.floor(elapsed / 400);\n      if (currentTick > tickCounterRef.current) {\n        tickCounterRef.current = currentTick;\n        emergencyAudio.playHoldTick(400 + currentTick * 50, 0.05);\n      }\n\n      if (elapsed >= HOLD_DURATION_MS) {\n        setIsHolding(false);\n        setIsCompleted(true);\n        emergencyAudio.playDispatchConfirmed();\n        onConfirm();\n      } else {\n        requestRef.current = requestAnimationFrame(step);\n      }\n    },\n    [onConfirm]\n  );\n\n  const startHold = useCallback(\n    (e: React.SyntheticEvent) => {\n      if (disabled || isCompleted) return;\n      e.preventDefault();\n      setIsHolding(true);\n      setJustCancelled(false);\n      startTimeRef.current = null;\n      tickCounterRef.current = 0;\n      onHoldStart?.();\n      requestRef.current = requestAnimationFrame(step);\n    },\n    [disabled, isCompleted, onHoldStart, step]\n  );\n\n  useEffect(() => {\n    return () => {\n      if (requestRef.current) cancelAnimationFrame(requestRef.current);\n    };\n  }, []);\n\n  // SVG ring calculations\n  const size = buttonSize;\n  const strokeWidth = 9;\n  const radius = (size - strokeWidth) / 2;"
