  view_file {
    absolute_path_uri: "file:///server.ts"
    start_line: 259
    end_line: 364
    content: "app.post(\'/api/reset\', (_req: Request, res: Response) => {\n  serverBookings = [];\n  serverAmbulances = [...INITIAL_AMBULANCES];\n  sharedPlatformState = null;\n  res.json({ success: true, message: \'Simulation state successfully reset.\' });\n});\n\n// 4. Cloudinary Upload Proxy\napp.post(\'/api/cloudinary/upload\', async (req: Request, res: Response) => {\n  try {\n    const { fileData, folder = \'dropaid\', resourceType = \'auto\', fileName = \'upload\' } = req.body;\n\n    if (!fileData) {\n      return res.status(400).json({ error: \'No file data provided\' });\n    }\n\n    // If Cloudinary credentials exist, make real upload call\n    if (CLOUDINARY_API_KEY && CLOUDINARY_API_SECRET && CLOUDINARY_CLOUD_NAME !== \'demo\') {\n      const timestamp = Math.round(Date.now() / 1000);\n      const crypto = await import(\'crypto\');\n      const signatureStr = `folder=${folder}&timestamp=${timestamp}${CLOUDINARY_API_SECRET}`;\n      const signature = crypto.createHash(\'sha1\').update(signatureStr).digest(\'hex\');\n\n      const formData = new URLSearchParams();\n      formData.append(\'file\', fileData);\n      formData.append(\'api_key\', CLOUDINARY_API_KEY);\n      formData.append(\'timestamp\', timestamp.toString());\n      formData.append(\'folder\', folder);\n      formData.append(\'signature\', signature);\n\n      const cloudRes = await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD_NAME}/${resourceType}/upload`, {\n        method: \'POST\',\n        body: formData,\n      });\n\n      if (!cloudRes.ok) {\n        const errJson = await cloudRes.json();\n        throw new Error(errJson.error?.message || \'Cloudinary upload failed\');\n      }\n\n      const cloudData = await cloudRes.json();\n      return res.json({\n        success: true,\n        source: \'cloudinary_live\',\n        public_id: cloudData.public_id,\n        secure_url: cloudData.secure_url,\n        format: cloudData.format,\n        width: cloudData.width,\n        height: cloudData.height,\n        bytes: cloudData.bytes,\n      });\n    }\n\n    // High-fidelity fallback storage with Cloudinary schema\n    const simulatedId = `${folder}/${fileName.replace(/[^a-zA-Z0-9_-]/g, \'_\')}_${Date.now()}`;\n    return res.json({\n      success: true,\n      source: \'local_optimized\',\n      public_id: simulatedId,\n      secure_url: fileData, // Data URL preserved for immediate preview\n      format: fileData.startsWith(\'data:image/png\') ? \'png\' : \'jpeg\',\n      created_at: new Date().toISOString(),\n      bytes: fileData.length,\n      message: \'Document / image securely validated and stored in session cache.\'\n    });\n  } catch (err: any) {\n    console.error(\'Upload handler error:\', err);\n    return res.status(500).json({ error: err.message || \'Upload error\' });\n  }\n});\n\n// 5. Multi-view synchronization\napp.get(\'/api/sync\', (_req: Request, res: Response) => {\n  res.json({ state: sharedPlatformState, bookings: serverBookings, ambulances: serverAmbulances });\n});\n\napp.post(\'/api/sync\', (req: Request, res: Response) => {\n  sharedPlatformState = req.body;\n  if (req.body?.bookings) serverBookings = req.body.bookings;\n  if (req.body?.ambulances) serverAmbulances = req.body.ambulances;\n  res.json({ success: true, timestamp: Date.now() });\n});\n\n// Start server with Vite middleware in development\nasync function startServer() {\n  const isProd = process.env.NODE_ENV === \'production\';\n  if (!isProd) {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    app.use(express.static(path.resolve(__dirname, \'dist\')));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.resolve(__dirname, \'dist\', \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`DropAid server running at http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
    num_lines: 365
    num_bytes: 12718
    line_range_bytes: 3794
  }
}
