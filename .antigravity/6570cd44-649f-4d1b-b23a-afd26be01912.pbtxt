            }
            lines {
              text: "async function generateSimulatedRide(): Promise<Booking | null> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const patient = SIMULATED_PATIENTS[Math.floor(Math.random() * SIMULATED_PATIENTS.length)];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const landmark = LANDMARKS[Math.floor(Math.random() * LANDMARKS.length)];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const hospital = serverHospitals[Math.floor(Math.random() * serverHospitals.length)];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const pickupCoords = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: landmark.lat + (Math.random() - 0.5) * 0.008,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
