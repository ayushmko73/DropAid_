  view_file {
    absolute_path_uri: "file:///src/components/OperatorDashboard/OperatorDashboard.tsx"
    start_line: 399
    end_line: 568
    content: "            <h3 className=\"text-base font-bold text-slate-900\">\n              Active Delhi NCR Emergency Fleet ({ambulances.length} Units)\n            </h3>\n            <span className=\"text-xs text-slate-500\">\n              Stationed across 10 Hospitals & High-Traffic Patrol Corridors\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n            {ambulances.map((amb) => (\n              <div\n                key={amb.id}\n                className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-2xs space-y-3\"\n              >\n                <div className=\"flex items-center justify-between pb-2 border-b border-slate-100\">\n                  <div className=\"flex items-center gap-2\">\n                    <Truck className=\"w-5 h-5 text-sky-600\" />\n                    <div>\n                      <h4 className=\"text-sm font-bold text-slate-900\">{amb.callSign}</h4>\n                      <p className=\"text-[11px] text-slate-500\">{amb.typeName}</p>\n                    </div>\n                  </div>\n                  <span\n                    className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${\n                      amb.status === \'available\'\n                        ? \'bg-emerald-100 text-emerald-800\'\n                        : \'bg-sky-100 text-sky-800\'\n                    }`}\n                  >\n                    {amb.status.replace(/_/g, \' \')}\n                  </span>\n                </div>\n\n                <div className=\"text-[11px] bg-sky-50/70 border border-sky-100 text-sky-900 px-2.5 py-1.5 rounded-lg flex items-center justify-between\">\n                  <span className=\"font-semibold\">{amb.isHospitalStationed ? \'\360\237\217\245 Hospital Base\' : \'\360\237\232\223 Roaming Patrol\'}:</span>\n                  <span className=\"font-bold truncate ml-1\">{amb.stationName}</span>\n                </div>\n\n                <div className=\"flex items-center gap-3\">\n                  <img\n                    src={amb.driverPhoto}\n                    alt={amb.driverName}\n                    className=\"w-12 h-12 rounded-full object-cover border border-slate-200 shadow-2xs\"\n                  />\n                  <div>\n                    <div className=\"text-xs font-bold text-slate-900\">\n                      {amb.driverName} \302\267 \342\230\205 {amb.driverRating}\n                    </div>\n                    <div className=\"text-[11px] text-slate-500\">License: {amb.driverLicense}</div>\n                    <div className=\"text-[11px] text-slate-500\">Phone: {amb.driverPhone}</div>\n                  </div>\n                </div>\n\n                <div className=\"text-xs bg-slate-50 p-2.5 rounded-lg border border-slate-200 space-y-1\">\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500\">Current Fuel:</span>\n                    <span className=\"font-bold text-slate-800 font-mono\">{amb.fuelPct}%</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500\">Battery Reserve:</span>\n                    <span className=\"font-bold text-slate-800 font-mono\">{amb.batteryPct}%</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500\">Lead Paramedic:</span>\n                    <span className=\"font-semibold text-slate-800\">{amb.paramedicName}</span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2 pt-1\">\n                  <button\n                    onClick={() => {\n                      if (selectedBooking) {\n                        onAssignUnit(selectedBooking.id, amb.id);\n                        setOperatorTab(\'queue\');\n                      }\n                    }}\n                    className=\"flex-1 py-1.5 bg-sky-600 hover:bg-sky-700 text-white rounded-lg text-xs font-bold transition-colors cursor-pointer\"\n                  >\n                    Assign to Active\n                  </button>\n                  <button\n                    onClick={onOpen3DViewer}\n                    className=\"py-1.5 px-3 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 rounded-lg text-xs font-semibold cursor-pointer\"\n                  >\n                    3D View\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* ---------------- TAB 3: DRIVER NAVIGATION VIEW ---------------- */}\n      {operatorTab === \'driver_cockpit\' && (\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 shadow-2xs space-y-6\">\n          <div className=\"flex items-center justify-between pb-4 border-b border-slate-200\">\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900\">\n                Driver On-Board Navigation Terminal\n              </h3>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Simulated in-cabin driver navigation console with real-time waypoint cues.\n              </p>\n            </div>\n            {assignedUnit && (\n              <div className=\"text-right\">\n                <span className=\"text-xs font-bold text-slate-900\">{assignedUnit.callSign}</span>\n                <div className=\"text-[11px] text-emerald-700 font-semibold\">Active Dispatch</div>\n              </div>\n            )}\n          </div>\n\n          {selectedBooking ? (\n            <div className=\"space-y-6\">\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 text-center\">\n                <div className=\"bg-slate-900 text-white p-4 rounded-xl\">\n                  <div className=\"text-[11px] text-slate-400 uppercase font-semibold\">Next Maneuver</div>\n                  <div className=\"text-xl font-black mt-1 text-sky-400\">TURN RIGHT (250m)</div>\n                  <div className=\"text-xs text-slate-300 mt-0.5\">Onto Market St / Rapid Transit Way</div>\n                </div>\n                <div className=\"bg-slate-900 text-white p-4 rounded-xl\">\n                  <div className=\"text-[11px] text-slate-400 uppercase font-semibold\">Speed / Emergency Mode</div>\n                  <div className=\"text-2xl font-black font-mono mt-1 text-emerald-400\">48 KM/H</div>\n                  <div className=\"text-xs text-slate-300 mt-0.5\">Siren Active \302\267 Priority Signal Green</div>\n                </div>\n                <div className=\"bg-slate-900 text-white p-4 rounded-xl\">\n                  <div className=\"text-[11px] text-slate-400 uppercase font-semibold\">Estimated Arrival</div>\n                  <div className=\"text-2xl font-black font-mono mt-1 text-rose-400\">\n                    {selectedBooking.etaMinutes} MINS\n                  </div>\n                  <div className=\"text-xs text-slate-300 mt-0.5\">Distance: {selectedBooking.distanceKm} km</div>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs space-y-3\">\n                <div className=\"font-bold text-slate-800 uppercase tracking-wide\">\n                  Patient & Scene Telemetry\n                </div>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  <div>\n                    <span className=\"text-slate-500\">Patient Name:</span>\n                    <div className=\"font-bold text-slate-900\">{selectedBooking.patientName}</div>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500\">Contact Telephone:</span>\n                    <div className=\"font-bold text-slate-900\">{selectedBooking.patientPhone}</div>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500\">Pickup Address:</span>\n                    <div className=\"font-semibold text-slate-900\">{selectedBooking.pickupAddress}</div>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500\">Destination Hospital:</span>\n                    <div className=\"font-semibold text-sky-700\">{selectedBooking.dropoffAddress}</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"p-8 text-center text-xs text-slate-500\">\n              No active booking assigned to the driver terminal.\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    num_lines: 569
