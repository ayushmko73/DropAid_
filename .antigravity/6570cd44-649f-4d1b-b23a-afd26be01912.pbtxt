  view_file {
    absolute_path_uri: "file:///src/types/index.ts"
    end_line: 148
    content: "export type ViewMode = \'user\' | \'operator\';\n\nexport type TripStage =\n  | \'pending\'\n  | \'accepted\'\n  | \'en_route_pickup\'\n  | \'on_scene\'\n  | \'transporting\'\n  | \'at_hospital\'\n  | \'completed\'\n  | \'cancelled\';\n\nexport interface LatLng {\n  lat: number;\n  lng: number;\n}\n\nexport interface Hospital {\n  id: string;\n  name: string;\n  system: string;\n  region: \'Delhi\' | \'Noida\' | \'Haryana\';\n  city: string;\n  address: string;\n  lat: number;\n  lng: number;\n  availableBeds: number;\n  totalBeds: number;\n  erWaitMins: number;\n  traumaLevel: \'Level 1\' | \'Level 2\' | \'Pediatric Trauma\' | \'Cardiac Center\' | \'Specialty ER\';\n  status: \'open\' | \'busy\' | \'diverting\';\n  specialties: string[];\n  phone: string;\n  emergencyContact: string;\n  image: string;\n  baysAvailable: number;\n  isVerified: boolean;\n}\n\nexport interface Landmark {\n  id: string;\n  name: string;\n  category: \'Transit\' | \'Public Park\' | \'Commercial\' | \'Civic & Culture\' | \'Sports & Arena\' | \'Waterfront\';\n  address: string;\n  lat: number;\n  lng: number;\n}\n\nexport interface AmbulanceUnit {\n  id: string;\n  callSign: string;\n  type: \'ALS\' | \'BLS\' | \'ICU\' | \'Neonatal\' | \'Bariatric\';\n  typeName: string;\n  status: \'available\' | \'assigned\' | \'en_route_pickup\' | \'on_scene\' | \'transporting\' | \'at_hospital\' | \'returning_to_base\' | \'maintenance\';\n  driverName: string;\n  driverPhone: string;\n  driverPhoto: string;\n  driverLicense: string;\n  driverRating: number;\n  paramedicName: string;\n  equipment: string[];\n  location: LatLng;\n  baseLocation: LatLng;\n  stationedHospitalId?: string;\n  stationName: string;\n  isHospitalStationed: boolean;\n  region: \'Delhi\' | \'Noida\' | \'Haryana\';\n  heading: number;\n  speedKmH: number;\n  fuelPct: number;\n  batteryPct: number;\n  currentBookingId?: string;\n}\n\nexport interface MedicalEquipmentItem {\n  id: string;\n  name: string;\n  category: string;\n  description: string;\n  recommendedFor: string;\n}\n\nexport interface PatientProfile {\n  id: string;\n  name: string;\n  phone: string;\n  bloodType: string;\n  allergies: string[];\n  medicalConditions: string[];\n  emergencyContact: {\n    name: string;\n    relationship: string;\n    phone: string;\n  };\n  insuranceProvider: string;\n  policyNumber: string;\n}\n\nexport interface BookingDocument {\n  id: string;\n  name: string;\n  type: \'id_card\' | \'insurance\' | \'medical_history\' | \'incident_photo\';\n  url: string;\n  uploadedAt: string;\n  source: \'cloudinary_live\' | \'local_optimized\';\n  bytes?: number;\n}\n\nexport interface Booking {\n  id: string;\n  trackingCode: string;\n  createdAt: string;\n  patientName: string;\n  patientPhone: string;\n  patientNotes?: string;\n  pickupAddress: string;\n  pickupCoords: LatLng;\n  dropoffAddress: string;\n  dropoffCoords: LatLng;\n  destinationHospitalId?: string;\n  equipmentRequested: string[];\n  stage: TripStage;\n  assignedUnitId?: string;\n  etaMinutes: number;\n  distanceKm: number;\n  routePolyline: [number, number][]; // [lat, lng] array\n  currentVehiclePosition?: [number, number];\n  priceEst: number;\n  documents: BookingDocument[];\n  stageTimestamps: {\n    requested: string;\n    accepted?: string;\n    dispatched?: string;\n    arrivedScene?: string;\n    departedScene?: string;\n    arrivedHospital?: string;\n    completed?: string;\n  };\n}\n\nexport interface DispatchLogItem {\n  id: string;\n  timestamp: string;\n  bookingId?: string;\n  action: string;\n  operator: string;\n  notes: string;\n}\n"
