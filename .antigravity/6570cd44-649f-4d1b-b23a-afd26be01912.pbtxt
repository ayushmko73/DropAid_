        replacement_chunks {
          target_content: "  // Update Route Polyline (Along Road Coordinates)\n  useEffect(() => {\n    const map = mapInstanceRef.current;\n    if (!map || !isMapReady) return;\n\n    if (routePolylineRef.current) {\n      routePolylineRef.current.remove();\n      routePolylineRef.current = null;\n    }\n\n    if (routePolyline.length > 1) {\n      // Draw neon path with background shadow\n      const polyline = L.polyline(routePolyline, {\n        color: \'#0284c7\',\n        weight: 5,\n        opacity: 0.85,\n        lineCap: \'round\',\n        lineJoin: \'round\',\n        dashArray: \'1, 10\',\n      }).addTo(map);\n\n      routePolylineRef.current = polyline;\n\n      // Fit bounds to comfortably frame the route\n      try {\n        const bounds = L.latLngBounds(routePolyline);\n        map.fitBounds(bounds, { padding: [50, 50], maxZoom: 15 });\n      } catch {\n        // Fallback\n      }\n    }\n  }, [routePolyline, isMapReady]);"
          replacement_content: "  // Update Route Polyline (Along Road Coordinates) - Guaranteed Instant Clean & Redraw\n  useEffect(() => {\n    const map = mapInstanceRef.current;\n    if (!map || !isMapReady) return;\n\n    // Immediately remove obsolete polyline layer before rendering any new route\n    if (routePolylineRef.current) {\n      routePolylineRef.current.remove();\n      routePolylineRef.current = null;\n    }\n\n    if (routePolyline.length > 1) {\n      const isTransportingToHospital = tripStage === \'transporting\';\n\n      // Draw neon path with high-visibility emergency styling\n      const polyline = L.polyline(routePolyline, {\n        color: isTransportingToHospital ? \'#0284c7\' : \'#0284c7\', // Distinctive high-contrast sky/cyan\n        weight: 6,\n        opacity: 0.92,\n        lineCap: \'round\',\n        lineJoin: \'round\',\n        dashArray: isTransportingToHospital ? \'2, 8\' : \'1, 8\',\n      }).addTo(map);\n\n      routePolylineRef.current = polyline;\n\n      // Fit bounds to comfortably frame the new route from vehicle to hospital\n      try {\n        const bounds = L.latLngBounds(routePolyline);\n        map.fitBounds(bounds, { padding: [50, 50], maxZoom: 15 });\n      } catch {\n        // Fallback\n      }\n    }\n  }, [routePolyline, isMapReady, tripStage]);"
          start_line: 425
          end_line: 460
        }
      }
    }
