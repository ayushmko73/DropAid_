            }
            lines {
              text: "      ...(assigned"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ? ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              stage: \'en_route_pickup\' as TripStage,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              timestamp: nowIso,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              note: `Auto-dispatched Unit ${assigned.callSign} (Driver: ${assigned.driverName}) via proximity calculation`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            },"
