    content: "  // ADVANCE TRIP STAGE (Multi-Phase Road Routing & Availability Transition)\n  const handleAdvanceStage = async (bookingId: string, nextStage: TripStage) => {\n    try {\n      await fetch(`/api/bookings/${bookingId}/stage`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ stage: nextStage }),\n      });\n    } catch {\n      // Ignore background sync errors\n    }\n\n    const currentBk = bookings.find((b) => b.id === bookingId);\n    const assignedId = currentBk?.assignedUnitId;\n    const assignedUnit = ambulances.find((a) => a.id === assignedId);\n\n    // If advancing to transporting, calculate Phase 2 route (Pickup -> Hospital dropoff)\n    if (nextStage === \'transporting\' && currentBk) {\n      try {\n        const hospRoute = await getDrivingRoute(currentBk.pickupCoords, currentBk.dropoffCoords);\n        setRoutePolyline(hospRoute.polyline);\n        setRouteDistanceKm(hospRoute.distanceKm);\n        setRouteEtaMins(hospRoute.etaMinutes);\n      } catch {\n        // Fallback grid\n      }\n      if (assignedId) {\n        setAmbulances((prev) =>\n          prev.map((a) => (a.id === assignedId ? { ...a, status: \'transporting\', speedKmH: 48 } : a))\n        );\n      }\n    } else if (nextStage === \'on_scene\' && assignedId) {\n      if (currentBk) {\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? { ...a, status: \'on_scene\', location: { ...currentBk.pickupCoords }, speedKmH: 0 }\n              : a\n          )\n        );\n      }\n    } else if (nextStage === \'at_hospital\' && assignedId) {\n      if (currentBk) {\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? { ...a, status: \'at_hospital\', location: { ...currentBk.dropoffCoords }, speedKmH: 0 }\n              : a\n          )\n        );\n      }\n    } else if (nextStage === \'completed\') {\n      // Phase 3: Return to home hospital base or patrol base\n      if (assignedUnit && currentBk) {\n        showToast(`Trip complete! Returning ${assignedUnit.callSign} to ${assignedUnit.stationName}.`, \'info\');\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? {\n                  ...a,\n                  status: \'returning_to_base\',\n                  currentBookingId: undefined,\n                }\n              : a\n          )\n        );\n        // Calculate return-to-base route\n        try {\n          const returnRoute = await getDrivingRoute(currentBk.dropoffCoords, assignedUnit.baseLocation);\n          setRoutePolyline(returnRoute.polyline);\n          setRouteDistanceKm(returnRoute.distanceKm);\n          setRouteEtaMins(returnRoute.etaMinutes);\n        } catch {\n          // Graceful fallback\n        }\n      }\n    } else if (nextStage === \'cancelled\') {\n      if (assignedId && assignedUnit) {\n        setAmbulances((prev) =>\n          prev.map((a) =>\n            a.id === assignedId\n              ? {\n                  ...a,\n                  location: { ...assignedUnit.baseLocation },\n                  status: \'available\',\n                  currentBookingId: undefined,\n                  speedKmH: 0,\n                }\n              : a\n          )\n        );\n      }\n    }\n\n    setBookings((prev) =>\n      prev.map((b) => {\n        if (b.id !== bookingId) return b;\n        return {\n          ...b,\n          stage: nextStage,\n          stageTimestamps: {\n            ...b.stageTimestamps,\n            ...(nextStage === \'accepted\' ? { accepted: new Date().toISOString() } : {}),\n            ...(nextStage === \'en_route_pickup\' ? { dispatched: new Date().toISOString() } : {}),\n            ...(nextStage === \'on_scene\' ? { arrivedScene: new Date().toISOString() } : {}),\n            ...(nextStage === \'transporting\' ? { departedScene: new Date().toISOString() } : {}),\n            ...(nextStage === \'at_hospital\' ? { arrivedHospital: new Date().toISOString() } : {}),\n            ...(nextStage === \'completed\' ? { completed: new Date().toISOString() } : {}),\n          },\n        };\n      })\n    );\n\n    showToast(`Stage updated to ${nextStage.replace(/_/g, \' \')}`, \'info\');\n  };\n\n  // OPERATOR / DISPATCH ACCEPTANCE HANDLER\n  const handleAcceptBooking = async (bookingId: string) => {\n    const currentBk = bookings.find((b) => b.id === bookingId);\n    if (!currentBk) return;\n\n    // 1. Calculate nearest available ambulance across Delhi NCR\n    const nearestResult = findNearestAvailableAmbulance(currentBk.pickupCoords, ambulances);\n    const assigned = nearestResult\n      ? nearestResult.ambulance\n      : ambulances.find((a) => a.status === \'available\') || ambulances[0];\n\n    // 2. Fetch Phase 1 road route: from assigned ambulance to patient pickup\n    let phase1Polyline: [number, number][] = [];\n    let dispatchDistKm = nearestResult?.distanceKm || 4.2;\n    let dispatchEtaMins = nearestResult?.etaMinutes || 5;\n\n    try {\n      const leg1 = await getDrivingRoute(assigned.location, currentBk.pickupCoords);\n      phase1Polyline = leg1.polyline;\n      dispatchDistKm = leg1.distanceKm;\n      dispatchEtaMins = leg1.etaMinutes;\n    } catch {\n      phase1Polyline = [\n        [assigned.location.lat, assigned.location.lng],\n        [currentBk.pickupCoords.lat, currentBk.pickupCoords.lng],\n      ];\n    }\n\n    setRoutePolyline(phase1Polyline);\n    setRouteDistanceKm(dispatchDistKm);\n    setRouteEtaMins(dispatchEtaMins);\n\n    // Update assigned ambulance status\n    setAmbulances((prev) =>\n      prev.map((a) =>\n        a.id === assigned.id\n          ? {\n              ...a,\n              status: \'en_route_pickup\',\n              currentBookingId: bookingId,\n            }\n          : a\n      )\n    );\n\n    // Update booking state with assigned ambulance and stage\n    setBookings((prev) =>\n      prev.map((b) =>\n        b.id === bookingId\n          ? {\n              ...b,\n              stage: \'en_route_pickup\',\n              assignedUnitId: assigned.id,\n              routePolyline: phase1Polyline,\n              distanceKm: dispatchDistKm,\n              etaMinutes: dispatchEtaMins,\n              currentVehiclePosition: [assigned.location.lat, assigned.location.lng],\n              stageTimestamps: {\n                ...b.stageTimestamps,\n                accepted: new Date().toISOString(),\n                dispatched: new Date().toISOString(),\n              },\n            }\n          : b\n      )\n    );\n\n    try {\n      await fetch(`/api/bookings/${bookingId}/stage`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ stage: \'en_route_pickup\', assignedUnitId: assigned.id }),\n      });\n    } catch {\n      // background\n    }\n\n    showToast(\n      `Emergency Request Accepted! Dispatched ${assigned.callSign} from ${assigned.stationName} (ETA ${dispatchEtaMins}m)`,\n      \'success\'\n    );\n  };\n\n  const handleRejectBooking = (bookingId: string) => {\n    handleAdvanceStage(bookingId, \'cancelled\');"
    num_lines: 786
    num_bytes: 28591
    line_range_bytes: 6976
  }
}
